@page "/"
@using QuimeraReader.Shared.Components
@using QuimeraReader.Shared.Interfaces
@implements IDisposable
@inject INetworkStateService NetworkState
@inject NavigationManager NavManager

<h1>Tu Biblioteca Móvil</h1>

<BookList />

@code {
    protected override void OnInitialized()
    {
        NetworkState.OnNetworkStateChanged += StateChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && NetworkState.IsOffline)
        {
            NavManager.NavigateTo("/offline-library");
        }
    }

    private void StateChanged()
    {
        if (NetworkState.IsOffline)
        {
            InvokeAsync(() => NavManager.NavigateTo("/offline-library"));
        }
    }

    public void Dispose()
    {
        NetworkState.OnNetworkStateChanged -= StateChanged;
    }
}

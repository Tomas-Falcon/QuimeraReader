@namespace QuimeraReader.Shared.Components.Layout
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@inject IServiceProvider ServiceProvider

<div class="d-flex flex-column h-100 position-relative">
    <div style="flex-grow: 1; overflow-y: auto;">
        <RadzenPanelMenu Style="width:100%">
            <RadzenPanelMenuItem Text="@TranslationService["Nav_Library"]" Icon="library_books" Path="" />
            <RadzenPanelMenuItem Text="@TranslationService["Nav_Authors"]" Icon="people" Path="authors" />
            <RadzenPanelMenuItem Text="@TranslationService["Nav_Genres"]" Icon="local_offer" Path="categories" />
            <RadzenPanelMenuItem Text="@TranslationService["Nav_ReadBooks"]" Icon="check_circle" Path="read-books" />
            @if (ServiceProvider.GetService(typeof(QuimeraReader.Shared.Interfaces.ILocalBookRepository)) != null)
            {
                <RadzenPanelMenuItem Text="@TranslationService["Nav_OfflineLibrary"]" Icon="cloud_download" Path="offline-library" />
            }
            <RadzenPanelMenuItem Text="@TranslationService["Nav_ManageAudios"]" Path="unmatched-audios" Icon="audio_file" />
            <RadzenPanelMenuItem Text="@TranslationService["Nav_Settings"]" Icon="settings" Path="settings" />
        </RadzenPanelMenu>
    </div>

    <div class="px-3 pb-3 pt-3 text-muted mt-auto" style="font-size: 0.8rem; text-align: center; border-top: 1px solid var(--border-color); background-color: var(--bg-card); width: 100%;">
        v. @AppVersion
    </div>
</div>

@code {
    private string AppVersion = "Desconocida";

    protected override void OnInitialized()
    {
        // En Blazor WebAssembly, GetEntryAssembly() puede ser nulo o diferir del ensamblado host.
        // Inspeccionamos los ensamblados cargados para encontrar la versión generada por MinVer.
        var candidateAssemblies = new[]
        {
            System.Reflection.Assembly.GetEntryAssembly(),
            typeof(NavMenu).Assembly,
            AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault(a => a.GetName().Name == "QuimeraReader.Web"),
            AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault(a => a.GetName().Name == "QuimeraReader.Mobile")
        }.Where(a => a != null);

        string? rawVersion = null;

        foreach (var asm in candidateAssemblies)
        {
            var infoVer = asm!.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
                .Cast<System.Reflection.AssemblyInformationalVersionAttribute>()
                .FirstOrDefault()?.InformationalVersion;

            if (!string.IsNullOrEmpty(infoVer) && !infoVer.StartsWith("1.0.0+"))
            {
                rawVersion = infoVer;
                break;
            }
            else if (!string.IsNullOrEmpty(infoVer) && rawVersion == null)
            {
                rawVersion = infoVer;
            }
        }

        if (!string.IsNullOrEmpty(rawVersion))
        {
            // Limpiar commit hash si existe
            string cleanVersion = rawVersion.Contains('+') ? rawVersion.Split('+')[0] : rawVersion;
            AppVersion = cleanVersion.StartsWith("v", StringComparison.OrdinalIgnoreCase) ? cleanVersion : $"v{cleanVersion}";
        }
        else
        {
            AppVersion = "v1.0.0";
        }
    }
}


@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject QuimeraReader.Shared.Services.IServerConfigService ServerConfig
@inject NavigationManager NavManager
@namespace QuimeraReader.Shared.Components.Layout

@if (ServerConfig.NeedsConfiguration)
{
    <div class="d-flex align-items-center justify-content-center vh-100 bg-dark text-light">
        <div class="card p-4 bg-secondary" style="max-width: 400px; width: 100%; border-radius: 12px;">
            <h3 class="mb-4 text-center">Configuración del Servidor</h3>
            <p class="text-center mb-4">Introduce la dirección IP o dominio de tu servidor QuimeraReader.</p>
            <div class="mb-3">
                <input type="url" class="form-control" @bind="_serverInput" placeholder="http://192.168.1.10:5000/" />
            </div>
            <button class="btn btn-primary w-100" @onclick="SaveConfig">Conectar</button>
        </div>
    </div>
}
else
{
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4" style="justify-content: flex-end; display: flex; align-items: center; border-bottom: 1px solid var(--border-color); background-color: var(--bg-card);">
            <button class="btn btn-outline-primary theme-toggle" @onclick="ToggleThemeAsync" style="border-radius: 20px; display: flex; align-items: center; gap: 6px;">
                @if (isDarkTheme)
                {
                    <span class="bi bi-moon-fill" aria-hidden="true"></span> <span>Modo Oscuro</span>
                }
                else
                {
                    <span class="bi bi-sun-fill" aria-hidden="true"></span> <span>Modo Claro</span>
                }
            </button>
        </div>

        <article class="content px-4 mt-3">
            @Body
        </article>
    </main>
</div>
<QuimeraReader.Shared.Components.ToastContainer />
}

@code {
    private bool isDarkTheme = true;
    private string _serverInput = "http://";

    private void SaveConfig()
    {
        if (!string.IsNullOrWhiteSpace(_serverInput))
        {
            ServerConfig.SaveServerUrl(_serverInput);
            NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "theme");
            if (theme == "light")
            {
                isDarkTheme = false;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        var newTheme = await JSRuntime.InvokeAsync<string>("themeManager.toggleTheme");
        isDarkTheme = (newTheme == "dark");
        StateHasChanged();
    }
}

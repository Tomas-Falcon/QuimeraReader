@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject QuimeraReader.Shared.Services.IServerConfigService ServerConfig
@inject NavigationManager NavManager
@inject QuimeraReader.Shared.Services.IQuimeraApiClient ApiClient
@namespace QuimeraReader.Shared.Components.Layout

@if (ServerConfig.NeedsConfiguration)
{
    <div class="d-flex align-items-center justify-content-center vh-100 bg-dark text-light">
        <div class="card p-4 bg-secondary" style="max-width: 400px; width: 100%; border-radius: 12px;">
            <h3 class="mb-4 text-center">Configuración del Servidor</h3>
            <p class="text-center mb-4">Introduce la dirección IP o dominio de tu servidor QuimeraReader.</p>
            <div class="mb-3">
                <input type="url" class="form-control" @bind="_serverInput" placeholder="http://192.168.1.10:5000/" />
            </div>
            <button class="btn btn-primary w-100" @onclick="SaveConfig">Conectar</button>
        </div>
    </div>
}
else
{
<div class="page @(IsReadingMode ? "reading-mode" : "")">
    @if (!IsReadingMode)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main class="@(IsReadingMode ? "p-0" : "")">
        @if (!IsReadingMode)
        {
            <div class="top-row px-4" style="justify-content: flex-end; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-color); background-color: var(--bg-card);">
                
                @if (_scanStatus != null && _scanStatus.IsScanning)
                {
                    <div class="d-flex align-items-center gap-2 me-auto ms-2 text-primary fw-bold pulse-animation">
                        <div class="spinner-grow spinner-grow-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span style="font-size: 0.9rem;">Analizando biblioteca... @(_scanStatus.TotalFilesFound > 0 ? $"{(_scanStatus.FilesProcessed * 100) / _scanStatus.TotalFilesFound}%" : "")</span>
                    </div>
                }

                <button class="btn btn-outline-secondary metadata-btn" @onclick="FetchMissingMetadata" disabled="@_isFetchingMetadata" style="border-radius: 20px; display: flex; align-items: center; gap: 6px;">
                    @if (_isFetchingMetadata)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Buscando...</span>
                    }
                    else
                    {
                        <span class="bi bi-cloud-download" aria-hidden="true"></span> <span>Metadatos</span>
                    }
                </button>

                <button class="btn btn-outline-primary theme-toggle" @onclick="ToggleThemeAsync" style="border-radius: 20px; display: flex; align-items: center; gap: 6px;">
                    @if (isDarkTheme)
                    {
                        <span class="bi bi-moon-fill" aria-hidden="true"></span> <span>Modo Oscuro</span>
                    }
                    else
                    {
                        <span class="bi bi-sun-fill" aria-hidden="true"></span> <span>Modo Claro</span>
                    }
                </button>
            </div>
        }

        <article class="content @(IsReadingMode ? "p-0 m-0" : "px-4 mt-3")">
            @Body
        </article>
    </main>
</div>
<QuimeraReader.Shared.Components.ToastContainer />
}

@code {
    private bool isDarkTheme = true;
    private string _serverInput = "http://";
    private bool _isFetchingMetadata = false;
    private bool IsReadingMode => NavManager.Uri.Contains("/read/", StringComparison.OrdinalIgnoreCase);
    private QuimeraReader.Shared.Models.ScanStatus? _scanStatus;
    private System.Threading.CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += (s, e) => StateHasChanged();
        if (!ServerConfig.NeedsConfiguration)
        {
            _ = PollScanStatusAsync();
        }
    }
    
    private async Task PollScanStatusAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!IsReadingMode)
                {
                    _scanStatus = await ApiClient.GetScanStatusAsync();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }
    
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task FetchMissingMetadata()
    {
        _isFetchingMetadata = true;
        StateHasChanged();
        
        try
        {
            await ApiClient.RescanMetadataAsync();
            // Mostrar notificación global? Wait, ToastService is not injected in MainLayout yet. 
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scanning metadata: {ex.Message}");
        }
        finally
        {
            _isFetchingMetadata = false;
            StateHasChanged();
        }
    }

    private void SaveConfig()
    {
        if (!string.IsNullOrWhiteSpace(_serverInput))
        {
            ServerConfig.SaveServerUrl(_serverInput);
            NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "theme");
            if (theme == "light")
            {
                isDarkTheme = false;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        var newTheme = await JSRuntime.InvokeAsync<string>("themeManager.toggleTheme");
        isDarkTheme = (newTheme == "dark");
        StateHasChanged();
    }
}

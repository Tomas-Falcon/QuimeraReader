@inherits LayoutComponentBase
@inject QuimeraReader.Shared.Interfaces.INetworkStateService NetworkStateService
@implements IDisposable

@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider
@inject QuimeraReader.Shared.Services.IServerConfigService ServerConfig
@inject NavigationManager NavManager
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@inject QuimeraReader.Shared.Services.ToastService ToastService
@namespace QuimeraReader.Shared.Components.Layout

@if (ServerConfig.NeedsConfiguration)
{
    <div class="d-flex align-items-center justify-content-center vh-100 bg-dark text-light">
        <div class="card p-4 bg-secondary" style="max-width: 400px; width: 100%; border-radius: 12px;">
            <h3 class="mb-4 text-center">@TranslationService["Settings_WelcomeConfigTitle"]</h3>
            <p class="text-center mb-4">@TranslationService["Settings_WelcomeConfigDesc"]</p>
            <div class="mb-3">
                <input type="url" class="form-control" @bind="_serverInput" placeholder="@TranslationService["Settings_ServerUrlPlaceholder"]" disabled="@_isTestingConfig" />
            </div>
            <button class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2" @onclick="SaveConfig" disabled="@_isTestingConfig">
                @if (_isTestingConfig)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>@TranslationService["Settings_Connecting"]</span>
                }
                else
                {
                    <span>@TranslationService["Settings_Connect"]</span>
                }
            </button>
        </div>
    </div>
    <QuimeraReader.Shared.Components.ToastContainer />
}
else if (!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center vh-100" style="background-color: var(--bg-body); color: var(--text-color);">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <RadzenLayout Style="grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body';">
        @if (!IsReadingMode)
        {
            <!-- Add pt-safe to give space for mobile status bar -->
            <RadzenHeader style="border-bottom: 1px solid var(--border-color); background-color: var(--bg-card); display: flex; align-items: center; justify-content: space-between; padding: 0 1rem; min-height: 60px;">
                <div class="d-flex align-items-center">
                    <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
                    <span class="ms-2 fw-bold" style="font-size: 1.2rem;">QuimeraReader</span>
                </div>
                
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (_scanStatus != null && _scanStatus.IsScanning)
                    {
                        <div class="d-flex align-items-center gap-2 d-none d-md-flex text-primary fw-bold pulse-animation">
                            <div class="spinner-grow spinner-grow-sm text-primary" role="status"></div>
                            <span style="font-size: 0.9rem;">@(_scanStatus.TotalFilesFound > 0 ? $"{(_scanStatus.FilesProcessed * 100) / _scanStatus.TotalFilesFound}%" : "...")</span>
                        </div>
                    }

                    <RadzenDropDown TValue="string" Value="@_currentLang" Data="@_languages" ValueProperty="Code" TextProperty="Name" Change="OnLanguageChanged" Style="width: 125px;" />
                    
                    <RadzenButton Icon="cloud_download" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="FetchMissingMetadata" IsBusy="@_isFetchingMetadata" title="Metadatos" />

                    <RadzenButton Icon="@(isDarkTheme ? "light_mode" : "dark_mode")" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="ToggleThemeAsync" title="Tema" />
                </div>
            </RadzenHeader>

            <RadzenSidebar @bind-Expanded="@_sidebarExpanded" style="background-color: var(--bg-card); border-right: 1px solid var(--border-color);">
                <NavMenu />
            </RadzenSidebar>
        }

        <RadzenBody class="@(IsReadingMode ? "p-0" : "p-4")">
            @Body
        </RadzenBody>
    </RadzenLayout>

    <QuimeraReader.Shared.Components.ToastContainer />
    <RadzenDialog />
}

@code {
    private bool _sidebarExpanded = true; private bool _isMobile = false;
    private bool isDarkTheme = true;
    private bool _isLoaded = false;
    private string _currentLang = "es";
    private List<dynamic> _languages = new List<dynamic>
    {
        new { Code = "es", Name = "ES" },
        new { Code = "en", Name = "EN" }
    };

    private async Task OnLanguageChanged(object value)
    {
        if (value != null)
        {
            _currentLang = value.ToString()!;
            await TranslationService.LoadLanguageAsync(_currentLang);
            NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
        }
    }
    private string _serverInput = "http://";
    private bool _isFetchingMetadata = false;
    private bool IsReadingMode => NavManager.Uri.Contains("/read/", StringComparison.OrdinalIgnoreCase);
    private QuimeraReader.Shared.Models.ScanStatus? _scanStatus;
    private System.Threading.CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        NetworkStateService.OnNetworkStateChanged += HandleNetworkChange;
        _ = NetworkStateService.InitializeAsync();

        NavManager.LocationChanged += (s, e) => { if (_isMobile) _sidebarExpanded = false; StateHasChanged(); };
        if (!ServerConfig.NeedsConfiguration)
        {
            _ = PollScanStatusAsync();
        }
        
        var worker = (QuimeraReader.Shared.Interfaces.IOfflineSyncWorker?)ServiceProvider.GetService(typeof(QuimeraReader.Shared.Interfaces.IOfflineSyncWorker));
        if (worker != null) {
            _ = worker.SyncNowAsync();
        }
    }

    private void HandleNetworkChange()
    {
        InvokeAsync(StateHasChanged);
        if (!NetworkStateService.IsOffline)
        {
            var worker = (QuimeraReader.Shared.Interfaces.IOfflineSyncWorker?)ServiceProvider.GetService(typeof(QuimeraReader.Shared.Interfaces.IOfflineSyncWorker));
            if (worker != null) {
                _ = worker.SyncNowAsync();
            }
        }
    }
    
    private async Task PollScanStatusAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!IsReadingMode)
                {
                    _scanStatus = await ScanService.GetScanStatusAsync();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }
    
    public void Dispose()
    {
        NetworkStateService.OnNetworkStateChanged -= HandleNetworkChange;
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task FetchMissingMetadata()
    {
        _isFetchingMetadata = true;
        StateHasChanged();
        
        try
        {
            await ScanService.RescanMetadataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scanning metadata: {ex.Message}");
        }
        finally
        {
            _isFetchingMetadata = false;
            StateHasChanged();
        }
    }

    private bool _isTestingConfig = false;

    private async Task SaveConfig()
    {
        if (string.IsNullOrWhiteSpace(_serverInput)) return;

        var rawUrl = _serverInput.Trim();
        if (!rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && 
            !rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            rawUrl = "http://" + rawUrl;
        }
        if (!rawUrl.EndsWith("/")) rawUrl += "/";

        if (!Uri.TryCreate(rawUrl, UriKind.Absolute, out var testUri))
        {
            ToastService.ShowError(TranslationService["Settings_InvalidUrl"]);
            return;
        }

        _isTestingConfig = true;
        StateHasChanged();

        bool canConnect = false;
        try
        {
            using var testClient = new HttpClient { Timeout = TimeSpan.FromSeconds(4) };
            var pingUri = new Uri(testUri, "api/Books?page=1&pageSize=1");
            using var response = await testClient.GetAsync(pingUri);
            if (response.IsSuccessStatusCode)
            {
                canConnect = true;
            }
        }
        catch
        {
            canConnect = false;
        }
        finally
        {
            _isTestingConfig = false;
            StateHasChanged();
        }

        // Se guarda la conexión de todas formas
        ServerConfig.SaveServerUrl(rawUrl);

        if (canConnect)
        {
            ToastService.ShowSuccess(TranslationService["Settings_ConnectionSuccess"]);
        }
        else
        {
            ToastService.ShowError(TranslationService["Settings_ConnectionFailed"]);
        }

        await Task.Delay(1500);
        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TranslationService.InitializeAsync();
            var storedLang = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "preferredLanguage");
            if (!string.IsNullOrEmpty(storedLang)) _currentLang = storedLang;
            
            var theme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "theme");
            if (theme == "light")
            {
                isDarkTheme = false;
            }
            
            // Auto collapse sidebar on mobile
            var screenWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            if (screenWidth < 768) { _isMobile = true; } if (screenWidth < 768)
            {
                _sidebarExpanded = false;
            }

            _isLoaded = true;
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        var newTheme = await JSRuntime.InvokeAsync<string>("themeManager.toggleTheme");
        isDarkTheme = (newTheme == "dark");
        StateHasChanged();
    }
}

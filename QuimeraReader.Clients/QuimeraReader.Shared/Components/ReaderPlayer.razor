    private string _audioSourceUrl = "";

    private static string GetAudioMimeType(string filePath)
    {
        var ext = System.IO.Path.GetExtension(filePath).ToLowerInvariant();
        return ext switch
        {
            ".m4b" or ".m4a" => "audio/mp4",
            ".ogg" => "audio/ogg",
            ".wav" => "audio/wav",
            _ => "audio/mpeg"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        Book = await BookService.GetBookAsync(BookId);
        
        if (Book != null)
        {
            // Inicializar el número de pista antes del primer renderizado para evitar cargar la Pista 1 por error
            if (Book.CurrentAudioTrackNumber.HasValue && Book.CurrentAudioTrackNumber.Value > 0)
            {
                _currentTrackNumber = Book.CurrentAudioTrackNumber.Value;
            }
            if (Book.CurrentAudioPosition.HasValue && Book.CurrentAudioPosition.Value > 0)
            {
                _currentTime = Book.CurrentAudioPosition.Value;
            }

            var localRepo = ServiceProvider.GetService(typeof(QuimeraReader.Shared.Interfaces.ILocalBookRepository)) as QuimeraReader.Shared.Interfaces.ILocalBookRepository;
            var audioFileUrl = localRepo != null ? await localRepo.GetBookFileUrlAsync(BookId, "audio") : null;
            if (!string.IsNullOrEmpty(audioFileUrl) && (audioFileUrl.StartsWith("blob:") || audioFileUrl.StartsWith("data:")))
            {
                _audioSourceUrl = audioFileUrl;
            }
            else if (!string.IsNullOrEmpty(audioFileUrl) && System.IO.File.Exists(audioFileUrl))
            {
                // En MAUI Android/iOS, el WebView corre sobre https://0.0.0.0/ y bloquea rutas file:// locales en <audio src="...">
                try
                {
                    var fileInfo = new System.IO.FileInfo(audioFileUrl);
                    if (fileInfo.Length > 0 && fileInfo.Length <= 250 * 1024 * 1024)
                    {
                        var bytes = await System.IO.File.ReadAllBytesAsync(audioFileUrl);
                        var mime = GetAudioMimeType(audioFileUrl);
                        _audioSourceUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                    }
                    else
                    {
                        _audioSourceUrl = audioFileUrl;
                    }
                }
                catch
                {
                    _audioSourceUrl = audioFileUrl;
                }
            }
            else
            {
                _audioSourceUrl = $"{BookService.BaseAddress.TrimEnd('/')}/{Book.AudioUrl}";
            }
        }
        
        if (Book != null)
        {
            try
            {
                var syncMapJson = !string.IsNullOrEmpty(Book.SyncMapJson) ? Book.SyncMapJson : await BookService.GetSyncMapAsync(BookId);
                if (!string.IsNullOrEmpty(syncMapJson))
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    _segments = JsonSerializer.Deserialize<List<SyncSegment>>(syncMapJson, options) ?? new();
                }
            }
            catch { }
        }

        if (Book?.PercentageCompleted.HasValue == true)
        {
            _displayPercentage = Math.Clamp(Book.PercentageCompleted.Value, 0.0, 100.0);
        }

        _isLoading = false;
    }

    private bool _playerInitialized = false;
    private IJSObjectReference? _epubJsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_playerInitialized && Book != null && !_isLoading)
        {
            _playerInitialized = true;

            // Cargar preferencias de lectura guardadas (Tema y Tamaño de fuente)
            try
            {
                var savedTheme = await JS.InvokeAsync<string?>("window.localStorage.getItem", "quimera_reader_theme");
                if (!string.IsNullOrWhiteSpace(savedTheme)) _currentTheme = savedTheme;

                var savedFontSize = await JS.InvokeAsync<string?>("window.localStorage.getItem", "quimera_reader_fontsize");
                if (int.TryParse(savedFontSize, out int parsedSize) && parsedSize >= 70 && parsedSize <= 200)
                {
                    _fontSize = parsedSize;
                }
            }
            catch { }
            
            if (Book.HasAudio)
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/playerInterop.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                await _jsModule.InvokeVoidAsync("initializePlayer", _audioElement, _dotNetRef);

                if (Book.CurrentAudioPosition.HasValue && Book.CurrentAudioPosition.Value > 0)
                {
                    await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, Book.CurrentAudioPosition.Value);
                }
            }

            if (Book.HasEpub)
            {
                if (_dotNetRef == null) _dotNetRef = DotNetObjectReference.Create(this);
                _epubJsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/epubInterop.js");

                // Si no hay CFI guardado pero sí hay posición de audio y mapa de sincronización, calcular porcentaje inicial
                double initialPct = Book.PercentageCompleted ?? 0;
                if (string.IsNullOrWhiteSpace(Book.CurrentEpubCfi) && initialPct <= 0 && _currentTime > 0 && _segments.Any())
                {
                    var approx = GetApproximateAudioPercentage(_currentTime, _currentTrackNumber);
                    if (approx > 0) initialPct = approx * 100.0;
                }

                var localRepo = ServiceProvider.GetService(typeof(QuimeraReader.Shared.Interfaces.ILocalBookRepository)) as QuimeraReader.Shared.Interfaces.ILocalBookRepository;
                var epubFileUrl = localRepo != null ? await localRepo.GetBookFileUrlAsync(BookId, "epub") : null;
                
                if (!string.IsNullOrEmpty(epubFileUrl) && (epubFileUrl.StartsWith("blob:") || System.IO.File.Exists(epubFileUrl)))
                {
                    if (epubFileUrl.StartsWith("blob:")) 
                    {
                        await _epubJsModule.InvokeVoidAsync("initializeEpub", "epub-viewer", epubFileUrl, _dotNetRef, Book.CurrentEpubCfi, Book.EpubLocationsCache, initialPct, _currentTheme, _fontSize);
                    }
                    else
                    {
                        try 
                        {
                            using var fileStream = System.IO.File.OpenRead(epubFileUrl);
                            using var streamRef = new DotNetStreamReference(stream: fileStream);
                            await _epubJsModule.InvokeVoidAsync("initializeEpubFromStream", "epub-viewer", streamRef, _dotNetRef, Book.CurrentEpubCfi, Book.EpubLocationsCache, initialPct, _currentTheme, _fontSize);
                        }
                        catch (Exception ex)
                        {
                            System.Console.WriteLine($"Error reading local EPUB: {ex.Message}");
                        }
                    }
                }
                else if (!string.IsNullOrEmpty(Book.LocalEpubPath) && System.IO.File.Exists(Book.LocalEpubPath))
                {
                    try 
                    {
                        using var fileStream = System.IO.File.OpenRead(Book.LocalEpubPath);
                        using var streamRef = new DotNetStreamReference(stream: fileStream);
                        await _epubJsModule.InvokeVoidAsync("initializeEpubFromStream", "epub-viewer", streamRef, _dotNetRef, Book.CurrentEpubCfi, Book.EpubLocationsCache, initialPct, _currentTheme, _fontSize);
                    }
                    catch (Exception ex)
                    {
                        System.Console.WriteLine($"Error reading local EPUB: {ex.Message}");
                    }
                }
                else
                {
                    var baseUrl = BookService.BaseAddress.TrimEnd('/');
                    var epubApiUrl = $"{baseUrl}/{Book.EpubUrl}";
                    await _epubJsModule.InvokeVoidAsync("initializeEpub", "epub-viewer", epubApiUrl, _dotNetRef, Book.CurrentEpubCfi, Book.EpubLocationsCache, initialPct, _currentTheme, _fontSize);
                }

                // Cargar y pintar anotaciones guardadas en el hilo de UI una vez inicializado el visor
                try
                {
                    _bookAnnotations = await BookService.GetAnnotationsAsync(BookId);
                    if (_bookAnnotations.Any() && _epubJsModule != null)
                    {
                        var json = System.Text.Json.JsonSerializer.Serialize(_bookAnnotations);
                        await _epubJsModule.InvokeVoidAsync("applyAllAnnotations", json);
                    }
                }
                catch { }

                // Si el usuario tenía posición de audio activa, resaltar o situar la marca de audio inicial
                if (_currentTime > 0 && _segments.Any())
                {
                    var currentSeg = FindSegmentAtTime(_currentTime, _currentTrackNumber);
                    if (currentSeg != null && _epubJsModule != null)
                    {
                        var cfi = await _epubJsModule.InvokeAsync<string?>("highlightKaraokePhrase", currentSeg.Text, string.IsNullOrWhiteSpace(Book.CurrentEpubCfi));
                        if (!string.IsNullOrEmpty(cfi))
                        {
                            await _epubJsModule.InvokeVoidAsync("convertKaraokeToHardMark");
                        }
                    }
                }
            }
        }
    }


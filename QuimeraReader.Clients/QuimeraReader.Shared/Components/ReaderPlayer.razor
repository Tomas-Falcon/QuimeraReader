    private string GetCurrentTrackUrl()
    {
        if (!string.IsNullOrEmpty(_audioSourceUrl) && (_audioSourceUrl.StartsWith("blob:") || _audioSourceUrl.StartsWith("data:")))
        {
            return _audioSourceUrl;
        }

        if (Book?.AudioTracks == null || Book.AudioTracks.Count == 0)
            return $"{BookService.BaseAddress.TrimEnd('/')}/" + Book?.AudioUrl;

        return $"{BookService.BaseAddress.TrimEnd('/')}/api/media/books/{BookId}/tracks/{_currentTrackNumber}";
    }


@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Text.Json.Serialization
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@inject IJSRuntime JS
@implements IAsyncDisposable
@namespace QuimeraReader.Shared.Components

<div class="reader-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Preparando tu libro...</p>
        </div>
    }
    else if (Book != null)
    {
        <!-- Main Content -->
        <div class="reader-content d-flex flex-column" style="height: 100vh; overflow: hidden; background: var(--bg-body); padding: 0;">
            <!-- Header (Auto-hidden in future, but keep for back button for now) -->
            <div class="reader-header" style="padding: 10px 20px; z-index: 10; display: flex; justify-content: space-between; align-items: center; background: var(--bg-card); border-bottom: 1px solid var(--border-color);">
                <button class="btn btn-link text-white text-decoration-none px-0" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-2"></i> Volver
                </button>
                <div class="text-center" style="flex: 1;">
                    <h5 class="mb-0 text-truncate" style="max-width: 300px; margin: 0 auto;">@Book.Title</h5>
                </div>
                <div style="width: 70px;"></div> <!-- Spacer -->
            </div>

            <!-- Text Area / EPUB Reader -->
            <div class="text-container position-relative" id="text-container" style="flex: 1; display: flex; flex-direction: column;">
                @if (Book.HasEpub)
                {
                    <div id="epub-viewer" style="flex: 1; width: 100%; height: 100%; overflow: hidden;">
                        <!-- Epub.js will render the book here -->
                    </div>
                    
                    <!-- Progress Footer -->
                    <div class="reading-progress text-center py-2" style="background: var(--bg-card); font-size: 0.85rem; color: var(--text-muted);">
                        @if (Book.PercentageCompleted.HasValue)
                        {
                            <span>@($"{Math.Round(Book.PercentageCompleted.Value, 1)}% leído")</span>
                        }
                    </div>
                }
                else if (_segments != null && _segments.Any())
                {
                    <div class="sync-text p-4" style="flex: 1; overflow-y: auto;">
                        @for (int i = 0; i < _segments.Count; i++)
                        {
                            var segment = _segments[i];
                            var index = i;
                            var isActive = _currentTime >= segment.Start && _currentTime <= segment.End;
                            <span class="segment @(isActive ? "active-segment" : "")" @onclick="() => SeekToSegmentAsync(segment.Start)">
                                @segment.Text 
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="no-sync-map text-center pt-5" style="flex: 1;">
                        <img src="@(BookService.BaseAddress + @Book.CoverUrl)" class="fallback-cover mb-4" style="max-width: 200px; border-radius: 8px;" />
                        <h3>Modo Audiolibro Puro</h3>
                        <p class="text-muted">No se encontraron transcripciones o texto para este título.</p>
                    </div>
                }
            </div>

            <!-- Native Player (Hidden unless audio exists and we want to show it, for now we keep it visible at the bottom if Audio exists) -->
            @if (Book.HasAudio)
            {
                <div class="player-controls" style="background: var(--bg-card); padding: 10px;">
                    <audio @ref="_audioElement" src="@(BookService.BaseAddress + @Book.AudioUrl)" controls class="native-audio w-100" />
                </div>
            }
        </div>
    }
</div>



@code {
    [Parameter]
    public int BookId { get; set; }

    [Inject]
    public NavigationManager NavManager { get; set; } = default!;

    public Book? Book { get; set; }
    
    private void GoBack()
    {
        NavManager.NavigateTo($"/book/{BookId}");
    }
    
    private bool _isLoading = true;
    private ElementReference _audioElement;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<ReaderPlayer>? _dotNetRef;
    private double _currentTime = 0;
    private bool _isPlaying = false;
    private List<SyncSegment> _segments = new();

    protected override async Task OnInitializedAsync()
    {
        Book = await BookService.GetBookAsync(BookId);
        
        if (Book != null && Book.IsAligned)
        {
            try
            {
                var syncMapJson = await BookService.GetSyncMapAsync(BookId);
                if (!string.IsNullOrEmpty(syncMapJson))
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    _segments = JsonSerializer.Deserialize<List<SyncSegment>>(syncMapJson, options) ?? new();
                }
            }
            catch { /* Ignorar error por ahora */ }
        }

        _isLoading = false;
    }

    private bool _playerInitialized = false;
    private IJSObjectReference? _epubJsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_playerInitialized && Book != null && !_isLoading)
        {
            _playerInitialized = true;
            
            if (Book.HasAudio)
            {
                // Audio Player Initialization
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/playerInterop.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                await _jsModule.InvokeVoidAsync("initializePlayer", _audioElement, _dotNetRef);

                if (Book.CurrentAudioPosition.HasValue && Book.CurrentAudioPosition.Value > 0)
                {
                    await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, Book.CurrentAudioPosition.Value);
                }
            }

            // EPUB Reader Initialization
            if (Book.HasEpub)
            {
                if (_dotNetRef == null) _dotNetRef = DotNetObjectReference.Create(this);
                _epubJsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/epubInterop.js");
                // Construct the absolute URL to the EPUB file via API
                var baseUrl = BookService.BaseAddress.TrimEnd('/');
                var epubApiUrl = $"{baseUrl}/{Book.EpubUrl}";
                
                await _epubJsModule.InvokeVoidAsync("initializeEpub", "epub-viewer", epubApiUrl, _dotNetRef, Book.CurrentEpubCfi, Book.EpubLocationsCache);
            }
        }
    }

        [JSInvokable]
    public async Task SaveLocationsCache(string locationsJson)
    {
        if (Book != null)
        {
            Book.EpubLocationsCache = locationsJson;
            await BookService.SaveEpubLocationsAsync(BookId, locationsJson);
        }
    }

    [JSInvokable]
    public void OnEpubLocationChanged(string cfi, double percentage)
    {
        // Guardar el CFI y el porcentaje
        double? scaledPercentage = percentage >= 0 ? (percentage * 100.0) : null;
        
        if (Book != null)
        {
            Book.CurrentEpubCfi = cfi;
            if (scaledPercentage.HasValue) 
                Book.PercentageCompleted = scaledPercentage.Value;
            StateHasChanged();
        }

        _ = BookService.UpdatePositionAsync(BookId, epubCfi: cfi, percentage: scaledPercentage);
    }

    private async Task NextPage()
    {
        if (_epubJsModule != null)
            await _epubJsModule.InvokeVoidAsync("nextEpubPage");
    }

    private async Task PrevPage()
    {
        if (_epubJsModule != null)
            await _epubJsModule.InvokeVoidAsync("prevEpubPage");
    }

    private int _lastActiveIndex = -1;
    private double _lastSavedTime = -1;

    [JSInvokable]
    public async Task OnTimeUpdate(double time)
    {
        _currentTime = time;
        
        // Guardar progreso cada 10 segundos
        if (_lastSavedTime == -1 || (time - _lastSavedTime) > 10)
        {
            _lastSavedTime = time;
            // Solo mandamos el audioPosition, dejamos el epubCfi intacto o null. 
            // Percentage se podría calcular si tuviéramos el total duration.
            _ = BookService.UpdatePositionAsync(BookId, audioPosition: time);
        }

        var currentIndex = _segments.FindIndex(s => time >= s.Start && time <= s.End);
        if (currentIndex != -1 && currentIndex != _lastActiveIndex)
        {
            _lastActiveIndex = currentIndex;
            StateHasChanged();
            
            if (_jsModule != null)
            {
                await _jsModule.InvokeVoidAsync("scrollToActiveSegment");
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnPlayStateChanged(bool isPlaying)
    {
        _isPlaying = isPlaying;
        StateHasChanged();
    }

    private async Task SeekToSegmentAsync(double time)
    {
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, time);
            await _jsModule.InvokeVoidAsync("playAudio", _audioElement);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
        if (_epubJsModule != null)
        {
            await _epubJsModule.DisposeAsync();
        }
    }

    public class SyncSegment
    {
        [JsonPropertyName("start")]
        public double Start { get; set; }
        
        [JsonPropertyName("end")]
        public double End { get; set; }
        
        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;
    }
}



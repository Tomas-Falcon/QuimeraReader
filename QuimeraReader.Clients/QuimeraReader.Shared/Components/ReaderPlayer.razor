    {
        await SetAudioBookmarkAsync(true);
    }

    private async Task DeleteAnnotationAsync()
    {
        if (_editingAnnotationId.HasValue && _epubJsModule != null)
        {
            try
            {
                await BookService.DeleteAnnotationAsync(BookId, _editingAnnotationId.Value);
                _bookAnnotations?.RemoveAll(a => a.Id == _editingAnnotationId.Value || a.CfiRange == _selectedCfi);
                await _epubJsModule.InvokeVoidAsync("removeAnnotation", _selectedCfi);
                ToastService.ShowSuccess("Anotación eliminada.");
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error al eliminar: {ex.Message}");
            }
        }
        await CloseAnnotationDialogAsync();
    }

    private async Task SaveAnnotationAsync()
    {
        _showAnnotationDialog = false;
        if (_epubJsModule != null)
        {
            await _epubJsModule.InvokeVoidAsync("clearTextSelection");
        }

        if (_epubJsModule != null && !string.IsNullOrEmpty(_selectedCfi))
        {
            bool hasNote = !string.IsNullOrWhiteSpace(_annotationNote);
            string color = _selectedColor ?? "";
            
            if (_editingAnnotationId.HasValue)
            {
                await _epubJsModule.InvokeVoidAsync("removeAnnotation", _selectedCfi);
            }
            
            // Permitir los 5 tipos de marcado (incluyendo color == "" para "Solo subrayado" con o sin nota)
            await _epubJsModule.InvokeVoidAsync("applyAnnotation", _selectedCfi, color, hasNote);
            
            try 
            {
                if (_editingAnnotationId.HasValue)
                {
                    await BookService.UpdateAnnotationAsync(BookId, _editingAnnotationId.Value, color, _annotationNote);
                    var ann = _bookAnnotations?.FirstOrDefault(a => a.Id == _editingAnnotationId.Value || a.CfiRange == _selectedCfi);
                    if (ann != null)
                    {
                        ann.ColorHex = color;
                        ann.Note = _annotationNote;
                    }
                    ToastService.ShowSuccess("Anotación actualizada.");
                }
                else
                {
                    await BookService.CreateAnnotationAsync(BookId, _selectedCfi, _selectedText, color, _annotationNote);
                    _bookAnnotations = await BookService.GetAnnotationsAsync(BookId);
                    ToastService.ShowSuccess("Anotación guardada.");
                }

                if (_bookAnnotations != null)
                {
                    var json = System.Text.Json.JsonSerializer.Serialize(_bookAnnotations);
                    await _epubJsModule.InvokeVoidAsync("applyAllAnnotations", json);
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error guardando anotación: {ex.Message}");
            }
        }
    }


    [JSInvokable]
    public void OnEpubLocationChanged(string cfi, double percentage, int currentPage = 0, int totalPages = 0)
    {
        double? scaledPercentage = percentage >= 0 ? (percentage * 100.0) : null;
        
        if (Book != null)
        {
            bool cfiChanged = Book.CurrentEpubCfi != cfi;
            Book.CurrentEpubCfi = cfi;
            if (cfiChanged && !_isPlaying)
            {
                _pageMovedSinceAudioSync = true;
            }

            if (scaledPercentage.HasValue) 
            {
                Book.PercentageCompleted = scaledPercentage.Value;
                if (!_isDraggingProgress)
                {
                    _displayPercentage = Math.Clamp(scaledPercentage.Value, 0.0, 100.0);
                }
            }
            if (totalPages > 0)
            {
                Book.TotalPages = totalPages;
                _totalPages = totalPages;
            }
            if (currentPage >= 0 && totalPages > 0)
            {
                _currentPage = Math.Max(1, currentPage);
            }
            StateHasChanged();
        }

        _ = System.Threading.Tasks.Task.Run(async () => {
            try {
                await BookService.UpdatePositionAsync(BookId, epubCfi: cfi, percentage: scaledPercentage, audioTrackNumber: Book?.HasAudio == true ? _currentTrackNumber : null);
            } catch { }
        });
    }


﻿@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Text.Json.Serialization
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@inject QuimeraReader.Shared.Services.ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable
@namespace QuimeraReader.Shared.Components

<div class="reader-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Preparando tu libro...</p>
        </div>
    }
    else if (Book != null)
    {
        <!-- Main Content -->
        <div class="reader-content d-flex flex-column" style="height: 100vh; overflow: hidden; background: var(--bg-body); padding: 0;">
            <!-- Header (Auto-hidden in future, but keep for back button for now) -->
            <div class="reader-header" style="padding: 10px 20px; z-index: 10; display: flex; justify-content: space-between; align-items: center; background: var(--bg-card); border-bottom: 1px solid var(--border-color);">
                <button class="btn btn-link text-white text-decoration-none px-0" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-2"></i> Volver
                </button>
                <div class="text-center" style="flex: 1;">
                    <h5 class="mb-0 text-truncate" style="max-width: 300px; margin: 0 auto;">@Book.Title</h5>
                </div>
                <div style="width: 70px;"></div> <!-- Spacer -->
            </div>

            <!-- Text Area / EPUB Reader -->
            <div class="text-container position-relative" id="text-container" style="flex: 1; display: flex; flex-direction: column;">
                @if (Book.HasEpub)
                {
                    <div id="epub-viewer" style="flex: 1; width: 100%; min-height: 0; overflow: hidden;">
                        <!-- Epub.js will render the book here -->
                    </div>
                    
                    <!-- Progress Footer (Kindle Style) -->
                    <div class="reading-progress px-4 py-2" style="background: var(--bg-card); font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid rgba(255,255,255,0.1);">
                        <div class="d-flex align-items-center justify-content-between mb-1" style="font-size: 0.75rem;">
                            <span class="fw-bold text-white-50">@(_totalPages > 0 ? $"Pág. {_currentPage}" : "")</span>
                            <span class="fw-bold text-white-50">@(_totalPages > 0 ? $"{_totalPages} páginas -" : "") @($"{Math.Round(Book.PercentageCompleted ?? 0, 1)}%")</span>
                        </div>
                        <input type="range" class="form-range custom-progress-bar" min="0" max="100" step="0.1" value="@(Book.PercentageCompleted ?? 0)" @onchange="OnProgressSliderChanged" />
                    </div>
                }
                else if (_segments != null && _segments.Any())
                {
                    <div class="sync-text p-4" style="flex: 1; overflow-y: auto;">
                        @for (int i = 0; i < _segments.Count; i++)
                        {
                            var segment = _segments[i];
                            var index = i;
                            var isActive = _currentTime >= segment.Start && _currentTime <= segment.End;
                            <span class="segment @(isActive ? "active-segment" : "")" @onclick="() => SeekToSegmentAsync(segment.Start)">
                                @segment.Text 
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="no-sync-map text-center pt-5" style="flex: 1;">
                        <img src="@(BookService.BaseAddress + @Book.CoverUrl)" class="fallback-cover mb-4" style="max-width: 200px; border-radius: 8px;" />
                        <h3>Modo Audiolibro Puro</h3>
                        <p class="text-muted">No se encontraron transcripciones o texto para este título.</p>
                    </div>
                }
            </div>

            
    @if (_showAnnotationDialog)
    {
        <div class="annotation-dialog position-fixed" style="bottom: 80px; left: 50%; transform: translateX(-50%); background: var(--bg-card); padding: 15px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 9999; width: 90%; max-width: 400px; border: 1px solid rgba(255,255,255,0.1);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 text-white"><i class="bi bi-pencil-square me-2"></i> Nueva Anotación</h6>
                <button class="btn-close btn-close-white" @onclick="CloseAnnotationDialog"></button>
            </div>
            <p class="text-white-50 small mb-3 text-truncate" style="font-style: italic;">"@_selectedText"</p>
            
            <div class="mb-3">
                <label class="form-label text-white-50 small">Color de resaltado</label>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm rounded-circle" style="width: 30px; height: 30px; background-color: #ffeb3b; border: @(_selectedColor == "#ffeb3b" ? "2px solid white" : "none")" @onclick="@(() => _selectedColor = "#ffeb3b")"></button>
                    <button class="btn btn-sm rounded-circle" style="width: 30px; height: 30px; background-color: #4caf50; border: @(_selectedColor == "#4caf50" ? "2px solid white" : "none")" @onclick="@(() => _selectedColor = "#4caf50")"></button>
                    <button class="btn btn-sm rounded-circle" style="width: 30px; height: 30px; background-color: #2196f3; border: @(_selectedColor == "#2196f3" ? "2px solid white" : "none")" @onclick="@(() => _selectedColor = "#2196f3")"></button>
                    <button class="btn btn-sm rounded-circle" style="width: 30px; height: 30px; background-color: #f44336; border: @(_selectedColor == "#f44336" ? "2px solid white" : "none")" @onclick="@(() => _selectedColor = "#f44336")"></button>
                    <button class="btn btn-sm rounded-circle" style="width: 30px; height: 30px; background-color: transparent; border: 1px dashed rgba(255,255,255,0.5);" @onclick="@(() => _selectedColor = "")" title="Sin color (Solo subrayado)"></button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-white-50 small">Nota (Opcional)</label>
                <textarea class="form-control bg-dark text-white border-secondary" @bind="_annotationNote" rows="2" placeholder="Escribe un comentario..."></textarea>
            </div>

            <div class="d-flex justify-content-between gap-2">
                @if (Book.HasAudio && _segments.Any())
                {
                    <button class="btn btn-info btn-sm text-white" @onclick="PlayFromSelectionAsync"><i class="bi bi-play-circle me-1"></i> Reproducir</button>
                }
                else
                {
                    <div></div>
                }
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseAnnotationDialog">Cancelar</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveAnnotationAsync">Guardar</button>
                </div>
            </div>
        </div>
    }

            <!-- Native Player (Hidden unless audio exists and we want to show it, for now we keep it visible at the bottom if Audio exists) -->
            @if (Book.HasAudio)
            {
                <div class="player-controls" style="background: var(--bg-card); padding: 10px;">
                    <audio @ref="_audioElement" src="@(BookService.BaseAddress + @Book.AudioUrl)" controls class="native-audio w-100" />
                </div>
            }
        </div>
    }
</div>



@code {
    [Parameter]
    public int BookId { get; set; }

    [Inject]
    public NavigationManager NavManager { get; set; } = default!;

    public Book? Book { get; set; }
    
    private void GoBack()
    {
        NavManager.NavigateTo($"/book/{BookId}");
    }
    
    private bool _isLoading = true;
    private ElementReference _audioElement;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<ReaderPlayer>? _dotNetRef;
    private double _currentTime = 0; private int _currentPage = 0; private int _totalPages = 0;
    private int _currentTrackNumber = 1;
    private bool _showPlaylist = false;

    private void TogglePlaylist() => _showPlaylist = !_showPlaylist;

    private string GetCurrentTrackUrl()
    {
        if (Book?.AudioTracks == null || Book.AudioTracks.Count == 0)
            return $"{BookService.BaseAddress.TrimEnd('/')}/" + Book?.AudioUrl;

        return $"{BookService.BaseAddress.TrimEnd('/')}/api/media/books/{BookId}/tracks/{_currentTrackNumber}";
    }

    private async Task ChangeTrackAsync(int trackNumber)
    {
        _currentTrackNumber = trackNumber;
        _currentTime = 0;
        _lastSavedTime = -1;
        _showPlaylist = false;
        StateHasChanged();
        await Task.Delay(50);
        if (_jsModule != null) await _jsModule.InvokeVoidAsync("playAudio", _audioElement);
        _ = BookService.UpdatePositionAsync(BookId, audioPosition: 0, audioTrackNumber: _currentTrackNumber);
    }
    private bool _isPlaying = false;
    private List<SyncSegment> _segments = new();

    protected override async Task OnInitializedAsync()
    {
        Book = await BookService.GetBookAsync(BookId);
        
        if (Book != null && Book.IsAligned)
        {
            try
            {
                var syncMapJson = await BookService.GetSyncMapAsync(BookId);
                if (!string.IsNullOrEmpty(syncMapJson))
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    _segments = JsonSerializer.Deserialize<List<SyncSegment>>(syncMapJson, options) ?? new();
                }
            }
            catch { /* Ignorar error por ahora */ }
        }

        _isLoading = false;
    }

    private bool _playerInitialized = false;
    private IJSObjectReference? _epubJsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_playerInitialized && Book != null && !_isLoading)
        {
            _playerInitialized = true;
            
            if (Book.HasAudio)
            {
                // Audio Player Initialization
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/playerInterop.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                await _jsModule.InvokeVoidAsync("initializePlayer", _audioElement, _dotNetRef);

                if (Book.CurrentAudioTrackNumber.HasValue) _currentTrackNumber = Book.CurrentAudioTrackNumber.Value;
                StateHasChanged();
                await Task.Delay(50);
                if (Book.CurrentAudioPosition.HasValue && Book.CurrentAudioPosition.Value > 0)
                {
                    await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, Book.CurrentAudioPosition.Value);
                }
            }

            // EPUB Reader Initialization
            if (Book.HasEpub)
            {
                if (_dotNetRef == null) _dotNetRef = DotNetObjectReference.Create(this);
                _epubJsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/epubInterop.js");
                // Construct the absolute URL to the EPUB file via API
                var baseUrl = BookService.BaseAddress.TrimEnd('/');
                var epubApiUrl = $"{baseUrl}/{Book.EpubUrl}";
                
                await _epubJsModule.InvokeVoidAsync("initializeEpub", "epub-viewer", epubApiUrl, _dotNetRef, Book.CurrentEpubCfi, Book.EpubLocationsCache);
            }
        }
    }

        [JSInvokable]
    public async Task SaveLocationsCache(string locationsJson)
    {
        if (Book != null)
        {
            Book.EpubLocationsCache = locationsJson;
            await BookService.SaveEpubLocationsAsync(BookId, locationsJson);
        }
    }

    [JSInvokable]
    public void OnEpubLocationChanged(string cfi, double percentage, int currentPage = 0, int totalPages = 0)
    {
        // Guardar el CFI y el porcentaje
        double? scaledPercentage = percentage >= 0 ? (percentage * 100.0) : null;
        
        if (Book != null)
        {
            Book.CurrentEpubCfi = cfi;
            if (scaledPercentage.HasValue) 
                Book.PercentageCompleted = scaledPercentage.Value;
            if (totalPages > 0) Book.TotalPages = totalPages;
            if (currentPage > 0) { _currentPage = currentPage; _totalPages = totalPages; }
            StateHasChanged();
        }

        _ = System.Threading.Tasks.Task.Run(async () => {
            try {
                await BookService.UpdatePositionAsync(BookId, epubCfi: cfi, percentage: scaledPercentage);
            } catch { }
        });
    }

    private async Task NextPage()
    {
        if (_epubJsModule != null)
            await _epubJsModule.InvokeVoidAsync("nextEpubPage");
    }

    
    private bool _showAnnotationDialog = false;
    private string _selectedCfi = "";
    private string _selectedText = "";
    private string _selectedColor = "#ffeb3b";
    private string _annotationNote = "";

    [JSInvokable]
    public void OnEpubTextSelected(string cfiRange, string text)
    {
        _selectedCfi = cfiRange;
        _selectedText = text;
        _selectedColor = "#ffeb3b";
        _annotationNote = "";
        _showAnnotationDialog = true;
        StateHasChanged();
    }

    private void CloseAnnotationDialog()
    {
        _showAnnotationDialog = false;
        StateHasChanged();
    }

    private async Task PlayFromSelectionAsync()
    {
        _showAnnotationDialog = false;
        if (!string.IsNullOrEmpty(_selectedText) && _segments.Any())
        {
            // Normalize selected text
            var searchStr = new string(_selectedText.ToLower().Where(c => char.IsLetterOrDigit(c)).ToArray());
            
            // Find in segments
            var match = _segments.FirstOrDefault(s => {
                var sText = new string(s.Text.ToLower().Where(c => char.IsLetterOrDigit(c)).ToArray());
                return sText.Contains(searchStr) || searchStr.Contains(sText);
            });

            if (match != null)
            {
                var startOffset = Math.Max(0, match.Start - 1.5);
                await SeekToSegmentAsync(startOffset);
                ToastService.ShowSuccess("Reproduciendo desde la selección.");
            }
            else
            {
                ToastService.ShowError("No se encontró el audio para este fragmento.");
            }
        }
    }

    private async Task SaveAnnotationAsync()
    {
        _showAnnotationDialog = false;
        if (_epubJsModule != null && !string.IsNullOrEmpty(_selectedCfi))
        {
            bool hasNote = !string.IsNullOrWhiteSpace(_annotationNote);
            string color = _selectedColor;
            
            // If neither highlighted nor noted, don't do anything
            if (string.IsNullOrEmpty(color) && !hasNote) return;

            // Apply immediately to UI
            await _epubJsModule.InvokeVoidAsync("applyAnnotation", _selectedCfi, color, hasNote);
            
            // Persist
            try 
            {
                await BookService.CreateAnnotationAsync(BookId, _selectedCfi, _selectedText, color, _annotationNote);
                ToastService.ShowSuccess("Anotación guardada.");
            }
            catch(Exception ex)
            {
                ToastService.ShowError($"Error guardando anotación: {ex.Message}");
            }
        }
    }

    private async Task PrevPage()
    {
        if (_epubJsModule != null)
            await _epubJsModule.InvokeVoidAsync("prevEpubPage");
    }

    private async Task OnProgressSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double newPct))
        {
            if (_epubJsModule != null)
            {
                await _epubJsModule.InvokeVoidAsync("goToPercentage", newPct);
            }
        }
    }

    private int _lastActiveIndex = -1;
    private double _lastSavedTime = -1;

    [JSInvokable]
    public async Task OnTimeUpdate(double time)
    {
        _currentTime = time;
        
        // Guardar progreso cada 10 segundos
        if (_lastSavedTime == -1 || (time - _lastSavedTime) > 10)
        {
            _lastSavedTime = time;
            // Solo mandamos el audioPosition, dejamos el epubCfi intacto o null. 
            // Percentage se podría calcular si tuviéramos el total duration.
            _ = BookService.UpdatePositionAsync(BookId, audioPosition: time, audioTrackNumber: _currentTrackNumber);
        }

        var currentIndex = _segments.FindIndex(s => time >= s.Start && time <= s.End);
        if (currentIndex != -1 && currentIndex != _lastActiveIndex)
        {
            _lastActiveIndex = currentIndex;
            StateHasChanged();
            
            if (_epubJsModule != null)
            {
                await _epubJsModule.InvokeVoidAsync("highlightKaraokePhrase", _segments[currentIndex].Text);
            }
            if (_jsModule != null)
            {
                await _jsModule.InvokeVoidAsync("scrollToActiveSegment");
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
        [JSInvokable]
    public async Task OnAudioEnded()
    {
        if (Book?.AudioTracks != null && Book.AudioTracks.Count > 0)
        {
            var maxTrack = Book.AudioTracks.Max(t => t.TrackNumber);
            if (_currentTrackNumber < maxTrack)
            {
                await ChangeTrackAsync(_currentTrackNumber + 1);
            }
        }
    }

    [JSInvokable]
    public void OnPlayStateChanged(bool isPlaying)
    {
        _isPlaying = isPlaying;
        StateHasChanged();
    }

    private async Task SeekToSegmentAsync(double time)
    {
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, time);
            await _jsModule.InvokeVoidAsync("playAudio", _audioElement);
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Guardado de emergencia al salir
        if (Book != null && !string.IsNullOrEmpty(Book.CurrentEpubCfi))
        {
            try {
                await BookService.UpdatePositionAsync(BookId, epubCfi: Book.CurrentEpubCfi, audioPosition: _currentTime, percentage: Book.PercentageCompleted);
            } catch { }
        }

        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
        if (_epubJsModule != null)
        {
            await _epubJsModule.DisposeAsync();
        }
    }

    public class SyncSegment
    {
        [JsonPropertyName("start")]
        public double Start { get; set; }
        
        [JsonPropertyName("end")]
        public double End { get; set; }
        
        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;
    }
}



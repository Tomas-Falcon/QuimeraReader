    private void OnProgressSliderInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out double newPct))
        {
            _isDraggingProgress = true;
            _displayPercentage = Math.Clamp(newPct, 0.0, 100.0);
            
            _sliderDebounceCts?.Cancel();
            _sliderDebounceCts = new System.Threading.CancellationTokenSource();
            var token = _sliderDebounceCts.Token;
            var targetPct = _displayPercentage;
            
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await Task.Delay(120, token);
                    if (!token.IsCancellationRequested && _epubJsModule != null)
                    {
                        await _epubJsModule.InvokeVoidAsync("goToPercentage", targetPct);
                    }
                }
                catch (TaskCanceledException) { }
            });
        }
    }

    private async Task OnProgressSliderChange(ChangeEventArgs e)
    {
        _sliderDebounceCts?.Cancel();
        _isDraggingProgress = false;
        
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out double finalPct))
        {
            _displayPercentage = Math.Clamp(finalPct, 0.0, 100.0);
            if (_epubJsModule != null)
            {
                await _epubJsModule.InvokeVoidAsync("goToPercentage", _displayPercentage);
            }
        }
    }

    private int _lastActiveIndex = -1;
    private double _lastSavedTime = -1;

    [JSInvokable]
    public async Task OnTimeUpdate(double time)
    {
        _currentTime = time;
        if (Book != null)
        {
            Book.CurrentAudioPosition = time;
            Book.CurrentAudioTrackNumber = _currentTrackNumber;
        }

        var currentIndex = _segments.FindIndex(s =>
            (s.TrackNumber <= 0 ? 1 : s.TrackNumber) == _currentTrackNumber &&
            time >= s.Start && time <= s.End);

        // Fallback si el SyncMap antiguo no tenía trackNumber distinto
        if (currentIndex == -1 && !_segments.Any(s => s.TrackNumber == _currentTrackNumber))
        {
            currentIndex = _segments.FindIndex(s => time >= s.Start && time <= s.End);
        }

        if (currentIndex != -1 && currentIndex != _lastActiveIndex)
        {
            _lastActiveIndex = currentIndex;
            var activeSegment = _segments[currentIndex];
            StateHasChanged();
            
            if (_epubJsModule != null)
            {
                var karaokeCfi = await _epubJsModule.InvokeAsync<string?>("highlightKaraokePhrase", activeSegment.Text, !_showAudiobookMode);
                // Si la frase no estaba en el capítulo actual del EPUB y el segmento conoce su capítulo, saltar automáticamente al nuevo capítulo
                if (string.IsNullOrEmpty(karaokeCfi) && !_showAudiobookMode && (activeSegment.SpineIndex.HasValue || !string.IsNullOrEmpty(activeSegment.ChapterHref)))
                {
                    karaokeCfi = await _epubJsModule.InvokeAsync<string?>(
                        "navigateToSegmentText",
                        activeSegment.Text,
                        GetApproximateAudioPercentage(time, _currentTrackNumber),
                        activeSegment.SpineIndex ?? -1,
                        activeSegment.ChapterHref ?? "");
                }

                if (!string.IsNullOrEmpty(karaokeCfi) && Book != null)
                {
                    Book.CurrentEpubCfi = karaokeCfi;
                    _pageMovedSinceAudioSync = false;
                }
            }
            if (_jsModule != null && (_showAudiobookMode || !Book!.HasEpub))
            {
                await _jsModule.InvokeVoidAsync("scrollToActiveSegment");
            }
        }

        // Guardar progreso cada 5 segundos incluyendo tanto audio como CFI y porcentaje calculado
        if (_lastSavedTime == -1 || Math.Abs(time - _lastSavedTime) > 5)
        {
            _lastSavedTime = time;
            double? pctToSave = Book?.PercentageCompleted;
            if ((!pctToSave.HasValue || !Book!.HasEpub) && _segments.Any())
            {
                var approx = GetApproximateAudioPercentage(time, _currentTrackNumber);
                if (approx >= 0) pctToSave = approx * 100.0;
            }
            _ = BookService.UpdatePositionAsync(
                BookId,
                epubCfi: Book?.CurrentEpubCfi,
                audioPosition: time,
                percentage: pctToSave,
                audioTrackNumber: _currentTrackNumber);
        }
    }

    [JSInvokable]
    public async Task OnAudioEnded()
    {
        if (Book?.AudioTracks != null && Book.AudioTracks.Count > 0)
        {
            var maxTrack = Book.AudioTracks.Max(t => t.TrackNumber);
            if (_currentTrackNumber < maxTrack)
            {
                await ChangeTrackAsync(_currentTrackNumber + 1);
            }
        }
    }

    [JSInvokable]
    public async Task OnPlayStateChanged(bool isPlaying)
    {
        _isPlaying = isPlaying;
        if (!_isPlaying)
        {
            if (_epubJsModule != null)
            {
                var pausedCfi = await _epubJsModule.InvokeAsync<string?>("convertKaraokeToHardMark");
                if (!string.IsNullOrEmpty(pausedCfi) && Book != null)
                {
                    Book.CurrentEpubCfi = pausedCfi;
                }
            }
            // Guardar inmediatamente la posición al pausar
            if (Book != null)
            {
                _ = BookService.UpdatePositionAsync(
                    BookId,
                    epubCfi: Book.CurrentEpubCfi,
                    audioPosition: _currentTime,
                    percentage: Book.PercentageCompleted,
                    audioTrackNumber: _currentTrackNumber);
            }
        }
        else
        {
            if (_epubJsModule != null)
            {
                await _epubJsModule.InvokeVoidAsync("clearAudioBookmark");
            }
            // Si el usuario estuvo pasando páginas en modo lectura y luego pulsa Play, ofrecer/sincronizar el audio a la página actual
            if (_pageMovedSinceAudioSync && Book?.HasEpub == true && !_showAudiobookMode && _segments.Any())
            {
                await SyncAudioToCurrentPageAsync(silentIfNotFound: true);
            }
        }
        StateHasChanged();
    }

    private async Task SeekToSegmentAsync(SyncSegment segment, double? overrideTime = null)
    {
        int targetTrack = segment.TrackNumber > 0 ? segment.TrackNumber : 1;
        if (targetTrack != _currentTrackNumber && Book?.AudioTracks != null && Book.AudioTracks.Any(t => t.TrackNumber == targetTrack))
        {
            _currentTrackNumber = targetTrack;
            if (Book != null) Book.CurrentAudioTrackNumber = targetTrack;
            StateHasChanged();
            await Task.Delay(80);
        }

        double time = overrideTime ?? segment.Start;
        _currentTime = time;
        _pageMovedSinceAudioSync = false;
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, time);
            await _jsModule.InvokeVoidAsync("playAudio", _audioElement);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Book != null && (!string.IsNullOrEmpty(Book.CurrentEpubCfi) || _currentTime > 0 || Book.PercentageCompleted.HasValue))
        {
            try
            {
                await BookService.UpdatePositionAsync(
                    BookId,
                    epubCfi: Book.CurrentEpubCfi,
                    audioPosition: Book.HasAudio ? _currentTime : null,
                    percentage: Book.PercentageCompleted,
                    audioTrackNumber: Book.HasAudio ? _currentTrackNumber : null);
                
                var syncWorker = ServiceProvider.GetService(typeof(QuimeraReader.Shared.Interfaces.IOfflineSyncWorker)) as QuimeraReader.Shared.Interfaces.IOfflineSyncWorker;
                if (syncWorker != null)
                {
                    _ = syncWorker.SyncNowAsync();
                }
            }
            catch { }
        }

        _sliderDebounceCts?.Cancel();
        _sliderDebounceCts?.Dispose();
        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            try { await _jsModule.DisposeAsync(); } catch { }
        }
        if (_epubJsModule != null)
        {
            try { await _epubJsModule.InvokeVoidAsync("destroyEpub"); } catch { }
            try { await _epubJsModule.DisposeAsync(); } catch { }
        }
    }

    public class SyncSegment
    {
        [JsonPropertyName("trackNumber")]
        public int TrackNumber { get; set; } = 1;

        [JsonPropertyName("spineIndex")]
        public int? SpineIndex { get; set; }

        [JsonPropertyName("chapterHref")]
        public string? ChapterHref { get; set; }

        [JsonPropertyName("start")]
        public double Start { get; set; }
        
        [JsonPropertyName("end")]
        public double End { get; set; }
        
        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;
    }

    private async Task SkipBackward()
    {
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("skipAudio", _audioElement, -15);
        }
    }

    private async Task SkipForward()
    {
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("skipAudio", _audioElement, 30);
        }
    }
}

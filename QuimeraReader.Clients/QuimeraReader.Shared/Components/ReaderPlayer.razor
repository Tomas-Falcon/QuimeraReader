@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IQuimeraApiClient ApiClient
@inject IJSRuntime JS
@implements IAsyncDisposable
@namespace QuimeraReader.Shared.Components

<div class="reader-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Preparando tu libro...</p>
        </div>
    }
    else if (Book != null)
    {
        <!-- Background Blur -->
        <div class="background-blur" style="background-image: url('@Book.CoverUrl');"></div>
        <div class="background-overlay"></div>

        <!-- Main Content -->
        <div class="reader-content">
            <!-- Header -->
            <div class="reader-header">
                <button class="btn-back" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Volver
                </button>
                <div class="header-titles">
                    <h2 class="reader-book-title">@Book.Title</h2>
                    <p class="reader-book-author">Leyendo ahora</p>
                </div>
                <div class="header-spacer"></div>
            </div>

            <!-- Text Area / EPUB Reader -->
            <div class="text-container" id="text-container">
                @if (Book.HasEpub)
                {
                    <div id="epub-viewer" style="width: 100%; height: 60vh; background: var(--bg-card); border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                        <!-- Epub.js will render the book here -->
                    </div>
                    <div class="epub-controls mt-3 d-flex justify-content-between align-items-center w-100">
                        <button class="btn btn-outline-light rounded-circle prev-btn" @onclick="PrevPage" style="width: 50px; height: 50px;" aria-label="Previous Page"><i class="bi bi-chevron-left"></i></button>
                        <span class="text-muted small">Modo Lectura</span>
                        <button class="btn btn-outline-light rounded-circle next-btn" @onclick="NextPage" style="width: 50px; height: 50px;" aria-label="Next Page"><i class="bi bi-chevron-right"></i></button>
                    </div>
                }
                else if (_segments != null && _segments.Any())
                {
                    <div class="sync-text">
                        @for (int i = 0; i < _segments.Count; i++)
                        {
                            var segment = _segments[i];
                            var index = i;
                            var isActive = _currentTime >= segment.Start && _currentTime <= segment.End;
                            <span class="segment @(isActive ? "active-segment" : "")" @onclick="() => SeekToSegmentAsync(segment.Start)">
                                @segment.Text 
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="no-sync-map text-center pt-5">
                        <img src="@Book.CoverUrl" class="fallback-cover mb-4" style="max-width: 200px; border-radius: 8px;" />
                        <h3>Modo Audiolibro Puro</h3>
                        <p class="text-muted">No se encontraron transcripciones o texto para este título.</p>
                    </div>
                }
            </div>

            <!-- Native Player (Styled container) -->
            <div class="player-controls">
                <audio @ref="_audioElement" src="@Book.AudioUrl" controls class="native-audio" />
            </div>
        </div>
    }
</div>



@code {
    [Parameter]
    public int BookId { get; set; }

    [Inject]
    public NavigationManager NavManager { get; set; } = default!;

    public Book? Book { get; set; }
    
    private void GoBack()
    {
        NavManager.NavigateTo($"/book/{BookId}");
    }
    
    private bool _isLoading = true;
    private ElementReference _audioElement;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<ReaderPlayer>? _dotNetRef;
    private double _currentTime = 0;
    private bool _isPlaying = false;
    private List<SyncSegment> _segments = new();

    protected override async Task OnInitializedAsync()
    {
        Book = await ApiClient.GetBookAsync(BookId);
        
        var syncMapJson = await ApiClient.GetSyncMapAsync(BookId);
        if (!string.IsNullOrEmpty(syncMapJson))
        {
            try
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                _segments = JsonSerializer.Deserialize<List<SyncSegment>>(syncMapJson, options) ?? new();
            }
            catch { /* Ignorar error de parseo por ahora */ }
        }

        _isLoading = false;
    }

    private bool _playerInitialized = false;
    private IJSObjectReference? _epubJsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_playerInitialized && Book != null && !_isLoading)
        {
            _playerInitialized = true;
            
            // Audio Player Initialization
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/playerInterop.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("initializePlayer", _audioElement, _dotNetRef);

            if (Book.CurrentAudioPosition.HasValue && Book.CurrentAudioPosition.Value > 0)
            {
                await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, Book.CurrentAudioPosition.Value);
            }

            // EPUB Reader Initialization
            if (Book.HasEpub)
            {
                _epubJsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/QuimeraReader.Shared/epubInterop.js");
                // Construct the absolute URL to the EPUB file via API
                var baseUrl = NavManager.BaseUri.TrimEnd('/');
                var epubApiUrl = $"{baseUrl}{Book.EpubUrl}";
                
                await _epubJsModule.InvokeVoidAsync("initializeEpub", "epub-viewer", epubApiUrl, _dotNetRef, Book.CurrentEpubCfi);
            }
        }
    }

    [JSInvokable]
    public void OnEpubLocationChanged(string cfi)
    {
        // Guardar el CFI (marcapáginas) de forma asíncrona (fuego y olvido)
        _ = ApiClient.UpdatePositionAsync(BookId, epubCfi: cfi);
    }

    private async Task NextPage()
    {
        if (_epubJsModule != null)
            await _epubJsModule.InvokeVoidAsync("nextEpubPage");
    }

    private async Task PrevPage()
    {
        if (_epubJsModule != null)
            await _epubJsModule.InvokeVoidAsync("prevEpubPage");
    }

    private int _lastActiveIndex = -1;
    private double _lastSavedTime = -1;

    [JSInvokable]
    public async Task OnTimeUpdate(double time)
    {
        _currentTime = time;
        
        // Guardar progreso cada 10 segundos
        if (_lastSavedTime == -1 || (time - _lastSavedTime) > 10)
        {
            _lastSavedTime = time;
            // Solo mandamos el audioPosition, dejamos el epubCfi intacto o null. 
            // Percentage se podría calcular si tuviéramos el total duration.
            _ = ApiClient.UpdatePositionAsync(BookId, audioPosition: time);
        }

        var currentIndex = _segments.FindIndex(s => time >= s.Start && time <= s.End);
        if (currentIndex != -1 && currentIndex != _lastActiveIndex)
        {
            _lastActiveIndex = currentIndex;
            StateHasChanged();
            
            if (_jsModule != null)
            {
                await _jsModule.InvokeVoidAsync("scrollToActiveSegment");
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnPlayStateChanged(bool isPlaying)
    {
        _isPlaying = isPlaying;
        StateHasChanged();
    }

    private async Task SeekToSegmentAsync(double time)
    {
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, time);
            await _jsModule.InvokeVoidAsync("playAudio", _audioElement);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
        if (_epubJsModule != null)
        {
            await _epubJsModule.DisposeAsync();
        }
    }

    public class SyncSegment
    {
        [JsonPropertyName("start")]
        public double Start { get; set; }
        
        [JsonPropertyName("end")]
        public double End { get; set; }
        
        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;
    }
}

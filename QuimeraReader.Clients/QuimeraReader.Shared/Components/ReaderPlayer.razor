        }
        StateHasChanged();
    }

    private async Task SetAudioBookmarkAsync(bool autoPlay = false)
    {
        _showAnnotationDialog = false;
        if (_epubJsModule != null)
        {
            await _epubJsModule.InvokeVoidAsync("clearTextSelection");
        }

        if (!string.IsNullOrEmpty(_selectedText) && _segments != null && _segments.Any())
        {
            var match = FindBestMatchingSegment(_selectedText, _displayPercentage);

            if (match != null)
            {
                int targetTrack = match.TrackNumber > 0 ? match.TrackNumber : 1;
                if (targetTrack != _currentTrackNumber && Book?.AudioTracks != null && Book.AudioTracks.Any(t => t.TrackNumber == targetTrack))
                {
                    _currentTrackNumber = targetTrack;
                    if (Book != null) Book.CurrentAudioTrackNumber = targetTrack;
                    StateHasChanged();
                    await Task.Delay(80);
                }

                var startOffset = Math.Max(0, match.Start - 1.5);
                _currentTime = startOffset;
                _lastActiveIndex = _segments.IndexOf(match);
                _pageMovedSinceAudioSync = false;

                if (_epubJsModule != null && !string.IsNullOrEmpty(_selectedCfi))
                {
                    await _epubJsModule.InvokeVoidAsync("setAudioBookmark", _selectedCfi);
                }

                await BookService.UpdatePositionAsync(BookId, epubCfi: _selectedCfi, audioPosition: startOffset, percentage: _displayPercentage, audioTrackNumber: _currentTrackNumber);

                if (autoPlay)
                {
                    await SeekToSegmentAsync(match, startOffset);
                    ToastService.ShowSuccess("Reproduciendo desde el fragmento seleccionado.");
                }
                else
                {
                    if (_jsModule != null)
                    {
                        await _jsModule.InvokeVoidAsync("seekAudio", _audioElement, startOffset);
                    }
                    ToastService.ShowSuccess("Marca de audiolibro establecida y guardada.");
                }
            }
            else
            {
                ToastService.ShowError("No se encontró el audio para este fragmento.");
            }
        }
    }


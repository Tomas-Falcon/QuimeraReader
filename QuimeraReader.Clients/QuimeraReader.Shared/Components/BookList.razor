@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IQuimeraApiClient ApiClient
@inject ToastService ToastService
@namespace QuimeraReader.Shared.Components

<div class="library-container">
    <div class="library-toolbar d-flex justify-content-between align-items-center mb-4">
        <div class="search-box" style="flex: 0 0 300px;">
            <input type="text" class="form-control" placeholder="Buscar libros, autores..." value="@_searchQuery" @oninput="OnSearchInput" />
        </div>
        <div class="filters d-flex gap-2 align-items-center">
            @if (_isUploading)
            {
                <span class="text-muted small"><i class="bi bi-arrow-repeat spin"></i> Subiendo...</span>
            }
            <label class="btn btn-primary m-0 d-flex align-items-center gap-2" style="cursor: pointer;">
                <i class="bi bi-cloud-arrow-up"></i> Subir EPUB
                <InputFile OnChange="HandleFileUpload" accept=".epub" class="d-none" />
            </label>
            <select class="form-select" style="width: auto;">
                <option>Añadidos recientemente</option>
                <option>Título (A-Z)</option>
                <option>Autor (A-Z)</option>
            </select>
        </div>
    </div>

    @{
        var continueReading = _books.Where(b => b.LastReadAt.HasValue).OrderByDescending(b => b.LastReadAt).Take(4).ToList();
        
        if (continueReading.Any())
        {
            <div class="mb-5 continue-reading-section">
                <h4 class="mb-3 d-flex align-items-center">
                    <span class="bi bi-clock-history me-2 text-primary"></span>
                    Seguir leyendo
                </h4>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                    @foreach (var book in continueReading)
                    {
                        <div class="col">
                            <BookCard Book="book" IsCompact="true" />
                        </div>
                    }
                </div>
            </div>
        }
    }

    @if (_books.Count == 0 && !_isLoading)
    {
        <div class="empty-state text-center py-5">
            @if (string.IsNullOrWhiteSpace(_searchQuery))
            {
                <i class="bi bi-bookshelf" style="font-size: 4rem; color: var(--text-muted);"></i>
                <h3 class="mt-3">Tu biblioteca está vacía</h3>
                <p class="text-muted">No se encontraron libros en la base de datos.</p>
                @if (!_isUploading)
                {
                    <label class="btn btn-outline-primary mt-3 px-4 py-2" style="border-radius: 20px;">
                        <i class="bi bi-cloud-arrow-up me-2"></i> Subir tu primer libro
                        <InputFile OnChange="HandleFileUpload" class="d-none" accept=".epub" />
                    </label>
                }
            }
            else
            {
                <i class="bi bi-search" style="font-size: 4rem; color: var(--text-muted);"></i>
                <h3 class="mt-3">Sin resultados</h3>
                <p class="text-muted">No se encontraron libros para "@_searchQuery".</p>
            }
        </div>
    }
    else
    {
        <div class="books-grid">
            @foreach (var book in _books)
            {
                <BookCard Book="book" />
            }
        </div>
        
        @if (_hasMore)
        {
            <div @ref="_loadMoreElement" class="load-more-trigger mt-4 text-center p-3">
                @if (_isLoading)
                {
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                }
            </div>
        }
    }
</div>

@implements IDisposable
@inject IJSRuntime JSRuntime

@code {
    [Parameter]
    public string? QueryParam { get; set; }

    private List<Book> _books = new();
    private IEnumerable<Book> _recommendations = Array.Empty<Book>();
    private ElementReference _loadMoreElement;
    private DotNetObjectReference<BookList>? _objRef;
    
    private int _currentPage = 1;
    private bool _isLoading = false;
    private bool _hasMore = true;
    private bool _isUploading = false;
    private CancellationTokenSource _cts = new();
    
    private string _searchQuery = string.Empty;
    private System.Timers.Timer? _debounceTimer;

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploading = true;
        StateHasChanged();

        try
        {
            await ApiClient.UploadEpubAsync(file.OpenReadStream(maxAllowedSize: 104857600), file.Name);
            ToastService.ShowSuccess($"¡{file.Name} subido correctamente!");
            
            _currentPage = 1;
            _hasMore = true;
            _books.Clear();
            await LoadBooksAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error al subir el libro: " + ex.Message);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);
        var fetchRecs = ApiClient.GetRecommendationsAsync();
        
        _debounceTimer = new System.Timers.Timer(500);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (sender, args) =>
        {
            _currentPage = 1;
            _hasMore = true;
            _books.Clear();
            await InvokeAsync(async () => {
                await LoadBooksAsync();
                StateHasChanged();
            });
        };
        
        _recommendations = await fetchRecs;
        _ = PollNewBooksAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryParam) && QueryParam != _searchQuery)
        {
            _searchQuery = QueryParam;
            _currentPage = 1;
            _hasMore = true;
            _books.Clear();
            await LoadBooksAsync();
        }
        else if (string.IsNullOrWhiteSpace(QueryParam) && _books.Count == 0 && !_isLoading)
        {
            // Initial load
            await LoadBooksAsync();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Start();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hasMore && _loadMoreElement.Id != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("infiniteScroll.initialize", _loadMoreElement, _objRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task LoadMoreRequested()
    {
        if (!_isLoading && _hasMore)
        {
            await LoadMoreAsync();
            StateHasChanged();
        }
    }

    private async Task PollNewBooksAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!string.IsNullOrWhiteSpace(_searchQuery)) continue;
                
                if (_books.Count > 0 && _currentPage > 1)
                {
                    // Solo check si hay nuevos libros en el backend
                    try
                    {
                        var result = await ApiClient.GetBooksAsync(1, 1);
                        if (result.Data.Length > 0 && result.Data[0].Id > _books[0].Id)
                        {
                            _currentPage = 1;
                            _hasMore = true;
                            _books.Clear();
                            await LoadBooksAsync();
                        }
                    }
                    catch { }
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadBooksAsync()
    {
        if (_isLoading || !_hasMore) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.GetBooksAsync(_currentPage, 20, _searchQuery);
            
            if (result.Data.Length > 0)
            {
                _books.AddRange(result.Data);
                _currentPage++;
                
                if (result.Data.Length < 20)
                {
                    _hasMore = false;
                }
            }
            else
            {
                _hasMore = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando libros: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        await LoadBooksAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _objRef?.Dispose();
    }
}

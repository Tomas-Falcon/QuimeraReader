@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@inject ToastService ToastService
@inject Radzen.DialogService _dialogService
@inject IJSRuntime JSRuntime
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@namespace QuimeraReader.Shared.Components

<div class="library-container">
    <div class="library-toolbar d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-2 gap-md-3 mb-3 mb-md-4">
        <div class="search-box w-100" style="max-width: 500px;">
            <RadzenTextBox Placeholder="Buscar libros, autores..." @bind-Value="@_searchQuery" @oninput="@(args => OnSearchInput(args.Value?.ToString() ?? string.Empty))" class="w-100" />
        </div>
        <div class="filters d-flex flex-wrap gap-2 align-items-center w-100">
            @if (_selectionMode)
            {
                <span class="text-primary fw-bold me-1 small">@_selectedBookIds.Count seleccionados</span>
                <RadzenDropDown TValue="string" Placeholder="Marcar como..." Data="@_bulkActions" ValueProperty="Value" TextProperty="Text" Change="OnBulkActionSelected" Style="width: 165px;" />
                <RadzenButton Text="Cancelar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                <RadzenButton Text="Borrar" Click="DeleteSelected" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Icon="delete" Disabled="@(_selectedBookIds.Count == 0)" />
            }
            else
            {
                <RadzenButton Text="Seleccionar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" Icon="check_box" />
                <div class="d-none d-sm-flex align-items-center gap-2">
                    @if (_isUploading)
                    {
                        <span class="text-muted small me-2"><RadzenIcon Icon="refresh" class="rz-spin" /> Subiendo...</span>
                    }
                    <label class="rz-button rz-button-sm rz-variant-filled rz-primary rz-shade-default m-0 d-flex align-items-center gap-1" style="cursor: pointer;">
                        <RadzenIcon Icon="cloud_upload" /> Subir EPUB
                        <InputFile @key='"fileUploadInput"' OnChange="HandleFileUpload" accept=".epub,.mp3,.m4b,.m4a,.wav" class="d-none" multiple />
                    </label>
                </div>
                <RadzenDropDown Multiple="true"
                                Placeholder="Categorías"
                                Data="@_availableCategories"
                                TextProperty="Name"
                                ValueProperty="Id"
                                @bind-Value="_selectedCategories"
                                Change="@OnCategoryChanged"
                                Style="min-width: 150px; flex: 1; max-width: 260px;"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                <RadzenDropDown TValue="string"
                                Data="@_sortOptions"
                                @bind-Value="_selectedSort"
                                Change="@OnSortChanged"
                                Style="min-width: 160px;" />
            }
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(_searchQuery))
    {
        @if (_readingBooks != null && _readingBooks.Any())
        {
            <h4 class="rz-color-primary mt-2 mb-2 fw-bold">@TranslationService["Status_Reading"]</h4>
            <div class="netflix-row mb-4">
                @foreach (var book in _readingBooks)
                {
                    <div class="netflix-item"><BookCard Book="book" /></div>
                }
                @if (_hasMoreReading)
                {
                    <div @ref="_loadMoreReadingElement" class="netflix-item d-flex align-items-center justify-content-center" style="width: 100px;">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    </div>
                }
            </div>
        }

        @if (_nextToReadBooks != null && _nextToReadBooks.Any())
        {
            <h4 class="rz-color-primary mt-2 mb-2 fw-bold">@TranslationService["Status_NextToRead"]</h4>
            <div class="netflix-row mb-4">
                @foreach (var book in _nextToReadBooks)
                {
                    <div class="netflix-item"><BookCard Book="book" /></div>
                }
                @if (_hasMoreNextToRead)
                {
                    <div @ref="_loadMoreNextToReadElement" class="netflix-item d-flex align-items-center justify-content-center" style="width: 100px;">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    </div>
                }
            </div>
        }

        @if (_readBooks != null && _readBooks.Any())
        {
            <h4 class="rz-color-primary mt-2 mb-2 fw-bold">@TranslationService["Status_Read"]</h4>
            <div class="netflix-row mb-4">
                @foreach (var book in _readBooks)
                {
                    <div class="netflix-item"><BookCard Book="book" /></div>
                }
                @if (_hasMoreRead)
                {
                    <div @ref="_loadMoreReadElement" class="netflix-item d-flex align-items-center justify-content-center" style="width: 100px;">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    </div>
                }
            </div>
        }

        @if (_recommendations != null && _recommendations.Any())
        {
            <h4 class="rz-color-primary mt-2 mb-2 fw-bold">@TranslationService["Status_Recommended"]</h4>
            <div class="netflix-row mb-4">
                @foreach (var book in _recommendations)
                {
                    <div class="netflix-item"><BookCard Book="book" /></div>
                }
            </div>
        }
    }

    <h4 class="rz-color-primary mt-2 mb-3 fw-bold">@(string.IsNullOrWhiteSpace(_searchQuery) ? TranslationService["Library_AllBooks"] : TranslationService["Library_SearchResults"])</h4>
    
    <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize ItemsProvider="ProvideBookChunks" Context="chunk" ItemSize="330" OverscanCount="3" @ref="_virtualizeComponent">
        <ItemContent>
            <div class="row m-0 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 row-cols-xl-6 g-2 g-md-4 mb-3 mb-md-4">
                @foreach (var book in chunk)
                {
                    <div class="col" @key="book.Id">
                        <BookCard Book="book" SelectionMode="_selectionMode" IsSelected="_selectedBookIds.Contains(book.Id)" IsSelectedChanged="@(isSelected => OnBookSelectionChanged(book.Id, isSelected))" />
                    </div>
                }
            </div>
        </ItemContent>
        <Placeholder>
            <div class="row m-0 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 row-cols-xl-6 g-2 g-md-4 mb-3 mb-md-4">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="col">
                        <div style="height: 280px; background: var(--bg-card); border-radius: 8px; opacity: 0.5;"></div>
                    </div>
                }
            </div>
        </Placeholder>
    </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
</div>

<style>
    .library-container {
        max-width: 100%;
        overflow-x: hidden;
        padding: 4px 0 24px 0 !important;
        min-height: auto !important;
    }
    .netflix-row {
        width: 100%;
        box-sizing: border-box;
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 0.85rem;
        padding-bottom: 0.75rem;
        padding-top: 0.25rem;
    }
    .netflix-item {
        flex: 0 0 auto;
        scroll-snap-align: start;
        width: 150px;
    }
    @@media (min-width: 768px) {
        .netflix-row {
            gap: 1.35rem;
        }
        .netflix-item {
            width: 200px;
        }
    }
    .netflix-row::-webkit-scrollbar {
        height: 6px;
    }
    .netflix-row::-webkit-scrollbar-thumb {
        background-color: var(--rz-primary-light);
        border-radius: 4px;
    }
    .netflix-row::-webkit-scrollbar-track {
        background-color: transparent;
    }
</style>

@code {
    [Parameter]
    public string? QueryParam { get; set; }

    private Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize<List<Book>>? _virtualizeComponent;

    private async ValueTask<Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderResult<List<Book>>> ProvideBookChunks(Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderRequest request)
    {
        try 
        {
            // Usar 12 como tamaño de bloque (múltiplo común de 2, 3, 4 y 6 columnas) para no dejar nunca huecos vacíos en móvil ni tablet
            int chunkSize = 12;
            int skip = request.StartIndex * chunkSize;
            int take = Math.Min(request.Count * chunkSize, 48);

            var result = await BookService.GetBooksAsync(1, 50, _searchQuery, _selectedCategories?.ToArray(), null, skip, take);
            var booksData = result.Data ?? Array.Empty<Book>();

            if (_selectedSort == "Título (A-Z)")
            {
                booksData = booksData.OrderBy(b => b.Title).ToArray();
            }
            else if (_selectedSort == "Autor (A-Z)")
            {
                booksData = booksData.OrderBy(b => b.Authors?.FirstOrDefault() ?? "").ThenBy(b => b.Title).ToArray();
            }

            var totalChunks = (int)Math.Ceiling((double)result.Total / chunkSize);

            var chunks = new List<List<Book>>();
            for (int i = 0; i < booksData.Length; i += chunkSize)
            {
                chunks.Add(booksData.Skip(i).Take(chunkSize).ToList());
            }

            return new Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderResult<List<Book>>(chunks, totalChunks);
        }
        catch
        {
            return new Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderResult<List<Book>>(new List<List<Book>>(), 0);
        }
    }

    private List<Book> _readingBooks = new();
    private int _readingPage = 1;
    private bool _hasMoreReading = false;
    private bool _isLoadingReading = false;
    private ElementReference _loadMoreReadingElement;
    private bool _readingScrollInitialized = false;

    private List<Book> _nextToReadBooks = new();
    private int _nextToReadPage = 1;
    private bool _hasMoreNextToRead = false;
    private bool _isLoadingNextToRead = false;
    private ElementReference _loadMoreNextToReadElement;
    private bool _nextToReadScrollInitialized = false;

    private List<Book> _readBooks = new();
    private int _readPage = 1;
    private bool _hasMoreRead = false;
    private bool _isLoadingRead = false;
    private ElementReference _loadMoreReadElement;
    private bool _readScrollInitialized = false;
    private IEnumerable<Book> _recommendations = Array.Empty<Book>();
    private DotNetObjectReference<BookList>? _objRef;
    
    private bool _isUploading = false;
    private CancellationTokenSource _cts = new();
    
    private string _searchQuery = string.Empty;
    private System.Timers.Timer? _debounceTimer;

    private bool _selectionMode = false;
    private HashSet<int> _selectedBookIds = new();

    private List<string> _sortOptions = new List<string> { "Añadidos recientemente", "Título (A-Z)", "Autor (A-Z)" };
    private string _selectedSort = "Añadidos recientemente";

    private List<dynamic> _bulkActions = new List<dynamic>
    {
        new { Text = "Marcar Leído", Value = "Read" },
        new { Text = "Marcar No Leído", Value = "Unread" },
        new { Text = "Próximo a leer", Value = "NextToRead" }
    };

    private async Task OnBulkActionSelected(object value)
    {
        if (value == null || !_selectedBookIds.Any()) return;
        string status = value.ToString()!;
        try
        {
            await BookService.BulkUpdateStatusAsync(_selectedBookIds.ToList(), status);
            ToastService.ShowSuccess("Libros actualizados");
            ToggleSelectionMode();
            if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error al actualizar: " + ex.Message);
        }
    }

    private void ToggleSelectionMode()
    {
        _selectionMode = !_selectionMode;
        if (!_selectionMode)
        {
            _selectedBookIds.Clear();
        }
    }

    private void OnBookSelectionChanged(int bookId, bool isSelected)
    {
        if (isSelected)
            _selectedBookIds.Add(bookId);
        else
            _selectedBookIds.Remove(bookId);
    }

    private async Task DeleteSelected()
    {
        if (_selectedBookIds.Count == 0) return;
        
        var result = await _dialogService.Confirm(
            $"ATENCIÓN: Vas a borrar {_selectedBookIds.Count} libros. Esta acción ELIMINARÁ PERMANENTEMENTE los archivos físicos del servidor (EPUBs, audios, portadas).", 
            "Eliminar Libros del Servidor", 
            new ConfirmOptions() { OkButtonText = "Sí, ELIMINAR", CancelButtonText = "Cancelar" });

        if (result == true)
        {
            try
            {
                await BookService.DeleteBooksAsync(_selectedBookIds.ToArray());
                _selectedBookIds.Clear();
                _selectionMode = false;
                ToastService.ShowSuccess("Libros borrados correctamente");
                if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync(); 
                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error al borrar libros: {ex.Message}");
            }
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(maximumFileCount: 50);
        if (!files.Any()) return;

        _isUploading = true;
        StateHasChanged();

        try
        {
            int successCount = 0;
            foreach (var file in files)
            {
                if (_cts.Token.IsCancellationRequested)
                {
                    ToastService.ShowInfo("Subida cancelada por cambio de página.");
                    break;
                }
                
                try
                {
                    await BookService.UploadEpubAsync(file.OpenReadStream(maxAllowedSize: 1073741824), file.Name);
                    successCount++;
                }
                catch (Exception fileEx)
                {
                    ToastService.ShowError($"Error subiendo '{file.Name}': {fileEx.Message}");
                }
            }
            
            if (successCount > 0)
            {
                ToastService.ShowSuccess($"{successCount} libro(s) subido(s) correctamente!");
                if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error general: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<QuimeraReader.Shared.Models.Category> _availableCategories = Array.Empty<QuimeraReader.Shared.Models.Category>();
    private IEnumerable<int> _selectedCategories = new List<int>();
    private bool _isInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        if (_isInitialized) return;
        _objRef = DotNetObjectReference.Create(this);

        // 1. Pintar de forma instantánea desde la caché en memoria si venimos de vuelta desde otra pantalla
        var cachedCats = BookService.GetCachedCategories();
        if (cachedCats != null) _availableCategories = cachedCats;

        var cachedRecs = BookService.GetCachedRecommendations();
        if (cachedRecs != null) _recommendations = cachedRecs;

        var cachedReading = BookService.GetCachedStatusBooks("Reading");
        if (cachedReading != null)
        {
            _readingBooks = cachedReading.ToList();
            _hasMoreReading = _readingBooks.Count >= 20;
        }

        var cachedNext = BookService.GetCachedStatusBooks("NextToRead");
        if (cachedNext != null)
        {
            _nextToReadBooks = cachedNext.ToList();
            _hasMoreNextToRead = _nextToReadBooks.Count >= 20;
        }

        var cachedRead = BookService.GetCachedStatusBooks("Read");
        if (cachedRead != null)
        {
            _readBooks = cachedRead.ToList();
            _hasMoreRead = _readBooks.Count >= 20;
        }

        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (sender, args) =>
        {
            await InvokeAsync(async () => {
                if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync();
                StateHasChanged();
            });
        };

        _isInitialized = true;

        // 2. Cargar/refrescar todas las filas y categorías en paralelo sin bloquear el renderizado inicial ni Virtualize
        _ = LoadSecondarySectionsAsync();
        await Task.CompletedTask;
    }

    private async Task LoadSecondarySectionsAsync()
    {
        try
        {
            var catsTask = BookService.GetCategoriesAsync();
            var recsTask = BookService.GetRecommendationsAsync();
            var readingTask = BookService.GetBooksAsync(1, 20, "", readingStatus: "Reading");
            var nextToReadTask = BookService.GetBooksAsync(1, 20, "", readingStatus: "NextToRead");
            var readTask = BookService.GetBooksAsync(1, 20, "", readingStatus: "Read");

            await Task.WhenAll(catsTask, recsTask, readingTask, nextToReadTask, readTask);

            _availableCategories = catsTask.Result ?? Array.Empty<Category>();
            _recommendations = recsTask.Result ?? new List<Book>();

            _readingBooks = readingTask.Result?.Data?.ToList() ?? new List<Book>();
            _hasMoreReading = _readingBooks.Count >= 20;

            _nextToReadBooks = nextToReadTask.Result?.Data?.ToList() ?? new List<Book>();
            _hasMoreNextToRead = _nextToReadBooks.Count >= 20;

            _readBooks = readTask.Result?.Data?.ToList() ?? new List<Book>();
            _hasMoreRead = _readBooks.Count >= 20;

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryParam) && QueryParam != _searchQuery)
        {
            _searchQuery = QueryParam;
            if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync();
        }
    }

    private async Task OnCategoryChanged(object value)
    {
        if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync();
        StateHasChanged();
    }

    private async Task OnSortChanged(object value)
    {
        if (_virtualizeComponent != null) await _virtualizeComponent.RefreshDataAsync();
        StateHasChanged();
    }

    private void OnSearchInput(string value)
    {
        _searchQuery = value ?? string.Empty;
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Start();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_hasMoreReading && _loadMoreReadingElement.Id != null && !_readingScrollInitialized)
            {
                await JSRuntime.InvokeVoidAsync("infiniteScroll.initialize", _loadMoreReadingElement, _objRef, "LoadMoreReadingRequested");
                _readingScrollInitialized = true;
            }
            if (_hasMoreNextToRead && _loadMoreNextToReadElement.Id != null && !_nextToReadScrollInitialized)
            {
                await JSRuntime.InvokeVoidAsync("infiniteScroll.initialize", _loadMoreNextToReadElement, _objRef, "LoadMoreNextToReadRequested");
                _nextToReadScrollInitialized = true;
            }
            if (_hasMoreRead && _loadMoreReadElement.Id != null && !_readScrollInitialized)
            {
                await JSRuntime.InvokeVoidAsync("infiniteScroll.initialize", _loadMoreReadElement, _objRef, "LoadMoreReadRequested");
                _readScrollInitialized = true;
            }
        }
        catch { }
    }

    [JSInvokable]
    public async Task LoadMoreReadingRequested()
    {
        if (_isLoadingReading || !_hasMoreReading) return;
        _isLoadingReading = true; StateHasChanged();
        try
        {
            _readingPage++;
            var result = await BookService.GetBooksAsync(_readingPage, 20, "", readingStatus: "Reading");
            if (result.Data.Length > 0) _readingBooks.AddRange(result.Data);
            _hasMoreReading = result.Data.Length >= 20;
            _readingScrollInitialized = false;
        }
        catch { }
        finally { _isLoadingReading = false; StateHasChanged(); }
    }

    [JSInvokable]
    public async Task LoadMoreNextToReadRequested()
    {
        if (_isLoadingNextToRead || !_hasMoreNextToRead) return;
        _isLoadingNextToRead = true; StateHasChanged();
        try
        {
            _nextToReadPage++;
            var result = await BookService.GetBooksAsync(_nextToReadPage, 20, "", readingStatus: "NextToRead");
            if (result.Data.Length > 0) _nextToReadBooks.AddRange(result.Data);
            _hasMoreNextToRead = result.Data.Length >= 20;
            _nextToReadScrollInitialized = false;
        }
        catch { }
        finally { _isLoadingNextToRead = false; StateHasChanged(); }
    }

    [JSInvokable]
    public async Task LoadMoreReadRequested()
    {
        if (_isLoadingRead || !_hasMoreRead) return;
        _isLoadingRead = true; StateHasChanged();
        try
        {
            _readPage++;
            var result = await BookService.GetBooksAsync(_readPage, 20, "", readingStatus: "Read");
            if (result.Data.Length > 0) _readBooks.AddRange(result.Data);
            _hasMoreRead = result.Data.Length >= 20;
            _readScrollInitialized = false;
        }
        catch { }
        finally { _isLoadingRead = false; StateHasChanged(); }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
        try { await JSRuntime.InvokeVoidAsync("infiniteScroll.cleanup"); } catch { }
        _objRef?.Dispose();
    }
}

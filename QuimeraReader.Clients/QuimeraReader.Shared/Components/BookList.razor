@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IQuimeraApiClient ApiClient
@namespace QuimeraReader.Shared.Components

<div class="library-container">
    @if (_isLoading && _books.Count == 0)
    {
        <div class="loading-state">
            <p>Cargando biblioteca...</p>
        </div>
    }
    else if (_books.Count == 0)
    {
        <div class="empty-state">
            <p>No se encontraron libros.</p>
        </div>
    }
    else
    {
        <div class="books-grid">
            @foreach (var book in _books)
            {
                <BookCard Book="book" />
            }
        </div>
        
        @if (_hasMore)
        {
            <div class="load-more">
                <button class="btn-load" @onclick="LoadMoreAsync" disabled="@_isLoading">
                    @(_isLoading ? "Cargando..." : "Cargar más")
                </button>
            </div>
        }
    }
</div>



@implements IDisposable

@code {
    private List<Book> _books = new();
    private int _currentPage = 1;
    private bool _isLoading = false;
    private bool _hasMore = true;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
        _ = PollNewBooksAsync();
    }

    private async Task PollNewBooksAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (_isLoading || _books.Count == 0) continue;
                
                try
                {
                    var result = await ApiClient.GetBooksAsync(1, 1);
                    if (result.Data.Length > 0 && result.Data[0].Id > _books[0].Id)
                    {
                        _currentPage = 1;
                        _hasMore = true;
                        _books.Clear();
                        await LoadBooksAsync();
                    }
                }
                catch { }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadBooksAsync()
    {
        if (_isLoading || !_hasMore) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.GetBooksAsync(_currentPage, 20);
            
            if (result.Data.Length > 0)
            {
                _books.AddRange(result.Data);
                _currentPage++;
                
                if (result.Data.Length < 20)
                {
                    _hasMore = false;
                }
            }
            else
            {
                _hasMore = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando libros: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        await LoadBooksAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@using Radzen
@using Radzen.Blazor
@implements IDisposable
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@namespace QuimeraReader.Shared.Components

<div class="library-container">
    <div class="library-toolbar d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
        <div class="search-box w-100" style="max-width: 500px;">
            <RadzenTextBox Placeholder="Buscar libros, autores..." Value="@_searchQuery" Change="OnSearchInput" class="w-100" />
        </div>
        <div class="filters d-flex flex-wrap gap-2 align-items-center w-100">
            @if (_selectionMode)
            {
                                <span class="text-primary fw-bold me-2">@_selectedBookIds.Count seleccionados</span>
                <RadzenDropDown TValue="string" Placeholder="Marcar como..." Data="@_bulkActions" ValueProperty="Value" TextProperty="Text" Change="OnBulkActionSelected" Style="width: 180px;" />
                <RadzenButton Text="Cancelar Selección" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                <RadzenButton Text="Borrar" Click="DeleteSelected" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Icon="delete" Disabled="@(_selectedBookIds.Count == 0)" />
            }
            else
            {
                <RadzenButton Text="Seleccionar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Icon="check_box" />
                @if (_isUploading)
                {
                    <span class="text-muted small"><RadzenIcon Icon="refresh" class="rz-spin" /> Subiendo...</span>
                }
                <label class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default m-0 d-flex align-items-center gap-2" style="cursor: pointer;">
                    <RadzenIcon Icon="cloud_upload" /> Subir EPUB
                    <InputFile OnChange="HandleFileUpload" accept=".epub" class="d-none" multiple />
                </label>
                                <RadzenDropDown Multiple="true" Placeholder="Categorías" Data="@_availableCategories" TextProperty="Name" ValueProperty="Id" @bind-Value="_selectedCategories"  Style="min-width: 200px; max-width: 100%;" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                <RadzenDropDown TValue="string" Data="@_sortOptions" @bind-Value="_selectedSort" Style="width: auto;" />
            }
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(_searchQuery))
    {
        @if (_readingBooks != null && _readingBooks.Any())
        {
            <h3 class="rz-color-primary rz-mt-4 mb-3">@TranslationService["Status_Reading"]</h3>
            <div class="netflix-row mb-5">
                @foreach (var book in _readingBooks)
                {
                    <div class="col"><BookCard Book="book" /></div>
                }
            </div>
        }

                @if (_nextToReadBooks != null && _nextToReadBooks.Any())
        {
            <h3 class="rz-color-primary rz-mt-4 mb-3">@TranslationService["Status_NextToRead"]</h3>
            <div class="netflix-row mb-5">
                @foreach (var book in _nextToReadBooks)
                {
                    <div class="col"><BookCard Book="book" /></div>
                }
            </div>
        }
        @if (_recommendations != null && _recommendations.Any())
        {
            <h3 class="rz-color-primary rz-mt-4 mb-3">@TranslationService["Status_Recommended"]</h3>
            <div class="netflix-row mb-5">
                @foreach (var book in _recommendations)
                {
                    <div class="col"><BookCard Book="book" /></div>
                }
            </div>
        }
    }

    <h3 class="rz-color-primary rz-mt-4 mb-3">@(string.IsNullOrWhiteSpace(_searchQuery) ? TranslationService["Library_AllBooks"] : TranslationService["Library_SearchResults"])</h3>
    
    @if (_books.Count == 0 && !_isLoading)
    {
        <div class="text-center p-5">
            <RadzenIcon Icon="library_books" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <p class="text-muted mt-2">No hay libros en la biblioteca.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var book in _books)
            {
                <div class="col"><BookCard Book="book" SelectionMode="_selectionMode" IsSelected="_selectedBookIds.Contains(book.Id)" IsSelectedChanged="@(isSelected => OnBookSelectionChanged(book.Id, isSelected))" /></div>
            }
        </div>
        
        @if (_hasMore)
        {
            <div @ref="_loadMoreElement" class="load-more-trigger mt-4 text-center p-3">
                @if (_isLoading)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                }
            </div>
        }
    }
</div>

<style>
    .netflix-row {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 1.5rem;
        padding-bottom: 1rem;
        padding-top: 0.5rem;
    }
    .netflix-row > * {
        flex: 0 0 auto;
        scroll-snap-align: start;
        width: 220px;
    }
    .netflix-row::-webkit-scrollbar {
        height: 8px;
    }
    .netflix-row::-webkit-scrollbar-thumb {
        background-color: var(--rz-primary-light);
        border-radius: 4px;
    }
    .netflix-row::-webkit-scrollbar-track {
        background-color: transparent;
    }
</style>

@code {
    [Parameter]
    public string? QueryParam { get; set; }

    private List<Book> _books = new();
    private IEnumerable<Book> _recommendations = Array.Empty<Book>();
    private IEnumerable<Book> _readingBooks = Array.Empty<Book>();
    private ElementReference _loadMoreElement;
    private DotNetObjectReference<BookList>? _objRef;
    
    private int _currentPage = 1;
    private bool _isLoading = false;
    private bool _hasMore = true;
    private bool _isUploading = false;
    private CancellationTokenSource _cts = new();
    
    private string _searchQuery = string.Empty;
    private System.Timers.Timer? _debounceTimer;

    private bool _selectionMode = false;
    private HashSet<int> _selectedBookIds = new();

    private List<string> _sortOptions = new List<string> { "Añadidos recientemente", "Título (A-Z)", "Autor (A-Z)" };
    private string _selectedSort = "Añadidos recientemente";

        private List<dynamic> _bulkActions = new List<dynamic>
    {
        new { Text = "Marcar Leído", Value = "Read" },
        new { Text = "Marcar No Leído", Value = "Unread" },
        new { Text = "Próximo a leer", Value = "NextToRead" }
    };

    private async Task OnBulkActionSelected(object value)
    {
        if (value == null || !_selectedBookIds.Any()) return;
        string status = value.ToString()!;
        try
        {
            await BookService.BulkUpdateStatusAsync(_selectedBookIds.ToList(), status);
            ToastService.ShowSuccess("Libros actualizados");
            ToggleSelectionMode();
            await LoadBooksAsync(); // Reload
        }
        catch(Exception ex)
        {
            ToastService.ShowError("Error al actualizar: " + ex.Message);
        }
    }

    private void ToggleSelectionMode()
    {
        _selectionMode = !_selectionMode;
        if (!_selectionMode)
        {
            _selectedBookIds.Clear();
        }
    }

    private void OnBookSelectionChanged(int bookId, bool isSelected)
    {
        if (isSelected)
            _selectedBookIds.Add(bookId);
        else
            _selectedBookIds.Remove(bookId);
    }

    private async Task DeleteSelected()
    {
        if (_selectedBookIds.Count == 0) return;
        
        foreach (var id in _selectedBookIds.ToList())
        {
            try
            {
                await BookService.DeleteEpubAsync(id);
                _books.RemoveAll(b => b.Id == id);
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error al borrar libro {id}: {ex.Message}");
            }
        }
        
        _selectedBookIds.Clear();
        _selectionMode = false;
        ToastService.ShowSuccess("Libros borrados correctamente");
        StateHasChanged();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(maximumFileCount: 50);
        if (!files.Any()) return;

        _isUploading = true;
        StateHasChanged();

        try
        {
            int successCount = 0;
            foreach (var file in files)
            {
                try
                {
                    await BookService.UploadEpubAsync(file.OpenReadStream(maxAllowedSize: 104857600), file.Name);
                    successCount++;
                }
                catch (Exception fileEx)
                {
                    ToastService.ShowError($"Error subiendo '{file.Name}': {fileEx.Message}");
                }
            }
            
            if (successCount > 0)
            {
                ToastService.ShowSuccess($"{successCount} libro(s) subido(s) correctamente!");
                _currentPage = 1;
                _hasMore = true;
                _books.Clear();
                await LoadBooksAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error general: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }
    private IEnumerable<QuimeraReader.Shared.Models.Category> _availableCategories = Array.Empty<QuimeraReader.Shared.Models.Category>();
    private IEnumerable<int> _selectedCategories = new List<int>();
    private IEnumerable<QuimeraReader.Shared.Models.Book> _nextToReadBooks = Array.Empty<QuimeraReader.Shared.Models.Book>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _availableCategories = await BookService.GetCategoriesAsync();
        }
        catch { }
        _objRef = DotNetObjectReference.Create(this);
        var fetchRecs = BookService.GetRecommendationsAsync();
        
        _debounceTimer = new System.Timers.Timer(500);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (sender, args) =>
        {
            _currentPage = 1;
            _hasMore = true;
            _books.Clear();
            await InvokeAsync(async () => {
                await LoadBooksAsync();
                StateHasChanged();
            });
        };
        
        _recommendations = await fetchRecs;
        
        try
        {
            var initialBooks = await BookService.GetBooksAsync(1, 100, "");
            _readingBooks = initialBooks.Data.Where(b => b.PercentageCompleted > 0 && b.PercentageCompleted < 100).OrderByDescending(b => b.LastReadAt).Take(10).ToList();
        }
        catch { }

        _ = PollNewBooksAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryParam) && QueryParam != _searchQuery)
        {
            _searchQuery = QueryParam;
            _currentPage = 1;
            _hasMore = true;
            _books.Clear();
            await LoadBooksAsync();
        }
        else if (string.IsNullOrWhiteSpace(QueryParam) && _books.Count == 0 && !_isLoading)
        {
            await LoadBooksAsync();
        }
    }

        private async Task OnCategoryChanged(object value)
    {
        _currentPage = 1;
        await LoadBooksAsync();
    }

    private void OnSearchInput(string value)
    {
        _searchQuery = value ?? string.Empty;
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Start();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hasMore && _loadMoreElement.Id != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("infiniteScroll.initialize", _loadMoreElement, _objRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task LoadMoreRequested()
    {
        if (!_isLoading && _hasMore)
        {
            await LoadMoreAsync();
            StateHasChanged();
        }
    }

    private async Task PollNewBooksAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (!string.IsNullOrWhiteSpace(_searchQuery)) continue;
                
                if (_books.Count > 0 && _currentPage > 1)
                {
                    try
                    {
                        var result = await BookService.GetBooksAsync(1, 1);
                        if (result.Data.Length > 0 && result.Data[0].Id > _books[0].Id)
                        {
                            _currentPage = 1;
                            _hasMore = true;
                            _books.Clear();
                            await LoadBooksAsync();
                        }
                    }
                    catch { }
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadBooksAsync()
    {
        if (_isLoading || !_hasMore) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await BookService.GetBooksAsync(_currentPage, 20, _searchQuery);
            
            if (result.Data.Length > 0)
            {
                _books.AddRange(result.Data);
                _currentPage++;
                
                if (result.Data.Length < 20)
                {
                    _hasMore = false;
                }
            }
            else
            {
                _hasMore = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando libros: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        await LoadBooksAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _objRef?.Dispose();
    }
}
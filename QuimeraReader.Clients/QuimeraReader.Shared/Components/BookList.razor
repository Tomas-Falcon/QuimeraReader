@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IQuimeraApiClient ApiClient
@inject ToastService ToastService
@namespace QuimeraReader.Shared.Components

<div class="library-container">
    <div class="library-toolbar d-flex justify-content-between align-items-center mb-4">
        <div class="search-box" style="flex: 0 0 300px;">
            <input type="text" class="form-control" placeholder="Buscar libros, autores..." @bind="_searchQuery" @bind:event="oninput" />
        </div>
        <div class="filters d-flex gap-2 align-items-center">
            @if (_isUploading)
            {
                <span class="text-muted small"><i class="bi bi-arrow-repeat spin"></i> Subiendo...</span>
            }
            <label class="btn btn-primary m-0 d-flex align-items-center gap-2" style="cursor: pointer;">
                <i class="bi bi-cloud-arrow-up"></i> Subir EPUB
                <InputFile OnChange="HandleFileUpload" accept=".epub" class="d-none" />
            </label>
            <select class="form-select" style="width: auto;">
                <option>Añadidos recientemente</option>
                <option>Título (A-Z)</option>
                <option>Autor (A-Z)</option>
            </select>
        </div>
    </div>

    @if (_books.Count > 0 && string.IsNullOrWhiteSpace(_searchQuery))
    {
        var continueReading = _books.Where(b => b.LastReadAt.HasValue).OrderByDescending(b => b.LastReadAt).Take(4).ToList();
        
        if (continueReading.Any())
        {
            <div class="continue-reading mb-5">
                <h4 class="mb-3">Seguir leyendo</h4>
                <div class="books-grid">
                    @foreach (var book in continueReading)
                    {
                        <BookCard Book="book" />
                    }
                </div>
            </div>
        }

        if (_recommendations != null && _recommendations.Any())
        {
            <div class="recommendations mb-5">
                <h4 class="mb-3">Recomendados para ti</h4>
                <div class="books-grid">
                    @foreach (var book in _recommendations)
                    {
                        <BookCard Book="book" />
                    }
                </div>
            </div>
        }

        <h4 class="mb-3">Agregados recientemente</h4>
    }

    @if (_isLoading && _books.Count == 0)
    {
        <div class="loading-state text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3">Cargando biblioteca...</p>
        </div>
    }
    else if (_books.Count == 0 && string.IsNullOrWhiteSpace(_searchQuery))
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-bookshelf" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h3 class="mt-3">Tu biblioteca está vacía</h3>
            <p class="text-muted">No se encontraron libros en la base de datos.</p>
            <div class="d-flex justify-content-center gap-3 mt-4">
                <label class="btn btn-primary d-flex align-items-center gap-2" style="cursor: pointer;">
                    <i class="bi bi-cloud-arrow-up"></i> Subir EPUB
                    <InputFile OnChange="HandleFileUpload" accept=".epub" class="d-none" />
                </label>
                <a href="settings" class="btn btn-outline-secondary"><i class="bi bi-gear"></i> Ajustes de Escáner</a>
            </div>
            @if (_isUploading)
            {
                <p class="text-muted small mt-3"><i class="bi bi-arrow-repeat spin"></i> Subiendo archivo...</p>
            }
        </div>
    }
    else if (_books.Count == 0 && !string.IsNullOrWhiteSpace(_searchQuery))
    {
        <div class="empty-state text-center py-5">
            <p>No se encontraron resultados para "@_searchQuery".</p>
        </div>
    }
    else
    {
        var filteredBooks = string.IsNullOrWhiteSpace(_searchQuery) 
            ? _books 
            : _books.Where(b => b.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || b.Authors.Any(a => a.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();

        <div class="books-grid">
            @foreach (var book in filteredBooks)
            {
                <BookCard Book="book" />
            }
        </div>
        
        @if (_hasMore && string.IsNullOrWhiteSpace(_searchQuery))
        {
            <div @ref="_loadMoreElement" class="load-more-trigger mt-4 text-center p-3">
                @if (_isLoading)
                {
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando más...</span>
                    </div>
                }
            </div>
        }
    }
</div>

@implements IDisposable
@inject IJSRuntime JSRuntime

@code {
    private ElementReference _loadMoreElement;
    private DotNetObjectReference<BookList>? _objRef;
    private List<Book> _books = new();
    private List<Book> _recommendations = new();
    private int _currentPage = 1;
    private bool _isLoading = false;
    private bool _hasMore = true;
    private bool _isUploading = false;
    private CancellationTokenSource _cts = new();
    private string _searchQuery = string.Empty;

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (!file.Name.EndsWith(".epub", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowError("Solo se permiten archivos .epub");
            return;
        }

        _isUploading = true;
        StateHasChanged();

        try
        {
            // Allowed up to 100MB
            using var stream = file.OpenReadStream(maxAllowedSize: 104857600);
            var uploadedBook = await ApiClient.UploadEpubAsync(stream, file.Name);
            
            ToastService.ShowSuccess($"¡{uploadedBook.Title} importado con éxito!");
            
            // Refrescar biblioteca
            _currentPage = 1;
            _hasMore = true;
            _books.Clear();
            await LoadBooksAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error al subir el libro: " + ex.Message);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);
        var fetchRecs = ApiClient.GetRecommendationsAsync();
        await LoadBooksAsync();
        _recommendations = await fetchRecs;
        _ = PollNewBooksAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hasMore && _loadMoreElement.Id != null && string.IsNullOrWhiteSpace(_searchQuery))
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("infiniteScroll.initialize", _loadMoreElement, _objRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task LoadMoreRequested()
    {
        if (!_isLoading && _hasMore && string.IsNullOrWhiteSpace(_searchQuery))
        {
            await LoadMoreAsync();
            StateHasChanged();
        }
    }

    private async Task PollNewBooksAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (_isLoading || _books.Count == 0) continue;
                
                try
                {
                    var result = await ApiClient.GetBooksAsync(1, 1);
                    if (result.Data.Length > 0 && result.Data[0].Id > _books[0].Id)
                    {
                        _currentPage = 1;
                        _hasMore = true;
                        _books.Clear();
                        await LoadBooksAsync();
                    }
                }
                catch { }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadBooksAsync()
    {
        if (_isLoading || !_hasMore) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.GetBooksAsync(_currentPage, 20);
            
            if (result.Data.Length > 0)
            {
                _books.AddRange(result.Data);
                _currentPage++;
                
                if (result.Data.Length < 20)
                {
                    _hasMore = false;
                }
            }
            else
            {
                _hasMore = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando libros: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        await LoadBooksAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _objRef?.Dispose();
    }
}

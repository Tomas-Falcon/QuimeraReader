@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services

<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Metadatos">
            <div class="mb-3">
                <RadzenLabel Text="Título" />
                <RadzenTextBox @bind-Value="_request.Title" class="w-100" />
            </div>
            <div class="mb-3">
                <RadzenLabel Text="Estado de lectura" />
                <RadzenDropDown @bind-Value="_request.ReadingStatus" Data="@_readingStatuses" TextProperty="Label" ValueProperty="Value" class="w-100" />
            </div>
            <div class="mb-3">
                <RadzenLabel Text="Categorías" />
                <RadzenDropDown @bind-Value="_request.Categories" Data="@_availableCategories" TextProperty="Name" ValueProperty="Name" Multiple="true" class="w-100" />
            </div>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Portada">
            <div class="mb-3">
                <RadzenLabel Text="URL de la Portada (reemplazar)" />
                <RadzenTextBox @bind-Value="_coverUrl" class="w-100" />
            </div>
            @if (!string.IsNullOrEmpty(Book?.CoverUrl))
            {
                            <div class="mb-3 d-flex align-items-center justify-content-between">
                <RadzenButton Text="Buscar portadas online" Icon="search" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="SearchCoversAsync" IsBusy="@_isSearchingCovers" />
            </div>
            @if (_suggestedCovers.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-3" style="max-height: 250px; overflow-y: auto; background: var(--rz-base-background-color); padding: 10px; border-radius: 8px;">
                    @foreach (var cover in _suggestedCovers)
                    {
                        <img src="@cover" alt="Cover Option" style="width: 90px; height: 130px; object-fit: cover; cursor: pointer; border: @(cover == _coverUrl ? "3px solid var(--rz-primary)" : "1px solid #ccc"); border-radius: 4px; transition: transform 0.2s;" @onclick="() => SelectCover(cover)" />
                    }
                </div>
            }
                <div class="text-center mt-3">
                    <img src="@(BookService.BaseAddress + Book.CoverUrl)" alt="Cover" style="max-height: 200px; object-fit: contain;" />
                </div>
            }
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

<div class="mt-4 d-flex justify-content-end gap-2">
    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="() => DialogService.Close(false)" />
    <RadzenButton Text="Guardar" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" />
</div>
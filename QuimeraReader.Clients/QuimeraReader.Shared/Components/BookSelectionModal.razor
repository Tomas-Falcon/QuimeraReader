@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@using Radzen
@using Radzen.Blazor
@inject IBookService BookService
@inject Radzen.DialogService DialogService

<div class="mb-3">
    <RadzenLabel Text="Buscar libro" />
    <RadzenTextBox @bind-Value="_search" class="w-100 mb-2" Placeholder="Escribe un título..." @oninput="OnSearchInput" />
</div>

<div style="max-height: 300px; overflow-y: auto;" class="mb-4 border p-2">
    @if (_isLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (_books != null && _books.Any())
    {
        <RadzenRadioButtonList @bind-Value="_selectedBookId" TValue="int?" Orientation="Orientation.Vertical">
            <Items>
                @foreach (var book in _books)
                {
                    <RadzenRadioButtonListItem Text="@book.Title" Value="@((int?)book.Id)" />
                }
            </Items>
        </RadzenRadioButtonList>
    }
    else
    {
        <p class="text-muted">No se encontraron libros.</p>
    }
</div>

<div class="d-flex justify-content-end gap-2">
    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="() => DialogService.Close((int?)null)" />
    <RadzenButton Text="Seleccionar" ButtonStyle="ButtonStyle.Primary" Click="ConfirmSelection" Disabled="@(!_selectedBookId.HasValue)" />
</div>

@code {
    private string _search = "";
    private List<Book> _books = new();
    private int? _selectedBookId;
    private bool _isLoading = false;
    private System.Timers.Timer _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        _debounceTimer = new System.Timers.Timer(500);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (s, e) => await InvokeAsync(LoadBooksAsync);
        await LoadBooksAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounceTimer.Stop();
        _debounceTimer.Start();
    }

    private async Task LoadBooksAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var res = await BookService.GetBooksAsync(page: 1, pageSize: 20, search: _search);
            _books = res.Items.ToList();
        }
        catch { }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ConfirmSelection()
    {
        DialogService.Close(_selectedBookId);
    }
}

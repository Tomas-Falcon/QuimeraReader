@page "/author/{AuthorName}"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Components
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@inject NavigationManager NavManager
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService

<PageTitle>@AuthorName - QuimeraReader</PageTitle>

<div class="mb-4 d-flex align-items-center">
    <button class="btn btn-outline-secondary me-3" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> @TranslationService["Action_BackToAuthors"]
    </button>
    <h2 class="mb-0 text-primary"><i class="bi bi-person-badge-fill me-2"></i> @AuthorName</h2>
</div>

<hr class="border-secondary mb-4" />

<BookList QueryParam="@AuthorName" />

@code {
    [Parameter]
    public string AuthorName { get; set; } = "";

    private void GoBack()
    {
        NavManager.NavigateTo("/authors");
    }
}


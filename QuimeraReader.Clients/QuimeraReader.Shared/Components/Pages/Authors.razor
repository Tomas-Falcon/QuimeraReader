@page "/authors"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Components
@using Radzen
@using Radzen.Blazor
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject NavigationManager NavManager
@inject Radzen.DialogService DialogService
@inject ToastService ToastService

<PageTitle>Autores</PageTitle>

<div class="library-container">
    <div class="library-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h2 class="mb-0"><span class="bi bi-people-fill text-primary me-2"></span> Autores</h2>
        
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (_selectionMode)
            {
                <span class="text-primary fw-bold me-2">@_selectedAuthorIds.Count seleccionados</span>
                <RadzenButton Text="Cancelar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                <RadzenButton Text="Borrar Seleccionados" Click="DeleteSelectedAsync" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Icon="delete" Disabled="@(_selectedAuthorIds.Count == 0)" />
            }
            else
            {
                <RadzenButton Text="Seleccionar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Icon="check_box" />
            }
            <div class="search-box" style="flex: 0 0 250px;">
                <RadzenTextBox Placeholder="Buscar autor..." Value="@_searchQuery" Change="OnSearchInput" class="w-100" />
            </div>
        </div>
    </div>

    @if (authors == null)
    {
        <div class="text-center mt-5">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Cargando autores...</p>
        </div>
    }
    else if (!FilteredAuthors.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-person-x" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h3 class="mt-3">Sin resultados</h3>
            <p class="text-muted">No se encontraron autores que coincidan con la búsqueda.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4 m-0">
            @foreach (var author in FilteredAuthors)
            {
                var isSelected = _selectedAuthorIds.Contains(author.Id);
                <div class="col position-relative">
                    @if (_selectionMode)
                    {
                        <div class="position-absolute" style="top: 10px; right: 20px; z-index: 10;">
                            <RadzenCheckBox TValue="bool" Value="isSelected" Change="@(args => ToggleAuthorSelection(author.Id, args))" />
                        </div>
                    }

                    <div class="card h-100 bg-dark text-light border-secondary shadow-sm author-card @(isSelected ? "border-primary" : "")" 
                         @onclick="() => HandleCardClick(author)" 
                         style="cursor: pointer; border-radius: 12px; overflow: hidden; transition: transform 0.2s; @(isSelected ? "box-shadow: 0 0 0 2px var(--rz-primary) !important;" : "")">
                        
                        <div class="author-cover position-relative" style="aspect-ratio: 1; background: #222;">
                            @if (!string.IsNullOrEmpty(author.SampleCoverUrl))
                            {
                                <img src="@(BookService.BaseAddress + author.SampleCoverUrl)" alt="@author.Name" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: blur(2px);" />
                                <div class="position-absolute top-50 start-50 translate-middle text-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg mx-auto" style="width: 70px; height: 70px;">
                                        <span class="fw-bold fs-3">@(author.Name.FirstOrDefault())</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 70px; height: 70px;">
                                        <i class="bi bi-person fs-1"></i>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body text-center p-3">
                            <h6 class="card-title fw-bold mb-1 text-truncate" title="@author.Name">@author.Name</h6>
                            <small class="text-white-50">@author.BookCount libros</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .library-container { max-width: 100%; overflow-x: hidden; }
    .author-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.5) !important; border-color: var(--bs-primary) !important; }
</style>

@code {
    private List<Author>? authors;
    private string _searchQuery = "";

    private bool _selectionMode = false;
    private HashSet<int> _selectedAuthorIds = new();

    private IEnumerable<Author> FilteredAuthors => authors?
        .Where(a => string.IsNullOrWhiteSpace(_searchQuery) || a.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Author>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }
    
    private async Task LoadDataAsync()
    {
        try
        {
            var result = await BookService.GetAuthorsAsync();
            authors = result.ToList();
        }
        catch (Exception ex)
        {
            authors = new List<Author>();
        }
    }

    private void OnSearchInput(string value)
    {
        _searchQuery = value ?? "";
    }

    private void ToggleSelectionMode()
    {
        _selectionMode = !_selectionMode;
        if (!_selectionMode)
        {
            _selectedAuthorIds.Clear();
        }
    }

    private void HandleCardClick(Author author)
    {
        if (_selectionMode)
        {
            ToggleAuthorSelection(author.Id, !_selectedAuthorIds.Contains(author.Id));
        }
        else
        {
            NavManager.NavigateTo($"/author/{Uri.EscapeDataString(author.Name)}");
        }
    }

    private void ToggleAuthorSelection(int authorId, bool isSelected)
    {
        if (isSelected)
            _selectedAuthorIds.Add(authorId);
        else
            _selectedAuthorIds.Remove(authorId);
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedAuthorIds.Count == 0) return;

        var result = await DialogService.Confirm(
            $"¡ATENCIÓN! Vas a borrar {_selectedAuthorIds.Count} autores. Esta acción ELIMINARÁ PERMANENTEMENTE todos sus libros y archivos físicos del disco (EPUBs, audios, portadas).", 
            "⚠️ ¿Eliminar Autores y sus Libros?", 
            new ConfirmOptions() { OkButtonText = "Sí, ELIMINAR TODO", CancelButtonText = "Cancelar" });

        if (result == true)
        {
            // Second confirmation just to be sure!
            var secondConfirm = await DialogService.Confirm(
                "¿Estás ABSOLUTAMENTE SEGURO? Los archivos borrados del disco duro no se pueden recuperar.", 
                "Última Confirmación", 
                new ConfirmOptions() { OkButtonText = "Borrar permanentemente", CancelButtonText = "Cancelar" });

            if (secondConfirm == true)
            {
                await BookService.DeleteAuthorsAsync(_selectedAuthorIds.ToArray());
                ToastService.ShowSuccess("Autores y libros eliminados de forma permanente.");
                _selectionMode = false;
                _selectedAuthorIds.Clear();
                await LoadDataAsync();
            }
        }
    }
}
@page "/authors"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Components
@inject QuimeraReader.Shared.Services.IQuimeraApiClient ApiClient
@inject NavigationManager NavManager

<PageTitle>Autores</PageTitle>

<div class="library-container">
    <div class="library-toolbar d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><span class="bi bi-people-fill text-primary me-2"></span> Autores</h2>
        <div class="search-box" style="flex: 0 0 300px;">
            <input type="text" class="form-control" placeholder="Buscar autor..." value="@_searchQuery" @oninput="OnSearchInput" />
        </div>
    </div>

    @if (authors == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando autores...</p>
        </div>
    }
    else if (!FilteredAuthors.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-person-x" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h3 class="mt-3">Sin resultados</h3>
            <p class="text-muted">No se encontraron autores que coincidan con la búsqueda.</p>
        </div>
    }
    else
    {
        <div class="authors-grid row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var author in FilteredAuthors)
            {
                <div class="col">
                    <div class="card h-100 bg-dark text-light border-secondary shadow-sm author-card" @onclick="() => SelectAuthor(author.Name)" style="cursor: pointer; border-radius: 12px; overflow: hidden; transition: transform 0.2s;">
                        <div class="author-cover position-relative" style="aspect-ratio: 1; background: #222;">
                            @if (!string.IsNullOrEmpty(author.SampleCoverUrl))
                            {
                                <img src="@(ApiClient.BaseAddress + author.SampleCoverUrl)" alt="@author.Name" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: blur(2px);" />
                                <div class="position-absolute top-50 start-50 translate-middle text-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg mx-auto" style="width: 70px; height: 70px;">
                                        <span class="fw-bold fs-3">@(author.Name.FirstOrDefault())</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 70px; height: 70px;">
                                        <i class="bi bi-person fs-1"></i>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body text-center p-3">
                            <h6 class="card-title fw-bold mb-1 text-truncate" title="@author.Name">@author.Name</h6>
                            <small class="text-white-50">@author.BookCount libros</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .author-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.5) !important; border-color: var(--bs-primary) !important; }
</style>

@code {
    private List<Author>? authors;
    private string _searchQuery = "";

    private IEnumerable<Author> FilteredAuthors => authors?
        .Where(a => string.IsNullOrWhiteSpace(_searchQuery) || a.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Author>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiClient.GetAuthorsAsync();
            authors = result.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando autores: {ex.Message}");
            authors = new List<Author>();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
    }

    private void SelectAuthor(string authorName)
    {
        // Navega a la biblioteca aplicando el filtro del autor (asumiendo que BookList soporta el QueryParam o navegando al Home con query)
        NavManager.NavigateTo($"/?q={Uri.EscapeDataString(authorName)}");
    }
}



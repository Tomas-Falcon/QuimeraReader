@page "/not-found"
@namespace QuimeraReader.Shared.Components.Pages

<PageTitle>No encontrado - QuimeraReader</PageTitle>

<LayoutView Layout="@typeof(QuimeraReader.Shared.Components.Layout.MainLayout)">
    <div class="container py-5 text-center">
        <i class="bi bi-compass text-warning" style="font-size: 3.5rem;"></i>
        <h3 class="mt-3 text-light">Página no encontrada</h3>
        <p class="text-muted">El contenido que buscas no existe o fue movido.</p>
        <a href="/" class="btn btn-primary mt-2"><i class="bi bi-house-door me-1"></i> Volver al Inicio</a>
    </div>
</LayoutView>

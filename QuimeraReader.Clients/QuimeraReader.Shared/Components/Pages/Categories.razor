@page "/categories"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Components
@using Radzen
@using Radzen.Blazor
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject NavigationManager NavManager
@inject Radzen.DialogService DialogService
@inject ToastService ToastService

<PageTitle>Categorías</PageTitle>

<div class="library-container">
    <div class="library-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h2 class="mb-0"><span class="bi bi-tags-fill text-primary me-2"></span> Explorador de Géneros</h2>
        
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (_selectionMode)
            {
                <span class="text-primary fw-bold me-2">@_selectedCategoryIds.Count seleccionadas</span>
                <RadzenButton Text="Cancelar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                <RadzenButton Text="Borrar Seleccionadas" Click="DeleteSelectedAsync" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Icon="delete" Disabled="@(_selectedCategoryIds.Count == 0)" />
            }
            else
            {
                <RadzenButton Text="Seleccionar" Click="ToggleSelectionMode" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Icon="check_box" />
            }
            <div class="search-box" style="flex: 0 0 250px;">
                <RadzenTextBox Placeholder="Buscar categoría..." Value="@_searchQuery" Change="OnSearchInput" class="w-100" />
            </div>
        </div>
    </div>

    @if (categories == null)
    {
        <div class="text-center mt-5">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Cargando categorías...</p>
        </div>
    }
    else if (!FilteredCategories.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-tags" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h3 class="mt-3">Sin resultados</h3>
            <p class="text-muted">No se encontraron categorías que coincidan con la búsqueda.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4 m-0">
            @foreach (var cat in FilteredCategories)
            {
                var isSelected = _selectedCategoryIds.Contains(cat.Id);
                <div class="col position-relative">
                    @if (_selectionMode)
                    {
                        <div class="position-absolute" style="top: 10px; right: 20px; z-index: 10;">
                            <RadzenCheckBox TValue="bool" Value="isSelected" Change="@(args => ToggleCategorySelection(cat.Id, args))" />
                        </div>
                    }

                    <div class="card h-100 bg-dark text-light border-secondary shadow-sm category-card @(isSelected ? "border-primary" : "")" 
                         @onclick="() => HandleCardClick(cat)" 
                         style="cursor: pointer; border-radius: 12px; overflow: hidden; transition: transform 0.2s; @(isSelected ? "box-shadow: 0 0 0 2px var(--rz-primary) !important;" : "")">
                        
                        <div class="category-cover position-relative" style="aspect-ratio: 1; background: #222;">
                            @if (!string.IsNullOrEmpty(cat.SampleCoverUrl))
                            {
                                <img src="@(BookService.BaseAddress + cat.SampleCoverUrl)" alt="@cat.Name" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: blur(2px);" />
                            }
                            <div class="position-absolute top-50 start-50 translate-middle text-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg mx-auto" style="width: 70px; height: 70px;">
                                    <i class="bi bi-tag fs-3"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body text-center p-3">
                            <h6 class="card-title fw-bold mb-1 text-truncate" title="@cat.Name">@cat.Name</h6>
                            <small class="text-white-50">@cat.BookCount libros</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .library-container { max-width: 100vw; overflow-x: hidden; }
    .category-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.5) !important; border-color: var(--bs-primary) !important; }
</style>

@code {
    private List<Category>? categories;
    private string _searchQuery = "";
    
    private bool _selectionMode = false;
    private HashSet<int> _selectedCategoryIds = new();

    private IEnumerable<Category> FilteredCategories => categories?
        .Where(c => string.IsNullOrWhiteSpace(_searchQuery) || c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Category>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }
    
    private async Task LoadDataAsync()
    {
        try
        {
            var result = await BookService.GetCategoriesAsync();
            categories = result.ToList();
        }
        catch (Exception ex)
        {
            categories = new List<Category>();
        }
    }

    private void OnSearchInput(string value)
    {
        _searchQuery = value ?? "";
    }

    private void ToggleSelectionMode()
    {
        _selectionMode = !_selectionMode;
        if (!_selectionMode)
        {
            _selectedCategoryIds.Clear();
        }
    }

    private void HandleCardClick(Category cat)
    {
        if (_selectionMode)
        {
            ToggleCategorySelection(cat.Id, !_selectedCategoryIds.Contains(cat.Id));
        }
        else
        {
            NavManager.NavigateTo($"/category/{Uri.EscapeDataString(cat.Name)}");
        }
    }

    private void ToggleCategorySelection(int catId, bool isSelected)
    {
        if (isSelected)
            _selectedCategoryIds.Add(catId);
        else
            _selectedCategoryIds.Remove(catId);
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedCategoryIds.Count == 0) return;

        var result = await DialogService.Confirm(
            $"¿Estás seguro de que deseas eliminar las {_selectedCategoryIds.Count} categorías seleccionadas? (Los libros no serán borrados, solo perderán la etiqueta).", 
            "Eliminar Categorías", 
            new ConfirmOptions() { OkButtonText = "Sí, eliminar", CancelButtonText = "Cancelar" });

        if (result == true)
        {
            await BookService.DeleteCategoriesAsync(_selectedCategoryIds.ToArray());
            ToastService.ShowSuccess("Categorías eliminadas correctamente.");
            _selectionMode = false;
            _selectedCategoryIds.Clear();
            await LoadDataAsync();
        }
    }
}
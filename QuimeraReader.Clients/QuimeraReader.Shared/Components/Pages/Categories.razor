@page "/categories"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Components
@inject QuimeraReader.Shared.Services.IQuimeraApiClient ApiClient
@inject NavigationManager NavManager

<PageTitle>Categorías</PageTitle>

<div class="library-container">
    <div class="library-toolbar d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><span class="bi bi-tags-fill text-primary me-2"></span> Explorador de Géneros</h2>
        <div class="search-box" style="flex: 0 0 300px;">
            <input type="text" class="form-control" placeholder="Buscar categoría..." value="@_searchQuery" @oninput="OnSearchInput" />
        </div>
    </div>

    @if (categories == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando categorías...</p>
        </div>
    }
    else if (!FilteredCategories.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-tags" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h3 class="mt-3">Sin resultados</h3>
            <p class="text-muted">No se encontraron categorías que coincidan con la búsqueda.</p>
        </div>
    }
    else
    {
        <div class="categories-grid row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var cat in FilteredCategories)
            {
                <div class="col">
                    <div class="card h-100 bg-dark text-light border-secondary shadow-sm category-card" @onclick="() => SelectCategory(cat.Name)" style="cursor: pointer; border-radius: 12px; overflow: hidden; transition: transform 0.2s;">
                        <div class="category-cover position-relative" style="aspect-ratio: 1; background: #222;">
                            @if (!string.IsNullOrEmpty(cat.SampleCoverUrl))
                            {
                                <img src="@(ApiClient.BaseAddress + cat.SampleCoverUrl)" alt="@cat.Name" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: blur(2px);" />
                                <div class="position-absolute top-50 start-50 translate-middle text-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg mx-auto" style="width: 70px; height: 70px;">
                                        <i class="bi bi-tag fs-3"></i>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 70px; height: 70px;">
                                        <i class="bi bi-tag fs-1"></i>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body text-center p-3">
                            <h6 class="card-title fw-bold mb-1 text-truncate" title="@cat.Name">@cat.Name</h6>
                            <small class="text-white-50">@cat.BookCount libros</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .category-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.5) !important; border-color: var(--bs-primary) !important; }
</style>

@code {
    private List<Category>? categories;
    private string _searchQuery = "";

    private IEnumerable<Category> FilteredCategories => categories?
        .Where(c => string.IsNullOrWhiteSpace(_searchQuery) || c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<Category>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiClient.GetCategoriesAsync();
            categories = result.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando categorías: {ex.Message}");
            categories = new List<Category>();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
    }

    private void SelectCategory(string categoryName)
    {
        NavManager.NavigateTo($"/category/{Uri.EscapeDataString(categoryName)}");
    }
}

@page "/read-books"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IBookService BookService
@inject NavigationManager NavManager
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService

<div class="p-4" style="background: var(--bg-body); min-height: 100vh;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavManager.NavigateTo(""))" />
        <h2 class="mb-0" style="color: var(--text-color);">@TranslationService["Nav_ReadBooks"]</h2>
    </div>

    @if (_isLoading)
    {
        <div class="text-center p-5">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Cargando...</p>
        </div>
    }
    else if (_books.Count == 0)
    {
        <div class="text-center p-5">
            <RadzenIcon Icon="done_all" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <p class="text-muted mt-2">Aún no has terminado ningún libro.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var book in _books)
            {
                <div class="col">
                    <BookCard Book="book" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Book> _books = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await BookService.GetBooksAsync(1, 1000, readingStatus: "Read");
        if (result != null && result.Data != null)
        {
            _books = result.Data.ToList();
        }
        
        // Also fetch those with PercentageCompleted >= 100 just in case
        var extraResult = await BookService.GetBooksAsync(1, 1000, "");
        if (extraResult != null && extraResult.Data != null)
        {
            var extraBooks = extraResult.Data.Where(b => b.PercentageCompleted >= 100 && b.ReadingStatus != "Read").ToList();
            foreach(var e in extraBooks) 
            {
                if (!_books.Any(b => b.Id == e.Id))
                    _books.Add(e);
            }
        }
        
        _isLoading = false;
    }
}
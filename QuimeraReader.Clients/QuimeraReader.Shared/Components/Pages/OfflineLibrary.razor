@page "/offline-library"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Interfaces
@inject NavigationManager NavManager
@inject ITranslationService TranslationService
@inject IServiceProvider ServiceProvider

<div class="p-4" style="background: var(--bg-body); min-height: 100vh; overflow-x: hidden; max-width: 100%; box-sizing: border-box;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavManager.NavigateTo(""))" />
        <h2 class="mb-0" style="color: var(--text-color);">@TranslationService["OfflineLibrary_Title"]</h2>
    </div>

    @if (_isLoading)
    {
        <div class="text-center p-5">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">@TranslationService["OfflineLibrary_Loading"]</p>
        </div>
    }
    else if (_error != null)
    {
        <div class="text-center p-5">
            <RadzenIcon Icon="error_outline" Style="font-size: 3rem; color: var(--rz-danger);" />
            <p class="mt-2" style="color: var(--text-color);">@TranslationService["OfflineLibrary_Error"]</p>
            <p class="text-muted small">@_error</p>
            <RadzenButton Icon="refresh" Text="@TranslationService["OfflineLibrary_Retry"]" ButtonStyle="ButtonStyle.Primary" Click="LoadAsync" />
        </div>
    }
    else if (_books.Count == 0)
    {
        <div class="text-center p-5">
            <RadzenIcon Icon="cloud_off" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <p class="text-muted mt-2">@TranslationService["OfflineLibrary_Empty"]</p>
        </div>
    }
    else
    {
        <div class="row m-0 row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var book in _books)
            {
                <div class="col">
                    <BookCard Book="book" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Book> _books = new();
    private bool _isLoading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var localRepo = ServiceProvider.GetService(typeof(ILocalBookRepository)) as ILocalBookRepository;
            if (localRepo != null)
            {
                await localRepo.EnsureCreatedAsync();
                var offlineBooks = await localRepo.GetOfflineBooksAsync();
                _books = offlineBooks?.ToList() ?? new List<Book>();
            }
        }
        catch (Exception ex)
        {
            // Un fallo de la base de datos local no es un libro: se muestra como error con opción de reintentar
            _books = new List<Book>();
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}



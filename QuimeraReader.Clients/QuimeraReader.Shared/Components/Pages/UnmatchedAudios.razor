@page "/unmatched-audios"

@using QuimeraReader.Shared.Services
@using QuimeraReader.Shared.Models
@inject HttpClient Http
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@inject Radzen.DialogService DialogService
@inject ToastService ToastService

<RadzenCard class="m-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Audios Huérfanos</h3>
                <div>
            <RadzenButton Icon="auto_fix_high" Text="Auto-vincular" ButtonStyle="ButtonStyle.Secondary" class="me-2" Click="AutoMatchAudios" IsBusy="@_isAutoMatching" />
            <RadzenButton Icon="refresh" Text="Recargar" Click="LoadAudios" IsBusy="@_isLoading" />
        </div>
    </div>

    @if (_isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!_audios.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat">
            No hay audios huérfanos en la base de datos. ¡Todo está en orden!
        </RadzenAlert>
    }
    else
    {
        <div style="overflow-x: auto; width: 100%;"><RadzenDataGrid Data="@_audios" TItem="UnmatchedAudioTrack" AllowPaging="true" PageSize="10" AllowSorting="true" Style="min-width: 800px;">
            <Columns>
                <RadzenDataGridColumn TItem="UnmatchedAudioTrack" Property="Id" Title="ID" Width="70px" />
                <RadzenDataGridColumn TItem="UnmatchedAudioTrack" Property="OriginalFileName" Title="Archivo Original" />
                <RadzenDataGridColumn TItem="UnmatchedAudioTrack" Property="FileSizeBytes" Title="Tamaño">
                    <Template Context="audio">
                        @(Math.Round((double)audio.FileSizeBytes / 1024 / 1024, 2)) MB
                    </Template>
                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="UnmatchedAudioTrack" Title="Escuchar" Width="260px">
                    <Template Context="audio">
                        <audio controls src="@(Http.BaseAddress)api/books/unmatched-audios/@(audio.Id)/stream" style="height: 30px; width: 230px;"></audio>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UnmatchedAudioTrack" Property="UploadedAt" Title="Fecha Subida" FormatString="{0:dd/MM/yyyy HH:mm}" />
                <RadzenDataGridColumn TItem="UnmatchedAudioTrack" Title="Acciones" Width="200px" TextAlign="TextAlign.Center">
                    <Template Context="audio">
                        <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="me-1" Click="@(() => OpenMatchDialog(audio))" title="Asociar a libro" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteAudio(audio))" title="Eliminar definitivamente" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid></div>
    }
</RadzenCard>



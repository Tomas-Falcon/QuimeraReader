@page "/unmatched-audios"

@using QuimeraReader.Shared.Services
@using QuimeraReader.Shared.Models
@inject HttpClient Http
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@inject Radzen.DialogService DialogService
@inject ToastService ToastService

<RadzenCard class="m-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Gestión de Audios</h3>
        <div>
            <RadzenDropDown TValue="bool?" Data="@_filterOptions" ValueProperty="Value" TextProperty="Text" @bind-Value="_filterMatched" Change="@OnFilterChanged" class="me-3" Style="width: 200px;" />
            <RadzenButton Icon="auto_fix_high" Text="Auto-vincular" ButtonStyle="ButtonStyle.Secondary" class="me-2" Click="AutoMatchAudios" IsBusy="@_isAutoMatching" />
            <RadzenButton Icon="refresh" Text="Recargar" Click="LoadAudios" IsBusy="@_isLoading" />
        </div>
    </div>

    @if (_isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!_filteredAudios.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat">
            No hay audios para mostrar con este filtro.
        </RadzenAlert>
    }
    else
    {
        <div style="overflow-x: auto; width: 100%;">
            <RadzenDataGrid Data="@_filteredAudios" TItem="ManagedAudioDto" AllowPaging="true" PageSize="10" AllowSorting="true" Style="min-width: 800px;">
                <Columns>
                    <RadzenDataGridColumn TItem="ManagedAudioDto" Property="Id" Title="ID" Width="70px" />
                    <RadzenDataGridColumn TItem="ManagedAudioDto" Property="FileName" Title="Archivo" />
                    <RadzenDataGridColumn TItem="ManagedAudioDto" Property="IsMatched" Title="Estado" Width="120px">
                        <Template Context="audio">
                            @if (audio.IsMatched)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Asignado" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Huérfano" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ManagedAudioDto" Property="BookTitle" Title="Libro Asociado" />
                    <RadzenDataGridColumn TItem="ManagedAudioDto" Title="Acciones" Width="200px" TextAlign="TextAlign.Center">
                        <Template Context="audio">
                            @if (!audio.IsMatched)
                            {
                                <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="me-1" Click="@(() => OpenMatchDialog(audio))" title="Asociar a libro" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteAudio(audio))" title="Eliminar definitivamente" />
                            }
                            else
                            {
                                <RadzenButton Icon="auto_stories" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" title="Ver Libro" Click="@(() => NavigateToBook(audio.BookId))" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</RadzenCard>




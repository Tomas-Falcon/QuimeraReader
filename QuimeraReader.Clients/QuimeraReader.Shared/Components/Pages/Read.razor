@page "/read/{BookId:int}"
@using QuimeraReader.Shared.Components
@namespace QuimeraReader.Shared.Components.Pages

<PageTitle>Lector - QuimeraReader</PageTitle>

<ReaderPlayer BookId="@BookId" FromStart="@FromStart" />

@code {
    [Parameter]
    public int BookId { get; set; }

    // /read/{id}?fromStart=true: "Volver a leer" abre desde la primera página
    [SupplyParameterFromQuery]
    public bool FromStart { get; set; }
}

@using QuimeraReader.Shared.Models
@inject NavigationManager NavManager
@namespace QuimeraReader.Shared.Components

<div class="book-card" @onclick="GoToRead">
    <div class="cover-container">
        @if (!string.IsNullOrEmpty(Book?.CoverUrl))
        {
            <img src="@Book.CoverUrl" alt="Portada de @Book.Title" class="cover-image" loading="lazy" />
        }
        else
        {
            <div class="placeholder-cover">
                <span>Sin Portada</span>
            </div>
        }
    </div>
    <div class="book-info">
        <h3 class="book-title" title="@Book?.Title">@Book?.Title</h3>
        @if (!string.IsNullOrEmpty(Book?.Isbn))
        {
            <p class="book-isbn">ISBN: @Book.Isbn</p>
        }
    </div>
</div>

<style>
    .book-card {
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        background: transparent;
        color: #fff;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
        display: flex;
        flex-direction: column;
    }

    .book-card:hover {
        transform: translateY(-6px);
    }

    .cover-container {
        width: 100%;
        aspect-ratio: 1 / 1.5;
        background-color: #2c2c2e;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .cover-container::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        pointer-events: none;
    }

    .cover-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder-cover {
        color: #777;
        font-size: 0.95rem;
        font-weight: 500;
        text-align: center;
    }

    .book-info {
        padding: 12px 4px;
    }

    .book-title {
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0 0 4px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        letter-spacing: 0.2px;
    }

    .book-isbn {
        font-size: 0.85rem;
        color: #98989d;
        font-weight: 400;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    [Parameter]
    public Book? Book { get; set; }

    private void GoToRead()
    {
        if (Book != null)
        {
            NavManager.NavigateTo($"/read/{Book.Id}");
        }
    }
}

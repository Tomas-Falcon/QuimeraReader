@using QuimeraReader.Shared.Models
@inject NavigationManager NavManager
@namespace QuimeraReader.Shared.Components

<div class="book-card" @onclick="GoToRead">
    <div class="cover-container">
        @if (!string.IsNullOrEmpty(Book?.CoverUrl))
        {
            <img src="@Book.CoverUrl" alt="Portada de @Book.Title" class="cover-image" loading="lazy" />
        }
        else
        {
            <div class="placeholder-cover">
                <span>Sin Portada</span>
            </div>
        }
    </div>
    <div class="book-info">
        <h3 class="book-title" title="@Book?.Title">@Book?.Title</h3>
        @if (!string.IsNullOrEmpty(Book?.Isbn))
        {
            <p class="book-isbn">ISBN: @Book.Isbn</p>
        }
    </div>
</div>

<style>
    .book-card {
        width: 160px;
        border-radius: 8px;
        overflow: hidden;
        background: #2d2d2d;
        color: #ffffff;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
    }

    .book-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    .cover-container {
        width: 100%;
        height: 240px;
        background-color: #1a1a1a;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cover-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder-cover {
        color: #666;
        font-size: 0.9rem;
        text-align: center;
    }

    .book-info {
        padding: 12px;
    }

    .book-title {
        font-size: 1rem;
        margin: 0 0 4px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .book-isbn {
        font-size: 0.8rem;
        color: #aaa;
        margin: 0;
    }
</style>

@code {
    [Parameter]
    public Book? Book { get; set; }

    private void GoToRead()
    {
        if (Book != null)
        {
            NavManager.NavigateTo($"/read/{Book.Id}");
        }
    }
}

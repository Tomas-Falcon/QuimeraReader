@using QuimeraReader.Shared.Models
@inject NavigationManager NavManager
@inject QuimeraReader.Shared.Services.IBookService BookService
@inject QuimeraReader.Shared.Services.IScanService ScanService
@inject QuimeraReader.Shared.Services.ISettingsService SettingsService
@namespace QuimeraReader.Shared.Components

<div class="book-card @(IsSelected ? "selected" : "")" @onclick="HandleCardClick">
    @if (SelectionMode)
    {
        <div class="selection-checkbox" @onclick:stopPropagation>
            <input type="checkbox" class="form-check-input" checked="@IsSelected" @onchange="ToggleSelection" />
        </div>
    }
    <div class="cover-container">
        @if (!string.IsNullOrEmpty(Book?.CoverUrl ?? Book?.LocalCoverPath))
        {
            <img src="@BookService.GetMediaUrl(QuimeraReader.Shared.Helpers.ImageHelper.GetImageSource((!string.IsNullOrEmpty(Book.LocalCoverPath) ? Book.LocalCoverPath : Book.CoverUrl), BookService.BaseAddress))" alt="Portada de @Book.Title" class="cover-image" loading="lazy" onerror="this.outerHTML='<div class=\'placeholder-cover\'><span>Sin Portada</span></div>'" />
        }
        else
        {
            <div class="placeholder-cover">
                <span>Sin Portada</span>
            </div>
        }
    </div>
    <div class="book-info">
        <h3 class="book-title" title="@Book?.Title">@Book?.Title</h3>
        @if (Book != null && Book.Authors.Any())
        {
            <p class="book-author text-muted mb-1" style="font-size: 0.85em;">@string.Join(", ", Book.Authors)</p>
        }
        @* Saga, puntuación y progreso ocupan siempre su línea (vacía si no hay): así todas las tarjetas de una fila
           miden lo mismo y las barras de progreso quedan alineadas *@
        <p class="book-series text-warning mb-1 @(string.IsNullOrEmpty(Book?.Series) ? "book-line-empty" : "")" style="font-size: 0.8em; font-weight: bold;">@(string.IsNullOrEmpty(Book?.Series) ? " " : Book!.Series)</p>
        <div class="book-rating text-warning @(Book?.AverageRating > 0 ? "" : "book-line-empty")" style="font-size: 0.8em;">
            @if (Book?.AverageRating > 0)
            {
                <i class="bi bi-star-fill"></i><span>@Book.AverageRating.Value.ToString("0.0")</span>
            }
            else
            {
                <span>&nbsp;</span>
            }
        </div>
        <div class="progress mt-2 @(Book?.PercentageCompleted > 0 ? "" : "book-line-empty")" style="height: 4px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: @((Book?.PercentageCompleted ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))%;" aria-valuenow="@(Book?.PercentageCompleted ?? 0)" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Book? Book { get; set; }

    [Parameter]
    public bool SelectionMode { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<bool> IsSelectedChanged { get; set; }

    private void HandleCardClick()
    {
        if (SelectionMode)
        {
            ToggleSelection(new ChangeEventArgs { Value = !IsSelected });
        }
        else
        {
            GoToDetails();
        }
    }

    private async Task ToggleSelection(ChangeEventArgs e)
    {
        IsSelected = (bool)(e.Value ?? false);
        await IsSelectedChanged.InvokeAsync(IsSelected);
    }

    private void GoToDetails()
    {
        if (Book != null)
        {
            NavManager.NavigateTo($"/book/{Book.Id}");
        }
    }
}





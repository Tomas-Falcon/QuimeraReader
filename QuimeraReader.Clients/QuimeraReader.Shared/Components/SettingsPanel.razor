@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IQuimeraApiClient ApiClient
@namespace QuimeraReader.Shared.Components

<div class="settings-page">
    <div class="settings-sidebar">
        <ul class="nav-tabs">
            <li class="tab-item @(ActiveTab == "general" ? "active" : "")" @onclick='() => ActiveTab = "general"'>
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                General
            </li>
            <li class="tab-item @(ActiveTab == "apikeys" ? "active" : "")" @onclick='() => ActiveTab = "apikeys"'>
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                Integraciones (API)
            </li>
            <li class="tab-item @(ActiveTab == "tasks" ? "active" : "")" @onclick='() => ActiveTab = "tasks"'>
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                Tareas y Escaneo
            </li>
        </ul>
    </div>

    <div class="settings-content">
        <div class="settings-header">
            <h2>Configuración del Servidor</h2>
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="toast-message @(_isSuccess ? "success" : "error")">
                    @_message
                </div>
            }
        </div>

        @if (_isLoading)
        {
            <p>Cargando preferencias...</p>
        }
        else
        {
            @if (ActiveTab == "general")
            {
                <div class="card">
                    <h3>Carpetas del Servidor</h3>
                    <p class="text-muted">Define dónde buscará QuimeraReader los libros y cómo los importará.</p>
                    <hr />

                    <div class="form-group">
                        <label>Directorio de Origen (Descargas/Media)</label>
                        <input type="text" class="form-control" @bind="_libraryRootPath" placeholder="/media" />
                        <span class="help-text">Ruta donde caen los EPUBs o MP3 sueltos (Volumen montado en Docker).</span>
                    </div>

                    <div class="form-group">
                        <label>Modo de Importación</label>
                        <select class="form-control" @bind="_ingestionMode">
                            <option value="Move">Mover y Organizar (Ahorra Espacio)</option>
                            <option value="LeaveInPlace">Dejar en lugar original (Para Torrents)</option>
                        </select>
                        <span class="help-text">Si seleccionas mover, el archivo se pasará a /library y se ordenará por autor.</span>
                    </div>
                </div>
            }

            @if (ActiveTab == "apikeys")
            {
                <div class="card">
                    <h3>Inteligencia Artificial y Transcripción (Whisper)</h3>
                    <p class="text-muted">Configura cómo deseas ejecutar los modelos de Inteligencia Artificial.</p>
                    <hr />

                    <div class="form-group">
                        <label>Modo de Ejecución de Whisper</label>
                        <select class="form-control" @bind="_whisperMode">
                            <option value="LocalServer">Plug & Play: Ejecutar Whisper localmente en este Servidor</option>
                            <option value="ExternalApi">API Externa: Conectar a OpenAI o red local (Ollama / LLMStudio)</option>
                        </select>
                    </div>

                    @if (_whisperMode == "LocalServer")
                    {
                        <div class="card-inner-box">
                            <h4>Configuración Local (Whisper.net)</h4>
                            <p class="help-text mb-3">Se descargarán los pesos del modelo directamente al contenedor. Depende del CPU/GPU del servidor.</p>
                            
                            <div class="form-group">
                                <label>Ruta del Modelo Base (.bin)</label>
                                <div style="display: flex; gap: 8px;">
                                    <input type="text" class="form-control" @bind="_whisperModelPath" placeholder="ggml-base.bin" style="flex:1;" />
                                    <button class="btn-primary" @onclick="DownloadWhisperModelAsync" disabled="@_isDownloadingWhisper">
                                        @(_isDownloadingWhisper ? "Descargando..." : "Descargar Modelo Ahora")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card-inner-box">
                            <h4>Configuración API Externa</h4>
                            <p class="help-text mb-3">Conecta QuimeraReader a OpenAI o a un modelo Whisper alojado en otro servidor (ej. Ollama).</p>
                            
                            <div class="form-group">
                                <label>Endpoint URL (OpenAI API / Local Network)</label>
                                <input type="text" class="form-control" @bind="_openAiEndpoint" placeholder="https://api.openai.com/v1/" />
                            </div>
                            
                            <div class="form-group">
                                <label>API Key</label>
                                <input type="password" class="form-control" @bind="_openAiKey" placeholder="sk-..." />
                                <span class="help-text">Si usas un modelo en red local sin autenticación, puedes dejar esto vacío.</span>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="card mt-4">
                    <h3>Metadatos y Portadas</h3>
                    <hr />
                    <div class="form-group">
                        <label>Google Books API Key (Opcional)</label>
                        <input type="password" class="form-control" @bind="_googleBooksKey" placeholder="AIza..." />
                        <span class="help-text">Mejora la descarga de portadas en alta resolución. OpenLibrary se usa por defecto sin llave.</span>
                    </div>
                </div>
            }

            @if (ActiveTab == "tasks")
            {
                <div class="card">
                    <h3>Sincronización Manual</h3>
                    <p class="text-muted">Fuerza a los Background Workers a escanear en busca de nuevos libros ahora mismo.</p>
                    <hr />

                    <div class="tasks-panel">
                        @if (_scanStatus != null && _scanStatus.IsScanning)
                        {
                            var progress = _scanStatus.TotalFilesFound > 0 ? (int)((_scanStatus.FilesProcessed * 100.0) / _scanStatus.TotalFilesFound) : 0;
                            <div class="alert alert-info mb-4" style="border-radius: 8px;">
                                <h5>Escanéo en progreso...</h5>
                                <p class="mb-1 text-truncate">Procesando: @_scanStatus.CurrentFile</p>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                                        @_scanStatus.FilesProcessed / @_scanStatus.TotalFilesFound
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="task-info">
                            <strong>Escáner de Directorio</strong>
                            <span class="task-status @((_isScanning || (_scanStatus != null && _scanStatus.IsScanning)) ? "running" : "idle")">
                                @((_isScanning || (_scanStatus != null && _scanStatus.IsScanning)) ? "Escaneando..." : "Inactivo")
                            </span>
                        </div>
                        <button class="btn-primary" @onclick="TriggerScanAsync" disabled="@(_isScanning || (_scanStatus != null && _scanStatus.IsScanning))">
                            Escanear /media
                        </button>
                    </div>
                    
                    <div class="tasks-panel mt-3">
                        <div class="task-info">
                            <strong>Alineación de Audio a Texto (Whisper)</strong>
                            <span class="task-status idle">En pausa (0 en cola)</span>
                        </div>
                        <button class="btn-secondary" disabled>
                            Sincronizar Cola
                        </button>
                    </div>
                </div>
            }

            <div class="bottom-actions">
                <button class="btn-success" @onclick="SaveSettingsAsync" disabled="@_isSaving">
                    @(_isSaving ? "Guardando..." : "Guardar Todos los Cambios")
                </button>
            </div>
        }
    </div>
</div>



@implements IDisposable

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _message = string.Empty;
    private bool _isSuccess = false;
    private bool _isScanning = false;
    private ScanStatus? _scanStatus;
    private CancellationTokenSource _cts = new();

    public string ActiveTab { get; set; } = "general";

    private string _libraryRootPath = "/media";
    private string _ingestionMode = "Move";
    private string _openAiKey = string.Empty;
    private string _googleBooksKey = string.Empty;
    private string _whisperModelPath = "ggml-base.bin";
    private string _whisperMode = "LocalServer";
    private string _openAiEndpoint = "https://api.openai.com/v1/";
    private bool _isDownloadingWhisper = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await ApiClient.GetSettingsAsync();
            if (settings.TryGetValue("LibraryRootPath", out var path)) _libraryRootPath = path;
            if (settings.TryGetValue("IngestionMode", out var mode)) _ingestionMode = mode;
            if (settings.TryGetValue("OpenAIApiKey", out var openai)) _openAiKey = openai;
            if (settings.TryGetValue("GoogleBooksApiKey", out var gbooks)) _googleBooksKey = gbooks;
            if (settings.TryGetValue("WhisperModelPath", out var whisper)) _whisperModelPath = whisper;
            if (settings.TryGetValue("WhisperMode", out var wMode)) _whisperMode = wMode;
            if (settings.TryGetValue("OpenAIEndpoint", out var wEndpoint)) _openAiEndpoint = wEndpoint;
        }
        catch (Exception ex)
        {
            ShowMessage("Error cargando ajustes: " + ex.Message, false);
        }
        finally
        {
            _isLoading = false;
        }

        _ = PollStatusAsync();
    }

    private async Task PollStatusAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (ActiveTab == "tasks")
                {
                    _scanStatus = await ApiClient.GetScanStatusAsync();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "LibraryRootPath", Value = _libraryRootPath });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "IngestionMode", Value = _ingestionMode });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "OpenAIApiKey", Value = _openAiKey });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "GoogleBooksApiKey", Value = _googleBooksKey });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "WhisperModelPath", Value = _whisperModelPath });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "WhisperMode", Value = _whisperMode });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "OpenAIEndpoint", Value = _openAiEndpoint });
            
            ShowMessage("Ajustes guardados correctamente.", true);
        }
        catch (Exception ex)
        {
            ShowMessage("Error al guardar: " + ex.Message, false);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DownloadWhisperModelAsync()
    {
        _isDownloadingWhisper = true;
        _message = string.Empty;
        StateHasChanged();
        
        try
        {
            await ApiClient.DownloadWhisperModelAsync();
            ShowMessage("Modelo descargado con éxito.", true);
        }
        catch (Exception ex)
        {
            ShowMessage("Error al descargar: " + ex.Message, false);
        }
        finally
        {
            _isDownloadingWhisper = false;
            StateHasChanged();
        }
    }

    private async Task TriggerScanAsync()
    {
        _isScanning = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            var response = await ApiClient.TriggerScanAsync(new { FolderPath = _libraryRootPath });
            ShowMessage("El escáner se ha iniciado en segundo plano. Los libros aparecerán pronto en la biblioteca.", true);
        }
        catch (Exception ex)
        {
            ShowMessage($"Error al iniciar escaneo: {ex.Message}", false);
        }
        finally
        {
            _isScanning = false;
            StateHasChanged();
        }
    }

    private void ShowMessage(string message, bool isSuccess)
    {
        _message = message;
        _isSuccess = isSuccess;
    }
}

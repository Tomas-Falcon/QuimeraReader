@using QuimeraReader.Shared.Models
@inject QuimeraReader.Shared.Interfaces.ITranslationService TranslationService
@using QuimeraReader.Shared.Services




@namespace QuimeraReader.Shared.Components

<div class="container mt-4 mb-5">
    <RadzenCard class="mb-4 rz-background-color-transparent rz-border-radius-0" style="padding:0; border: none; background: transparent;">
        <h2 class="text-light fw-bold mb-0">@TranslationService["Settings_ServerConfig"]</h2>
    </RadzenCard>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="Radzen.ProgressBarMode.Indeterminate" Style="width: 200px" />
            <span class="ms-3 text-muted">@TranslationService["Settings_LoadingPreferences"]</span>
        </div>
    }
    else
    {
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="@TranslationService["Settings_General"]" Icon="settings">
                    <RadzenCard class="mb-4 bg-dark text-light border-secondary shadow-sm">
                        <h4 class="text-primary"><RadzenIcon Icon="folder" /> @TranslationService["Settings_ServerFolders"]</h4>
                        <p class="text-white-50 small mb-4">@TranslationService["Settings_ServerFoldersDesc"]</p>

                        <div class="mb-4">
                            <RadzenLabel Text="@TranslationService["Settings_SourceDirectory"]" class="fw-bold mb-2 d-block" />
                            <RadzenTextBox @bind-Value="_libraryRootPath" class="w-100 bg-secondary text-light border-0" />
                            <div class="form-text text-white-50 mt-1">@TranslationService["Settings_SourceDirectoryDesc"]</div>
                        </div>

                        <div class="mb-4">
                            <RadzenLabel Text="@TranslationService["Settings_OutputDirectory"]" class="fw-bold mb-2 d-block" />
                            <RadzenTextBox @bind-Value="_outgoingLibraryPath" class="w-100 bg-secondary text-light border-0" />
                            <div class="form-text text-white-50 mt-1">@TranslationService["Settings_OutputDirectoryDesc"]</div>
                        </div>

                        <div class="mb-2">
                            <RadzenLabel Text="@TranslationService["Settings_ImportMode"]" class="fw-bold mb-2 d-block" />
                            <RadzenDropDown @bind-Value="_ingestionMode" Data="@_ingestionModes" TextProperty="Text" ValueProperty="Value" class="w-100 bg-secondary text-light border-0" />
                            <div class="form-text text-white-50 mt-1">@TranslationService["Settings_ImportModeDesc"]</div>
                        </div>
                    </RadzenCard>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@TranslationService["Settings_IntegrationsAPI"]" Icon="api">
                    <RadzenCard class="mb-4 bg-dark text-light border-secondary shadow-sm">
                        <h4 class="text-primary"><RadzenIcon Icon="smart_toy" /> @TranslationService["Settings_AIAndTranscription"]</h4>
                        <p class="text-white-50 small mb-4">@TranslationService["Settings_AIAndTranscriptionDesc"]</p>

                        <div class="mb-4">
                            <RadzenLabel Text="@TranslationService["Settings_WhisperExecutionMode"]" class="fw-bold mb-2 d-block" />
                            <RadzenDropDown @bind-Value="_whisperMode" Data="@_whisperModes" TextProperty="Text" ValueProperty="Value" class="w-100 mb-3 bg-secondary text-light border-0" />

                            @if (_whisperMode == "LocalServer")
                            {
                                <div class="p-3 bg-secondary rounded mt-2">
                                    <h6 class="fw-bold"><RadzenIcon Icon="dns" /> @TranslationService["Settings_LocalConfigWhisper"]</h6>
                                    <p class="text-white-50 small">@TranslationService["Settings_LocalConfigWhisperDesc"]</p>
                                    <div class="mb-3">
                                        <RadzenLabel Text="@TranslationService["Settings_BaseModelPath"]" class="small d-block mb-1" />
                                        <div class="d-flex gap-2">
                                            <RadzenTextBox @bind-Value="_whisperModelPath" class="flex-grow-1 bg-dark text-light border-0" />
                                            <RadzenButton Text="@TranslationService["Settings_DownloadNow"]" Click="DownloadWhisperModelAsync" IsBusy="@_isDownloadingWhisper" ButtonStyle="Radzen.ButtonStyle.Primary" Variant="Radzen.Variant.Outlined" />
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 bg-secondary rounded mt-2">
                                    <h6 class="fw-bold"><RadzenIcon Icon="cloud" /> @TranslationService["Settings_ExternalAPIConfig"]</h6>
                                    <p class="text-white-50 small">@TranslationService["Settings_ExternalAPIConfigDesc"]</p>
                                    <div class="mb-3">
                                        <RadzenLabel Text="@TranslationService["Settings_EndpointURL"]" class="small d-block mb-1" />
                                        <RadzenTextBox @bind-Value="_openAiEndpoint" class="w-100 bg-dark text-light border-0" />
                                    </div>
                                    <div class="mb-3">
                                        <RadzenLabel Text="@TranslationService["Settings_APIKey"]" class="small d-block mb-1" />
                                        <RadzenPassword @bind-Value="_openAiKey" class="w-100 bg-dark text-light border-0" />
                                    </div>
                                </div>
                            }
                        </div>
                    </RadzenCard>

                    <RadzenCard class="mb-4 bg-dark text-light border-secondary shadow-sm">
                        <h4 class="text-primary"><RadzenIcon Icon="auto_awesome" /> @TranslationService["Settings_MetadataAndCovers"]</h4>
                        <p class="text-white-50 small mb-4">@TranslationService["Settings_MetadataAndCoversDesc"]</p>
                        
                        <div class="mb-4">
                            <RadzenLabel Text="@TranslationService["Settings_GoogleBooksAPIKey"]" class="fw-bold mb-2 d-block" />
                            <RadzenPassword @bind-Value="_googleBooksKey" class="w-100 bg-secondary text-light border-0" />
                        </div>
                        
                        <div class="mb-3">
                            <RadzenLabel Text="@TranslationService["Settings_HardcoverAPIKey"]" class="fw-bold mb-2 d-block" />
                            <RadzenPassword @bind-Value="_hardcoverKey" class="w-100 mb-2 bg-secondary text-light border-0" />
                            
                            <div class="d-flex align-items-center mt-3">
                                <RadzenSwitch @bind-Value="_hardcoverSyncEnabled" Name="hardcoverSyncCheck" />
                                <RadzenLabel Text="@TranslationService["Settings_HardcoverSync"]" Component="hardcoverSyncCheck" class="ms-2 fw-bold" />
                            </div>
                        </div>
                    </RadzenCard>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@TranslationService["Settings_TasksAndScanning"]" Icon="checklist">
                    <RadzenCard class="mb-4 bg-dark text-light border-secondary shadow-sm">
                        <h4 class="text-primary"><RadzenIcon Icon="build" /> @TranslationService["Settings_ManualSync"]</h4>
                        <p class="text-white-50 small mb-4">@TranslationService["Settings_ManualSyncDesc"]</p>
                        
                        @if (_scanStatus != null && _scanStatus.IsScanning)
                        {
                            var progress = _scanStatus.TotalFilesFound > 0 ? (int)((_scanStatus.FilesProcessed * 100.0) / _scanStatus.TotalFilesFound) : 0;
                            <div class="alert alert-primary mb-4" style="border-radius: 8px; border: 1px solid var(--bs-primary);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0 fw-bold"><RadzenIcon Icon="search" /> @TranslationService["Settings_ScanInProgress"]</h5>
                                    <RadzenButton Text="@TranslationService["Button_Cancel"]" Click="CancelScanAsync" ButtonStyle="Radzen.ButtonStyle.Danger" Size="Radzen.ButtonSize.Small" Variant="Radzen.Variant.Outlined" />
                                </div>
                                <p class="mb-3 text-truncate small">@TranslationService["Settings_Processing"] <strong>@_scanStatus.CurrentFile</strong></p>
                                <RadzenProgressBar Value="@progress" ShowValue="true" />
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center border-bottom border-secondary py-3">
                            <div>
                                <h6 class="mb-1 fw-bold">@TranslationService["Settings_ScanBaseDirectory"]</h6>
                                <p class="mb-0 text-white-50 small">@TranslationService["Settings_ScanBaseDirectoryDesc"]</p>
                            </div>
                            <RadzenButton Text="@TranslationService["Settings_Start"]" Icon="play_arrow" Click="TriggerScanAsync" Disabled="@(_scanStatus?.IsScanning == true || _isScanning)" ButtonStyle="Radzen.ButtonStyle.Primary" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom border-secondary py-3">
                            <div>
                                <h6 class="mb-1 fw-bold">@TranslationService["Settings_MetadataRepair"]</h6>
                                <p class="mb-0 text-white-50 small">@TranslationService["Settings_MetadataRepairDesc"]</p>
                            </div>
                            <RadzenButton Text="@TranslationService["Settings_Complete"]" Icon="cloud_download" Click="RescanMetadataAsync" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Outlined" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom border-secondary py-3">
                            <div>
                                <h6 class="mb-1 fw-bold">@TranslationService["Settings_DuplicateCleanup"]</h6>
                                <p class="mb-0 text-white-50 small">@TranslationService["Settings_DuplicateCleanupDesc"]</p>
                            </div>
                            <RadzenButton Text="@TranslationService["Settings_Merge"]" Icon="auto_fix_high" Click="MergeDuplicatesAsync" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Outlined" />
                        </div>
                    </RadzenCard>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        <div class="d-flex justify-content-end mt-4">
            <RadzenButton Text="@TranslationService["Settings_SaveAllChanges"]" Icon="save" Click="SaveSettingsAsync" IsBusy="@_isSaving" ButtonStyle="Radzen.ButtonStyle.Success" Size="Radzen.ButtonSize.Large" class="px-5 shadow" />
        </div>
    }
</div>

@implements IDisposable


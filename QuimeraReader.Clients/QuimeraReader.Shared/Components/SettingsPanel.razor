@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IQuimeraApiClient ApiClient
@inject ToastService ToastService
@namespace QuimeraReader.Shared.Components

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 mb-4">
            <div class="list-group shadow-sm" style="border-radius: 12px; overflow: hidden;">
                <button class="list-group-item list-group-item-action @(ActiveTab == "general" ? "active bg-primary border-primary" : "bg-dark text-light border-secondary")" @onclick='() => ActiveTab = "general"'>
                    <i class="bi bi-gear-fill me-2"></i> General
                </button>
                <button class="list-group-item list-group-item-action @(ActiveTab == "apikeys" ? "active bg-primary border-primary" : "bg-dark text-light border-secondary")" @onclick='() => ActiveTab = "apikeys"'>
                    <i class="bi bi-cpu-fill me-2"></i> Integraciones (API)
                </button>
                <button class="list-group-item list-group-item-action @(ActiveTab == "tasks" ? "active bg-primary border-primary" : "bg-dark text-light border-secondary")" @onclick='() => ActiveTab = "tasks"'>
                    <i class="bi bi-list-task me-2"></i> Tareas y Escaneo
                </button>
            </div>
        </div>

        <!-- Content -->
        <div class="col-md-9">
            <div class="card bg-transparent border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h2 class="text-light fw-bold">Configuración del Servidor</h2>
                </div>

                <div class="card-body">
                    @if (_isLoading)
                    {
                        <div class="d-flex justify-content-center align-items-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <span class="ms-3 text-muted">Cargando preferencias...</span>
                        </div>
                    }
                    else
                    {
                        @if (ActiveTab == "general")
                        {
                            <div class="card bg-dark text-light border-secondary shadow-sm mb-4" style="border-radius: 12px;">
                                <div class="card-body p-4">
                                    <h4 class="card-title text-primary"><i class="bi bi-folder-fill me-2"></i> Carpetas del Servidor</h4>
                                    <p class="text-white-50 small mb-4">Define dónde buscará QuimeraReader los libros y cómo los importará.</p>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Directorio de Origen (Descargas/Media)</label>
                                        <input type="text" class="form-control bg-secondary text-light border-0" @bind="_libraryRootPath" placeholder="/media" />
                                        <div class="form-text text-white-50">Ruta donde caen los EPUBs o MP3 sueltos (Volumen montado en Docker).</div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Directorio de Salida (Librería Organizada)</label>
                                        <input type="text" class="form-control bg-secondary text-light border-0" @bind="_outgoingLibraryPath" placeholder="/library" />
                                        <div class="form-text text-white-50">Ruta donde se guardarán y organizarán los libros y carátulas (ej: /app/media/books o C:\MisLibros).</div>
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label fw-bold">Modo de Importación</label>
                                        <select class="form-select bg-secondary text-light border-0" @bind="_ingestionMode">
                                            <option value="Move">Mover y Organizar (Ahorra Espacio)</option>
                                            <option value="LeaveInPlace">Dejar en lugar original (Para Torrents - Crea Enlaces/Symlinks)</option>
                                        </select>
                                        <div class="form-text text-white-50">Si seleccionas mover, el archivo se pasará a /library y se ordenará por autor. Si seleccionas Dejar, se crearán Symlinks.</div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (ActiveTab == "apikeys")
                        {
                            <div class="card bg-dark text-light border-secondary shadow-sm mb-4" style="border-radius: 12px;">
                                <div class="card-body p-4">
                                    <h4 class="card-title text-primary"><i class="bi bi-robot me-2"></i> Inteligencia Artificial y Transcripción (Whisper)</h4>
                                    <p class="text-white-50 small mb-4">Configura cómo deseas ejecutar los modelos de Inteligencia Artificial para sincronizar texto y audio.</p>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Modo de Ejecución de Whisper</label>
                                        <select class="form-select bg-secondary text-light border-0 mb-3" @bind="_whisperMode">
                                            <option value="LocalServer">Plug & Play: Ejecutar Whisper localmente en este Servidor</option>
                                            <option value="ExternalApi">API Externa: Conectar a OpenAI o red local (Ollama / LLMStudio)</option>
                                        </select>

                                        @if (_whisperMode == "LocalServer")
                                        {
                                            <div class="p-3 bg-secondary rounded mt-2">
                                                <h6 class="fw-bold"><i class="bi bi-hdd-network-fill me-2"></i> Configuración Local (Whisper.net)</h6>
                                                <p class="text-white-50 small">Se descargarán los pesos del modelo directamente al contenedor. Depende del CPU/GPU del servidor.</p>
                                                
                                                <label class="form-label small">Ruta del Modelo Base (.bin)</label>
                                                <div class="input-group">
                                                    <input type="text" class="form-control bg-dark text-light border-0" @bind="_whisperModelPath" placeholder="ggml-base.bin" />
                                                    <button class="btn btn-outline-primary" @onclick="DownloadWhisperModelAsync" disabled="@_isDownloadingWhisper">
                                                        @if (_isDownloadingWhisper) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                        @(_isDownloadingWhisper ? "Descargando..." : "Descargar Ahora")
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-3 bg-secondary rounded mt-2">
                                                <h6 class="fw-bold"><i class="bi bi-cloud-arrow-up-fill me-2"></i> Configuración API Externa</h6>
                                                <p class="text-white-50 small">Conecta QuimeraReader a OpenAI o a un modelo alojado en otro servidor (ej. Ollama).</p>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label small">Endpoint URL (OpenAI API / Local Network)</label>
                                                    <input type="text" class="form-control bg-dark text-light border-0" @bind="_openAiEndpoint" placeholder="https://api.openai.com/v1/" />
                                                </div>
                                                
                                                <div>
                                                    <label class="form-label small">API Key</label>
                                                    <input type="password" class="form-control bg-dark text-light border-0" @bind="_openAiKey" placeholder="sk-..." />
                                                    <div class="form-text text-white-50">Si usas un modelo en red local sin autenticación, déjalo vacío.</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card bg-dark text-light border-secondary shadow-sm mb-4" style="border-radius: 12px;">
                                <div class="card-body p-4">
                                    <h4 class="card-title text-primary"><i class="bi bi-tags-fill me-2"></i> Metadatos y Portadas</h4>
                                    <p class="text-white-50 small mb-4">Mejora la calidad de la biblioteca conectando con bases de datos externas.</p>
                                    
                                    <div>
                                        <label class="form-label fw-bold">Google Books API Key (Opcional)</label>
                                        <input type="password" class="form-control bg-secondary text-light border-0" @bind="_googleBooksKey" placeholder="AIza..." />
                                        <div class="form-text text-white-50">Mejora la descarga de portadas en alta resolución. QuimeraReader usará Google Books (sin key) o OpenLibrary por defecto.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Hardcover API Key (GraphQL)</label>
                                        <input type="password" class="form-control bg-secondary text-light border-0 mb-2" @bind="_hardcoverKey" placeholder="Token de acceso personal..." />
                                        
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" id="hardcoverSyncCheck" @bind="_hardcoverSyncEnabled">
                                            <label class="form-check-label fw-bold" for="hardcoverSyncCheck">Sincronización de mi contenido (Hardcover)</label>
                                        </div>
                                        <div class="form-text text-white-50">
                                            Si está activado, QuimeraReader actualizará tu progreso de lectura y marcará los libros como leídos en tu cuenta de Hardcover.app automáticamente. Si está desactivado, el Token solo se usará para descargar metadatos de la tienda.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (ActiveTab == "tasks")
                        {
                            <div class="card bg-dark text-light border-secondary shadow-sm mb-4" style="border-radius: 12px;">
                                <div class="card-body p-4">
                                    <h4 class="card-title text-primary"><i class="bi bi-arrow-repeat me-2"></i> Sincronización Manual</h4>
                                    <p class="text-white-50 small mb-4">Fuerza a los Background Workers a ejecutar tareas de mantenimiento ahora mismo.</p>

                                    @if (_scanStatus != null && _scanStatus.IsScanning)
                                    {
                                        var progress = _scanStatus.TotalFilesFound > 0 ? (int)((_scanStatus.FilesProcessed * 100.0) / _scanStatus.TotalFilesFound) : 0;
                                        <div class="alert alert-primary mb-4" style="border-radius: 8px; border: 1px solid var(--bs-primary);">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h5 class="mb-0 fw-bold"><i class="bi bi-search me-2"></i> Escaneo en progreso...</h5>
                                                <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="CancelScanAsync">Cancelar</button>
                                            </div>
                                            <p class="mb-3 text-truncate small">Procesando: <strong>@_scanStatus.CurrentFile</strong></p>
                                            <div class="progress bg-secondary" style="height: 24px; position: relative; border-radius: 12px; overflow: hidden;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                                <div class="text-center w-100 position-absolute fw-bold" style="line-height: 24px; color: white; z-index: 10; text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                                                    @_scanStatus.FilesProcessed / @_scanStatus.TotalFilesFound (@progress%)
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="list-group bg-transparent">
                                        <div class="list-group-item bg-transparent border-secondary text-light d-flex justify-content-between align-items-center py-3 px-0">
                                            <div>
                                                <h6 class="mb-1 fw-bold">Escanear Directorio Base</h6>
                                                <p class="mb-0 text-white-50 small">Busca nuevos archivos EPUB y MP3 en el volumen montado.</p>
                                            </div>
                                            <button class="btn btn-primary rounded-pill px-4" @onclick="TriggerScanAsync" disabled="@(_scanStatus?.IsScanning == true || _isScanning)">
                                                <i class="bi bi-play-fill me-1"></i> Iniciar
                                            </button>
                                        </div>

                                        <div class="list-group-item bg-transparent border-secondary text-light d-flex justify-content-between align-items-center py-3 px-0">
                                            <div>
                                                <h6 class="mb-1 fw-bold">Reparación de Metadatos</h6>
                                                <p class="mb-0 text-white-50 small">Busca portadas y sinopsis faltantes en Google Books y OpenLibrary.</p>
                                            </div>
                                            <button class="btn btn-outline-light rounded-pill px-4" @onclick="RescanMetadataAsync">
                                                <i class="bi bi-cloud-download me-1"></i> Completar
                                            </button>
                                        </div>

                                        <div class="list-group-item bg-transparent border-secondary text-light d-flex justify-content-between align-items-center py-3 px-0">
                                            <div>
                                                <h6 class="mb-1 fw-bold">Limpieza de Duplicados</h6>
                                                <p class="mb-0 text-white-50 small">Fusiona autores y categorías que se hayan guardado múltiples veces.</p>
                                            </div>
                                            <button class="btn btn-outline-light rounded-pill px-4" @onclick="MergeDuplicatesAsync">
                                                <i class="bi bi-magic me-1"></i> Fusionar
                                            </button>
                                        </div>
                                        
                                        <div class="list-group-item bg-transparent border-secondary text-light d-flex justify-content-between align-items-center py-3 px-0">
                                            <div>
                                                <h6 class="mb-1 fw-bold">Alineación de Audio a Texto (Background Job)</h6>
                                                <p class="mb-0 text-white-50 small">Sincroniza automáticamente MP3 y EPUBs en segundo plano si Whisper está configurado.</p>
                                            </div>
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i> Activo
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-end mt-2">
                            <button class="btn btn-success btn-lg rounded-pill px-5 shadow-sm fw-bold" @onclick="SaveSettingsAsync" disabled="@_isSaving">
                                @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                @(_isSaving ? "Guardando..." : "Guardar Todos los Cambios")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@implements IDisposable

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _message = string.Empty;
    private bool _isSuccess = false;
    private bool _isScanning = false;
    private ScanStatus? _scanStatus;
    private CancellationTokenSource _cts = new();

    public string ActiveTab { get; set; } = "general";

    private string _libraryRootPath = "/media";
    private string _outgoingLibraryPath = "/app/media/books";
    private string _ingestionMode = "Move";
    private string _openAiKey = string.Empty;
    private string _googleBooksKey = string.Empty;
    private string _hardcoverKey = string.Empty;
    private bool _hardcoverSyncEnabled = false;
    private string _whisperModelPath = "ggml-base.bin";
    private string _whisperMode = "LocalServer";
    private string _openAiEndpoint = "https://api.openai.com/v1/";
    private bool _isDownloadingWhisper = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await ApiClient.GetSettingsAsync();
            if (settings.TryGetValue("IncomingScanFolder", out var incoming)) _libraryRootPath = incoming;
            if (settings.TryGetValue("LibraryRootPath", out var outgoing)) _outgoingLibraryPath = outgoing;
            if (settings.TryGetValue("IngestionMode", out var mode)) _ingestionMode = mode;
            if (settings.TryGetValue("OpenAIApiKey", out var openai)) _openAiKey = openai;
            if (settings.TryGetValue("GoogleBooksApiKey", out var gbooks)) _googleBooksKey = gbooks;
            if (settings.TryGetValue("HardcoverApiKey", out var hardcover)) _hardcoverKey = hardcover;
            if (settings.TryGetValue("HardcoverSyncEnabled", out var hSync)) _hardcoverSyncEnabled = bool.TryParse(hSync, out var b) && b;
            if (settings.TryGetValue("WhisperModelPath", out var whisper)) _whisperModelPath = whisper;
            if (settings.TryGetValue("WhisperMode", out var wMode)) _whisperMode = wMode;
            if (settings.TryGetValue("OpenAIEndpoint", out var wEndpoint)) _openAiEndpoint = wEndpoint;
        }
        catch (Exception ex)
        {
            ShowMessage("Error cargando ajustes: " + ex.Message, false);
        }
        finally
        {
            _isLoading = false;
        }

        _ = PollStatusAsync();
    }

    private async Task PollStatusAsync()
    {
        try
        {
            while (!_cts.Token.IsCancellationRequested)
            {
                await Task.Delay(2000, _cts.Token);
                if (ActiveTab == "tasks")
                {
                    _scanStatus = await ApiClient.GetScanStatusAsync();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "IncomingScanFolder", Value = _libraryRootPath });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "LibraryRootPath", Value = _outgoingLibraryPath });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "IngestionMode", Value = _ingestionMode });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "OpenAIApiKey", Value = _openAiKey });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "GoogleBooksApiKey", Value = _googleBooksKey });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "HardcoverApiKey", Value = _hardcoverKey });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "HardcoverSyncEnabled", Value = _hardcoverSyncEnabled.ToString() });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "WhisperModelPath", Value = _whisperModelPath });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "WhisperMode", Value = _whisperMode });
            await ApiClient.SaveSettingAsync(new SystemSetting { Key = "OpenAIEndpoint", Value = _openAiEndpoint });
            
            ShowMessage("Ajustes guardados correctamente.", true);
        }
        catch (Exception ex)
        {
            ShowMessage("Error al guardar: " + ex.Message, false);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DownloadWhisperModelAsync()
    {
        _isDownloadingWhisper = true;
        _message = string.Empty;
        StateHasChanged();
        
        try
        {
            await ApiClient.DownloadWhisperModelAsync();
            ShowMessage("Modelo descargado con éxito.", true);
        }
        catch (Exception ex)
        {
            ShowMessage("Error al descargar: " + ex.Message, false);
        }
        finally
        {
            _isDownloadingWhisper = false;
            StateHasChanged();
        }
    }

    private async Task TriggerScanAsync()
    {
        _isScanning = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            var response = await ApiClient.TriggerScanAsync(new { FolderPath = _libraryRootPath });
            ShowMessage("El escáner se ha iniciado en segundo plano. Los libros aparecerán pronto en la biblioteca.", true);
        }
        catch (Exception ex)
        {
            ShowMessage($"Error al iniciar escaneo: {ex.Message}", false);
        }
        finally
        {
            _isScanning = false;
            StateHasChanged();
        }
    }

    private async Task CancelScanAsync()
    {
        try
        {
            await ApiClient.CancelScanAsync();
            ShowMessage("Escaneo cancelado.", true);
            if (_scanStatus != null) _scanStatus.IsScanning = false;
            _isScanning = false;
        }
        catch (Exception ex)
        {
            ShowMessage("Error cancelando el escaneo: " + ex.Message, false);
        }
    }

    private async Task RescanMetadataAsync()
    {
        try
        {
            await ApiClient.RescanMetadataAsync();
            ShowMessage("Se ha iniciado la búsqueda de metadatos en segundo plano.", true);
        }
        catch (Exception ex)
        {
            ShowMessage("Error al buscar metadatos: " + ex.Message, false);
        }
    }

    private async Task MergeDuplicatesAsync()
    {
        try
        {
            await ApiClient.MergeDuplicatesAsync();
            ShowMessage("Mantenimiento de duplicados completado exitosamente.", true);
        }
        catch (Exception ex)
        {
            ShowMessage("Error al fusionar duplicados: " + ex.Message, false);
        }
    }

    private void ShowMessage(string message, bool isSuccess)
    {
        if (isSuccess)
        {
            ToastService.ShowSuccess(message);
        }
        else
        {
            ToastService.ShowError(message);
        }
    }
}

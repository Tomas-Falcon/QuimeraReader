@page "/authors"
@using QuimeraReader.Domain.Entities
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Components
@inject QuimeraReader.Shared.Services.IQuimeraApiClient ApiClient

<PageTitle>Autores</PageTitle>

<div class="card p-4 mt-4 bg-transparent border-0">
    <h2 class="mb-4"><span class="bi bi-people-fill text-primary"></span> Autores</h2>

    @if (authors == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando autores...</p>
        </div>
    }
    else if (!authors.Any())
    {
        <div class="alert alert-info">No se encontraron autores en la base de datos.</div>
    }
    else
    {
        <div class="accordion" id="authorsAccordion">
            @foreach (var author in authors)
            {
                var targetId = $"collapseAuthor_{author.Id}";
                var headingId = $"headingAuthor_{author.Id}";
                var isOpen = _expandedAuthorId == author.Id;

                <div class="accordion-item bg-dark border-secondary mb-3" style="border-radius: 12px; overflow: hidden;">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button @(isOpen ? "" : "collapsed") bg-transparent text-light" type="button" @onclick="() => ToggleAuthor(author)">
                            <div class="d-flex align-items-center gap-3 w-100">
                                @if (!string.IsNullOrEmpty(author.SampleCoverUrl))
                                {
                                    <img src="@author.SampleCoverUrl" alt="Sample cover" style="width: 40px; height: 60px; object-fit: cover; border-radius: 4px;" />
                                }
                                else
                                {
                                    <div class="bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 60px; border-radius: 4px;">
                                        <i class="bi bi-person text-white-50"></i>
                                    </div>
                                }
                                <div class="d-flex flex-column text-start">
                                    <span class="fs-5 fw-bold">@author.Name</span>
                                    <span class="text-white-50 small">@author.BookCount libros</span>
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@targetId" class="accordion-collapse collapse @(isOpen ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#authorsAccordion">
                        <div class="accordion-body">
                            @if (isOpen)
                            {
                                @if (_authorBooks == null)
                                {
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary"></div>
                                    </div>
                                }
                                else if (!_authorBooks.Any())
                                {
                                    <p class="text-muted">No se encontraron libros de este autor.</p>
                                }
                                else
                                {
                                    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
                                        @foreach (var book in _authorBooks)
                                        {
                                            <div class="col">
                                                <a href="/book/@book.Id" class="text-decoration-none">
                                                    <div class="card h-100 bg-transparent border-0 book-card-hover">
                                                        <img src="@book.CoverUrl" class="card-img-top rounded shadow-sm" style="aspect-ratio: 2/3; object-fit: cover;" onerror="this.outerHTML='<div class=\'placeholder-cover shadow-sm rounded d-flex align-items-center justify-content-center\' style=\'aspect-ratio:2/3;background:#333;color:#888;font-size:0.8rem;text-align:center;padding:5px;\'><span>Sin Portada</span></div>'" />
                                                        <div class="card-body p-2 text-center">
                                                            <p class="card-title text-light small mb-0 fw-bold text-truncate" title="@book.Title">@book.Title</p>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .accordion-button:focus { box-shadow: none; }
    .accordion-button:not(.collapsed) { background-color: rgba(255,255,255,0.05) !important; color: white; }
    .accordion-button::after { filter: invert(1); }
    .book-card-hover { transition: transform 0.2s ease, opacity 0.2s; }
    .book-card-hover:hover { transform: scale(1.03); opacity: 0.9; }
</style>

@code {
    private IEnumerable<Author>? authors;
    private int? _expandedAuthorId = null;
    private List<Book>? _authorBooks = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            authors = await ApiClient.GetAuthorsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando autores: {ex.Message}");
            authors = Array.Empty<Author>();
        }
    }

    private async Task ToggleAuthor(Author author)
    {
        if (_expandedAuthorId == author.Id)
        {
            _expandedAuthorId = null;
            _authorBooks = null;
        }
        else
        {
            _expandedAuthorId = author.Id;
            _authorBooks = null;
            StateHasChanged();

            try
            {
                var result = await ApiClient.GetBooksAsync(1, 100, author.Name);
                _authorBooks = result.Items.ToList();
            }
            catch
            {
                _authorBooks = new List<Book>();
            }
        }
    }
}

@page "/book/{Id:int}"
@using QuimeraReader.Shared.Models
@using QuimeraReader.Shared.Services
@inject IQuimeraApiClient ApiClient
@inject NavigationManager NavManager
@inject IToastService ToastService
@inject IJSRuntime JS

<PageTitle>Detalles del Libro</PageTitle>

@if (_isLoading)
{
    <div class="loading-state text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">Cargando detalles...</p>
    </div>
}
else if (_book == null)
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-exclamation-circle text-danger mb-3" style="font-size: 3rem;"></i>
        <p>No se pudo encontrar el libro.</p>
        <button class="btn btn-primary mt-3" @onclick="GoBack">Volver a la Biblioteca</button>
    </div>
}
else
{
    <div class="book-details-hero">
        <!-- Background Blur effect similar to Spotify/Reader -->
        <div class="hero-bg" style="background-image: url('@_book.CoverUrl');"></div>
        <div class="hero-overlay"></div>

        <div class="container position-relative" style="z-index: 10; padding-top: 2rem; padding-bottom: 3rem;">
            <div class="mb-4">
                <button class="btn btn-link text-white text-decoration-none px-0" @onclick="GoBack" style="font-size: 1.1rem; opacity: 0.9;">
                    <i class="bi bi-arrow-left me-2"></i> Volver a la Biblioteca
                </button>
            </div>

            <div class="d-flex flex-column flex-md-row gap-5 align-items-center align-items-md-start">
                <!-- Cover -->
                <div class="cover-section" style="flex: 0 0 auto; width: 100%; max-width: 300px;">
                    <img src="@_book.CoverUrl" alt="Portada" class="img-fluid rounded shadow-lg" style="width: 100%;" onerror="this.outerHTML='<div class=\'placeholder-cover shadow-lg rounded d-flex align-items-center justify-content-center\' style=\'width:100%;aspect-ratio:2/3;background:#2a2a2a;color:#888;\'><span>Sin Portada</span></div>'" />
                </div>
                
                <!-- Metadata -->
                <div class="info-section text-white mt-3 mt-md-0" style="flex: 1;">
                    <h1 class="display-5 fw-bold mb-2">@_book.Title</h1>
                    
                    @if (_book.Authors.Any())
                    {
                        <h4 class="text-white-50 mb-3">@string.Join(", ", _book.Authors)</h4>
                    }

                    @if (!string.IsNullOrEmpty(_book.Series))
                    {
                        <h5 class="text-warning mb-3"><i class="bi bi-collection"></i> Saga: @_book.Series</h5>
                    }

                    @if (_book.Categories.Any())
                    {
                        <div class="mb-4 d-flex gap-2 flex-wrap">
                            @foreach(var cat in _book.Categories)
                            {
                                <a href="/?q=@(Uri.EscapeDataString(cat))" class="badge bg-secondary rounded-pill px-3 py-2 text-decoration-none text-white">@cat</a>
                            }
                        </div>
                    }
                    
                    <div class="badges mb-4 d-flex gap-2 flex-wrap align-items-center">
                        @if (_book.AverageRating.HasValue && _book.AverageRating.Value > 0)
                        {
                            <span class="badge bg-warning text-dark fs-6" title="Puntuación Media">
                                <i class="bi bi-star-fill"></i> @_book.AverageRating.Value.ToString("0.0")
                            </span>
                        }
                        @if (_book.HasEpub)
                        {
                            <span class="badge bg-primary fs-6"><i class="bi bi-book"></i> Ebook</span>
                        }
                        @if (_book.HasAudio)
                        {
                            <span class="badge bg-success fs-6"><i class="bi bi-headphones"></i> Audiobook</span>
                        }
                        @if (_book.IsAligned)
                        {
                            <span class="badge bg-info text-dark fs-6"><i class="bi bi-stars"></i> Sincronizado</span>
                        }
                    </div>
                    
                    @if (!string.IsNullOrWhiteSpace(_book.Description))
                    {
                        <div class="description-box p-4 rounded mb-4" style="background-color: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1);">
                            <p class="lead mb-0" style="white-space: pre-wrap; font-size: 1.1rem; line-height: 1.6;">@_book.Description</p>
                        </div>
                    }
                    else
                    {
                        <p class="text-white-50 fst-italic mb-4">No hay sinopsis disponible para este libro.</p>
                    }
                    
                    <div class="reading-progress-section mt-4 mb-2" style="max-width: 400px;">
                        @if (_book.PercentageCompleted.HasValue && _book.PercentageCompleted.Value > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-white-50 small fw-bold">PROGRESO DE LECTURA</span>
                                <span class="text-primary fw-bold">@Math.Round(_book.PercentageCompleted.Value, 1)%</span>
                            </div>
                            <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @Math.Round(_book.PercentageCompleted.Value)%;" aria-valuenow="@Math.Round(_book.PercentageCompleted.Value)" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        }
                    </div>

                    <div class="actions mt-3 d-flex gap-3 flex-wrap">
                        @if (!_book.HasEpub && !_book.HasAudio)
                        {
                            <button class="btn btn-lg btn-secondary px-5 py-3 rounded-pill fw-bold" disabled>
                                <i class="bi bi-slash-circle me-2"></i> Archivo no disponible
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-lg btn-primary px-5 py-3 rounded-pill fw-bold shadow-sm" @onclick="GoToRead" style="transition: transform 0.2s;">
                                @if (_book.PercentageCompleted.HasValue && _book.PercentageCompleted.Value > 0)
                                {
                                    <i class="bi bi-play-circle-fill me-2 fs-5"></i> @("Continuar lectura")
                                }
                                else
                                {
                                    <i class="bi bi-play-circle-fill me-2 fs-5"></i> @("Empezar a leer")
                                }
                            </button>
                        }
                        
                        <button class="btn btn-lg btn-outline-light px-4 py-3 rounded-pill fw-bold shadow-sm" @onclick="FetchSingleMetadataAsync" disabled="@_isFetchingMetadata" style="transition: transform 0.2s;">
                            @if (_isFetchingMetadata)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> <span>Buscando...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-download me-2 fs-5"></i> <span>Buscar metadatos</span>
                            }
                        </button>
                    </div>

                    <div class="mt-4 pt-4" style="border-top: 1px solid rgba(255,255,255,0.1);">
                        <h6 class="text-white-50 mb-3"><i class="bi bi-gear me-2"></i> Gestión de archivos</h6>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (_book.HasEpub)
                            {
                                <button class="btn btn-sm btn-outline-danger px-3 rounded-pill" @onclick="DeleteEpubAsync">
                                    <i class="bi bi-trash me-1"></i> Borrar EPUB
                                </button>
                            }
                            @if (_book.HasAudio)
                            {
                                <button class="btn btn-sm btn-outline-danger px-3 rounded-pill" @onclick="DeleteAudioAsync">
                                    <i class="bi bi-trash me-1"></i> Borrar Audio
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .book-details-hero {
        position: relative;
        min-height: calc(100vh - 60px);
        margin: -1.5rem; /* Negate the padding from article content to bleed to edges */
        overflow: hidden;
        background-color: #121212;
    }
    .hero-bg {
        position: absolute;
        top: -5%; left: -5%; right: -5%; bottom: -5%;
        background-size: cover;
        background-position: center;
        filter: blur(40px) brightness(0.6);
        z-index: 1;
    }
    .hero-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to bottom, rgba(18,18,18,0.2) 0%, rgba(18,18,18,0.9) 100%);
        z-index: 2;
    }
    .btn-primary:hover {
        transform: scale(1.05);
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }
    
    private Book? _book;
    private bool _isLoading = true;
    private bool _isFetchingMetadata = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookAsync();
    }
    
    private async Task LoadBookAsync()
    {
        _isLoading = true;
        _book = await ApiClient.GetBookAsync(Id);
        _isLoading = false;
        StateHasChanged();
    }
    
    private async Task FetchSingleMetadataAsync()
    {
        _isFetchingMetadata = true;
        StateHasChanged();
        
        try
        {
            await ApiClient.RescanSingleBookMetadataAsync(Id);
            // Refresh book details to show the new metadata
            await LoadBookAsync();
            ToastService.ShowSuccess("Metadatos actualizados correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar metadatos: {ex.Message}");
            ToastService.ShowError($"Error al buscar metadatos: {ex.Message}");
        }
        finally
        {
            _isFetchingMetadata = false;
            StateHasChanged();
        }
    }
    
    private void GoToRead()
    {
        NavManager.NavigateTo($"/read/{Id}");
    }

    private async Task DeleteEpubAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "¿Seguro que deseas borrar el archivo EPUB de este libro?");
        if (!confirmed) return;

        try
        {
            await ApiClient.DeleteEpubAsync(Id);
            ToastService.ShowSuccess("Archivo EPUB eliminado.");
            await LoadBookAsync();
            
            if (_book == null || (!_book.HasEpub && !_book.HasAudio))
            {
                NavManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al borrar: {ex.Message}");
        }
    }

    private async Task DeleteAudioAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "¿Seguro que deseas borrar el Audiolibro de este libro?");
        if (!confirmed) return;

        try
        {
            await ApiClient.DeleteAudioAsync(Id);
            ToastService.ShowSuccess("Audiolibro eliminado.");
            await LoadBookAsync();
            
            if (_book == null || (!_book.HasEpub && !_book.HasAudio))
            {
                NavManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al borrar: {ex.Message}");
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/");
    }
}

@page "/categories"
@using QuimeraReader.Shared.Models
@inject QuimeraReader.Shared.Services.IQuimeraApiClient ApiClient

<PageTitle>Categorías</PageTitle>

<div class="card p-4 mt-4 bg-transparent border-0">
    <h2 class="mb-4"><span class="bi bi-tags-fill text-primary"></span> Explorador de Géneros</h2>

    @if (categories == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted">Cargando categorías...</p>
        </div>
    }
    else if (!categories.Any())
    {
        <div class="alert alert-info">
            No se encontraron categorías en la base de datos.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var cat in categories)
            {
                <div class="col">
                    <a href="/?q=@Uri.EscapeDataString(cat.Name)" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0" style="background: var(--surface-main); cursor: pointer;">
                            <div class="card-body text-center d-flex flex-column justify-content-center">
                                <h5 class="card-title mb-0" style="color: var(--text-main);">@cat.Name</h5>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Category>? categories;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await ApiClient.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando categorías: {ex.Message}");
            categories = Array.Empty<Category>();
        }
    }
}
